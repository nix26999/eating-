;__JJSBoot:run("Auto Block - state-aware animation guard",function()
 local S={alive=true,on=false,focused=true,range=12,hold=.35,maxAge=.28,gap=.08,last=-math.huge,backend=nil,owner=nil,gen=0,poll=0,scan=nil,links={},hooks={},models={},jobs={},ids={},manual={},meta={},metaCount=0,logs={},logKeys={},dirty=true,logClock=0}
 -- Defaults tuned from community JJS notes: M1 startup ~0.16-0.23s, active ~16ms, frontal ~180deg block.
 -- UI toggles for face / ambiguous / move-pause / own-anim-pause removed; fixed behavior below.
 local autoFace,allowHit,pauseMoving,pauseAction=false,true,false,false
 local lookAhead=40;local blockAttributes={};local filter,sort="Matches","Category"
 local rank={M1=1,Punch=2,Verified=3,Attack=4,Hit=5,Swing=6,Unknown=7,Excluded=8}
 local assets=game:GetService("ReplicatedStorage");local box=card(pages.Combat,"Auto Block / Auto Parry","")
 local function listen(signal,fn) local c=connect(signal,fn);table.insert(S.links,c);return c end
 local function label(text,h) return make("TextLabel",box,{Size=UDim2.new(1,0,0,h or 50),BackgroundTransparency=1,Text=text,TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=nextOrder(box)+2}) end
 label("Auto Block: holds F on early player/NPC attack animations (JJS). You must face the attacker for the ~180deg guard. F is a block attempt only — not a confirmed perfect block. No auto-face, no guessed remotes/projectiles/counters.",72)
 local status=label("OFF",44)
 local function say(text) if S.alive and status.Parent then status.Text=text end end
 local function norm(text) return tostring(text or ""):lower():gsub("[^%w]","") end
 -- Reaction / locomotion / pure defensive anims only. M1 finishers (uppercut/downslam) are attacks and must NOT be excluded.
 local excluded={"hitreaction","hitreact","hitstun","gethit","takinghit","receivedhit","hurt","flinch","stagger","stun","ragdoll","knockback","knockdown","block","parry","counter","emote","dance","idle","walking","running","walk","run","jump","fall","land","climb","swim","sit","seated","death","die"}
 local function classify(animation,trackName,useMeta)
  if not animation then return "Unknown",nil end
  local id=animation.AnimationId:match("%d+");local names={animation.Name,trackName or ""};local parent=animation.Parent;local depth=0
  while parent and depth<5 and not parent:IsA("Model") and not parent:IsA("Humanoid") and not parent:IsA("Animator") do table.insert(names,parent.Name);parent=parent.Parent;depth+=1 end
  local normalized={}
  for _,text in ipairs(names) do local n=norm(text);table.insert(normalized,n);for _,bad in ipairs(excluded) do if n:find(bad,1,true) then return "Excluded",id end end end
  if id and S.manual[id] then return "Verified",id end
  -- JJS shared M1 string + common finisher names (neutral / uppercut / downslam)
  for _,n in ipairs(normalized) do
   if n:find("m1",1,true) or n:find("downslam",1,true) or n:find("downsmash",1,true) or n:find("uppercut",1,true) or n:find("uptilt",1,true) or n:find("finisher",1,true) then return "M1",id end
  end
  for _,n in ipairs(normalized) do if n:find("punch",1,true) or n:find("jab",1,true) or n:find("melee",1,true) then return "Punch",id end end
  for _,n in ipairs(normalized) do
   if n:find("slash",1,true) or n:find("strike",1,true) or n:find("kick",1,true) or n:find("attack",1,true) or n:find("combo",1,true) then return "Attack",id end
  end
  for _,n in ipairs(normalized) do if n:find("hit",1,true) then return "Hit",id end end
  for _,n in ipairs(normalized) do if n:find("swing",1,true) then return "Swing",id end end
  if useMeta and id and S.meta[id] then return S.meta[id],id end
  return "Unknown",id
 end
 local function accepted(category)
  return category=="M1" or category=="Punch" or category=="Verified" or category=="Attack" or (allowHit and (category=="Hit" or category=="Swing"))
 end
 local function discover(animation)
  if not animation:IsA("Animation") then return end
  local category,id=classify(animation,nil,false);if not id or category=="Unknown" then return end
  local previous=S.meta[id]
  if previous then
   if category=="Excluded" or previous~="Excluded" and rank[category]<rank[previous] then S.meta[id]=category end
  elseif S.metaCount<2048 then S.meta[id]=category;S.metaCount+=1 end
 end
 local function log(character,track)
  local category,id=classify(track.Animation,track.Name,true);if not id then return category end
  local player=Players:GetPlayerFromCharacter(character);local source=player and ("Player: "..player.Name) or ("NPC: "..character.Name)
  local key=(player and tostring(player.UserId) or character:GetFullName())..":"..id..":"..category
  local entry=S.logKeys[key]
  if not entry then
   if #S.logs>=200 then local removed=table.remove(S.logs,1);S.logKeys[removed.key]=nil end
   entry={key=key,id=id,name=track.Animation.Name,track=track.Name,source=source,category=category,count=0,last=0};S.logKeys[key]=entry;table.insert(S.logs,entry)
  end
  entry.count+=1;entry.last=os.clock();S.dirty=true;return category
 end
 local function rig() local c=LP.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local r=c and c:FindFirstChild("HumanoidRootPart");if h and r and h.Health>0 and not r.Anchored then return c,h,r end end
 local function release()
  local owner=S.owner;S.owner=nil
  if S.backend=="vim" and okVIM and VIM then pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.F,false,game) end)
  elseif S.backend=="key" and type(keyrelease)=="function" then pcall(keyrelease,0x46) end
  S.backend=nil
  if owner then if owner.humanoid.Parent then owner.humanoid.AutoRotate=owner.autoRotate end;busy=false end
  if gui.Parent then gui:SetAttribute("AutoParryHolding",false) end
 end
 local function cancel(message) S.gen+=1;S.jobs={};release();if message then say(message) end end
 local function press()
  if okVIM and VIM then S.backend="vim";local ok=pcall(function() VIM:SendKeyEvent(true,Enum.KeyCode.F,false,game) end);if ok then return true end;release() end
  if type(keypress)=="function" and type(keyrelease)=="function" then S.backend="key";local ok=pcall(keypress,0x46);if ok then return true end;release() end
  return false
 end
 local function stateOK(holding)
  if not S.alive or not S.on or not S.focused or not scriptsActive() or UIS:GetFocusedTextBox() then return false,"Paused / typing / unfocused" end
  if not holding and busy or manualSequenceBusy or todoBusy or tripleJumpBusy then return false,"Another macro owns input" end
  for _,name in ipairs({"FlingSequenceActive","BlackflashChainV2Active","BlackflashChainV3Active","ComboStudioBusy"}) do if gui:GetAttribute(name) then return false,"Conflicting module: "..name end end
  local c,h,r=rig();if not c then return false,"No live unanchored character" end
  local state=h:GetState()
  if h.PlatformStand or state==Enum.HumanoidStateType.Dead or state==Enum.HumanoidStateType.Ragdoll or state==Enum.HumanoidStateType.FallingDown or state==Enum.HumanoidStateType.Physics or state==Enum.HumanoidStateType.Seated then return false,"Humanoid state prevents guard" end
  if pauseMoving and h.MoveDirection.Magnitude>.1 then return false,"Manual movement" end
  for _,name in ipairs(blockAttributes) do
   for _,object in ipairs({c,h,LP}) do local v=object:GetAttribute(name);if v==true or type(v)=="number" and v>0 then return false,"Configured state: "..name end end
  end
  if pauseAction and not holding then
   local animator=h:FindFirstChildOfClass("Animator")
   if animator then for _,t in ipairs(animator:GetPlayingAnimationTracks()) do if t.IsPlaying and t.WeightCurrent>.05 and t.Priority.Value>=Enum.AnimationPriority.Action.Value then return false,"Own Action-priority animation" end end end
  end
  return true,nil,c,h,r
 end
 local function threat(character,requireFront)
  local own,h,root=rig();local enemyH=character and character:FindFirstChildOfClass("Humanoid");local enemy=character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso"))
  if not root or character==own or not character:IsDescendantOf(workspace) or not enemyH or enemyH.Health<=0 or not enemy or not enemy:IsA("BasePart") then return false end
  local player=Players:GetPlayerFromCharacter(character)
  if player and not LP.Neutral and not player.Neutral and LP.Team~=nil and LP.Team==player.Team then return false end
  local actual=enemy.Position-root.Position
  if actual.Magnitude>S.range+2 or math.abs(actual.Y)>6 then return false end
  -- Short optional constant-velocity melee lookahead, not projectile or hit-frame verification.
  local delta=actual+(enemy.AssemblyLinearVelocity-root.AssemblyLinearVelocity)*(lookAhead/1000)
  if delta.Magnitude>S.range then return false end
  local flat=Vector3.new(actual.X,0,actual.Z);if flat.Magnitude<.05 then return false end
