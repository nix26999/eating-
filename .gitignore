 for _,ex in ipairs({12,30}) do shape(ghost,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(ex,20),Size=UDim2.fromOffset(6,9),BackgroundColor3=ink,BorderSizePixel=0,ZIndex=2}) end

 -- LAYER 2: witch-hat avatar of the player (live headshot + drawn hat on top)
 local holder=shape(main,{Size=UDim2.fromOffset(62,62),Position=UDim2.new(0,12,1,-74),BackgroundColor3=T.panel,BorderSizePixel=0,ZIndex=6}); rounded(holder,62)
 make("UIStroke",holder,{Color=T.acc,Thickness=2})
 local face=make("ImageLabel",holder,{Size=UDim2.fromOffset(52,52),Position=UDim2.fromOffset(5,5),BackgroundColor3=Color3.fromRGB(255,140,40),BorderSizePixel=0,ScaleType=Enum.ScaleType.Crop,ZIndex=7}); rounded(face,52)
 local okThumb,thumb=pcall(function() return (Players:GetUserThumbnailAsync(LP.UserId,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size100x100)) end)
 if okThumb and thumb then face.Image=thumb end
 local brim=shape(holder,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(31,14),Size=UDim2.fromOffset(58,10),BackgroundColor3=Color3.fromRGB(40,20,56),BorderSizePixel=0,ZIndex=9}); rounded(brim,6)
 local crown=shape(holder,{AnchorPoint=Vector2.new(.5,1),Position=UDim2.fromOffset(31,15),Size=UDim2.fromOffset(32,30),BackgroundColor3=Color3.fromRGB(40,20,56),BorderSizePixel=0,ZIndex=8}); rounded(crown,8)
 shape(holder,{AnchorPoint=Vector2.new(.5,1),Position=UDim2.fromOffset(31,13),Size=UDim2.fromOffset(32,5),BackgroundColor3=orange,BorderSizePixel=0,ZIndex=10})

 -- ambient motion for ghost and embers
