    local authorizedModel=targetModel
    releasePositioning();mixupUsed=true;recoveringOver=false;recoveryJumpActive=false;jumpPrimed=false;needPostJumpBackoff=false
    previousLockOn=lockOn;borrowedLock=true;lockOn=false;lockSuppressed=true;flickUntil=0;flickRotation=nil
    mixFacing=away;phase="turnAway";steering=Vector3.zero
    r.CFrame=CFrame.lookAt(r.Position,r.Position+away)
    local cam=workspace.CurrentCamera;if cam then cam.CFrame=CFrame.lookAt(cam.CFrame.Position,cam.CFrame.Position+away) end
    say("V2: front-only variant - lock OFF, turn around")
    waitFor(.05,false)
    local _,current=updateTarget()
    if targetModel~=authorizedModel or not frontSide(current) then releasePositioning();restoreLockOn();return false end
    move("backMixup",-away)
    say("V2: facing away - holding S before Q")
    waitFor(.035,false)
    local _,beforeDash=updateTarget()
    if targetModel~=authorizedModel or not frontSide(beforeDash) then releasePositioning();restoreLockOn();return false end
    key(Enum.KeyCode.Q,true)
    waitFor(.035,false);key(Enum.KeyCode.Q,false);waitFor(.215,false)
    releasePositioning();restoreLockOn();flickUntil=0
    if targetModel==authorizedModel then
     frontSequenceArmed=true;frontSequenceModel=authorizedModel
     say("V2: S + Q sent from front - lock ON, Black Flash next")
     return true
    end
    return false
   end
   local function step()
    check();local p,tr=updateTarget();if not tr then releasePositioning();say("V2: waiting for a live target");RS.Heartbeat:Wait();return end
    local distance,offset,h,r=spacing(tr);local away=offset.Magnitude>.01 and offset.Unit or Vector3.new(0,0,1)
    if recoveringOver and recoveryJumpActive and rearSide(tr) and distance<=ATTACK_MAX then markJumpBehind() end
    if needPostJumpBackoff then
     if distance<POST_JUMP_MIN then move("postJumpBackoff",away);say("V2: post-jump backoff to >=5 studs");RS.Heartbeat:Wait();return else needPostJumpBackoff=false;releasePositioning() end
    end
    if distance>CATCHUP_DISTANCE then
     if recoveringOver then recoverByJump(tr,h) else move("catchup",-away);say("V2: gap >7 - W toward target");if objectInRoute(r,tr,-away,3) then recoverByJump(tr,h) else RS.Heartbeat:Wait() end end
    elseif turnaroundMixups and not mixupUsed and not frontSequenceArmed and frontSide(tr) and distance>=ATTACK_MIN and distance<=ATTACK_MAX and h.FloorMaterial~=Enum.Material.Air and math.random(1,3)==1 then
     turnaroundBackdash(tr,away)
    elseif rearSide(tr) or authorizedFrontVariant(tr) then
     recoveringOver=false
     if distance>ATTACK_MAX then move("attackApproach",-away);say("V2: approach to 2-6 attack range");RS.Heartbeat:Wait()
     elseif distance<ATTACK_MIN then releasePositioning();say("V2: too close - stopped");RS.Heartbeat:Wait()
     else
      releasePositioning()
      if h.FloorMaterial==Enum.Material.Air and not jumpPrimed then say("V2: waiting to land");RS.Heartbeat:Wait()
      elseif not attackReady(tr,false) then RS.Heartbeat:Wait()
      else
       mixupUsed=true;say("V2: jump + Black Flash "..(completed+1).."/3"..(runVersion==3 and(" | cycle "..(cyclesFinished+1)) or ""))
       if jumpBeforeBlackflash() then local _,current=updateTarget()
        if attackReady(current,true) then
         local healthBefore=fightHumanoid and fightHumanoid.Health or nil
         local began=os.clock();tapThree();local remaining=math.max(0,delayMs/1000-(os.clock()-began))
         if waitFor(remaining,true) then local _,latest=updateTarget()
          if attackReady(latest,true) then
           tapThree()

           local damaged=false
           if healthBefore and fightHumanoid then
            local deadline=os.clock()+.55
            while os.clock()<deadline do
             check()
             if fightHumanoid.Health<healthBefore-.5 then damaged=true; break end
             if fightHumanoid.Health<=0 then damaged=true; break end
             RS.Heartbeat:Wait()
            end
           else
            damaged=true
           end
           if not damaged then
            stop("Black Flash miss (no damage). Press 3 to restart.")
            bindCapture()
            return
           end
           completed+=1
           if completed>=3 then
            if runVersion==3 then
             releasePositioning();say("V3: 3 sequences sent - wait 300 ms, then LMB")
             waitFor(V3_FIXED.CycleWait/1000,false)
             clickLMB()
             cyclesFinished+=1;completed=0;resetRoute()
             say("V3: cycle "..cyclesFinished.." complete - repeating against the same target")
             return
            else clickLMB();stop("V2 finished: 3 Black Flash sequences + LMB; fourth not started. Press 3 again.");bindCapture();return end
           end
           resetRoute();waitFor(setting("RepeatGap")/1000,false)
          end
         end
        end
       end
      end
     end
    elseif recoveringOver then recoverByJump(tr,h)
    elseif os.clock()<nextDash or distance<SIDE_MIN then recoverByJump(tr,h)
    else
     local right=navigationRight(away);local direction=useAvailableSide(r,tr,right)
     if not direction then recoverByJump(tr,h)
     else
      move("side",direction);say("V2: preferred "..(strafeKey==Enum.KeyCode.A and "A" or "D").." side dash")
      local success=sideDash(r,tr,direction)
      if success==false then local _,current=updateTarget();local currentHumanoid=rig();if current and currentHumanoid then recoverByJump(current,currentHumanoid) end end
     end
    end
   end
   local ok,err=pcall(function()
    while active and generation==id do
     valid()
     if typing() then pauseForTyping();jumpPrimed=false;repeat valid();RS.Heartbeat:Wait() until not typing();bindCapture()
     else local stepOK,stepError=pcall(step);if not stepOK then if stepError==PAUSED_FOR_TYPING then pauseForTyping();jumpPrimed=false else error(stepError,0) end end end
    end
   end)
   if generation==id then stop(ok and "Chain stopped" or tostring(err));bindCapture() end
  end)
 end
 blackflashV2Trigger=function() if not(enabledV2 or enabledV3) or not scriptsActive() then return false end;if not active and not typing() and os.clock()>=suppressStartUntil then start() end;return true end
 toggle(box,"Blackflash Chain V2",function() return enabledV2 end,function(v) enabledV2=v;if not v and active and runVersion==2 then stop("V2 off") end;feedback.Text=v and "V2 ready - press 3 (V3 has priority if also enabled)" or "V2 off";bindCapture() end)
 toggle(boxV3,"Blackflash Chain V3",function() return enabledV3 end,function(v) enabledV3=v;if not v and active and runVersion==3 then stop("V3 off") end;feedbackV3.Text=v and "V3 ready - press 3; loops until current target dies" or "V3 off";bindCapture() end)
 toggle(box,"Include NPCs (shared V2/V3)",function() return includeNPCsV2 end,function(v)
  includeNPCsV2=v;targetRoot=nil;invalidateCaches()
  if not v and active and runVersion==3 and fightModel and not Players:GetPlayerFromCharacter(fightModel) then stop("V3 stopped: NPC targeting disabled. Press 3 again.");bindCapture() end
 end)
 toggle(box,"Front-only turnaround S + Q (shared)",function() return turnaroundMixups end,function(v) turnaroundMixups=v end)
 moduleSlider(box,"V2 jump lead",35,350,jumpLeadMs," ms",function() return jumpLeadMs end,function(v) jumpLeadMs=v end)
 toggle(calcBox,"Route Calculator / Auto Side",function() return calculatorEnabled end,function(v) calculatorEnabled=v;routeCache=nil end)
 toggle(calcBox,"Auto camera angle (override slider/fixed turn)",function() return autoCameraAngle end,function(v) autoCameraAngle=v end)
 local lastCalc=-math.huge
 connect(RS.Heartbeat,function()
  if not running or not gui.Parent then return end;if active and not ensureFightAlive() then return end
  if os.clock()-lastCalc<.25 then return end;lastCalc=os.clock();local text
  if not calculatorEnabled then text="Calculator off - direct D/A selection"
  else
   local p,tr=closest();local d,offset=spacing(tr)
   if not p or not tr then text="No live target available" elseif not d or d<.5 then text="Too close to calculate orbit"
   else local plan=calculateRoute(tr,navigationRight(offset.Unit))
    if not plan then text="Unable to estimate route"
    else
     local function line(route) return string.format("%.1f deg / %.1f studs / %s",route.Degrees,route.Distance,route.Blocked and "blocked" or string.format("~%.2f s",route.Time)) end
     local recommendation=plan.Side==Enum.KeyCode.A and "LEFT (A)" or plan.Side==Enum.KeyCode.D and "RIGHT (D)" or "JUMP OVER (both blocked)"
     text=table.concat({"Target: "..p.DisplayName,"Left: "..line(plan.Left),"Right: "..line(plan.Right),"Estimated faster clear route: "..recommendation,string.format("Predicted post-dash yaw: %.1f deg %s",math.abs(plan.PredictedYaw),plan.PredictedYaw>=0 and "left" or "right")},string.char(10))
    end
   end
  end
  if calcStatus.Text~=text then calcStatus.Text=text end
 end)
 RS:BindToRenderStep(cameraBind,Enum.RenderPriority.Camera.Value+2,function()
  if not active or typing() or not ensureFightAlive() then return end;local p,tr=closest();watchFight(p);if not active then return end;targetRoot=tr;enforceMovementPriority();local cam=workspace.CurrentCamera
  if cam then
   if lockSuppressed and mixFacing.Magnitude>.01 then cam.CFrame=CFrame.lookAt(cam.CFrame.Position,cam.CFrame.Position+mixFacing)
   elseif os.clock()<flickUntil and flickRotation then cam.CFrame=CFrame.new(cam.CFrame.Position)*flickRotation
   elseif tr and(tr.Position-cam.CFrame.Position).Magnitude>.05 then cam.CFrame=CFrame.lookAt(cam.CFrame.Position,tr.Position+Vector3.new(0,1,0)) end
  end
 end)
 RS:BindToRenderStep(faceBind,Enum.RenderPriority.Character.Value+7,function(dt)
  if not active or typing() or not ensureFightAlive() or not targetRoot or not targetRoot.Parent then return end;enforceMovementPriority();local distance,offset,h,r=spacing(targetRoot);if not distance then return end
  if ownedHumanoid~=h then restoreFacing();ownedHumanoid=h;previousAutoRotate=h.AutoRotate end;h.AutoRotate=false
  local vector=steering;local remaining=nil
  if phase=="postJumpBackoff" then remaining=math.max(0,POST_JUMP_AIM-distance)
  elseif phase=="catchup" then remaining=math.max(0,distance-CATCHUP_DISTANCE)
  elseif phase=="attackApproach" then remaining=math.max(0,distance-ATTACK_CENTER)
  elseif phase=="jumpOver" then local look=flat(targetRoot.CFrame.LookVector);if look.Magnitude>.01 then local delta=flat(targetRoot.Position-look.Unit*ATTACK_CENTER-r.Position);remaining=delta.Magnitude;vector=delta.Magnitude>.05 and delta.Unit or Vector3.zero end end
  if remaining then local alpha=math.clamp(remaining/math.max(h.WalkSpeed*math.max(dt,1/240),.01),0,1);vector=vector*alpha;if remaining<=.05 and phase~="jumpOver" then releasePositioning();vector=Vector3.zero end end
  h:Move(vector,false);local aim=lockSuppressed and(r.Position+mixFacing) or Vector3.new(targetRoot.Position.X,r.Position.Y,targetRoot.Position.Z);if(aim-r.Position).Magnitude>.05 then r.CFrame=CFrame.lookAt(r.Position,aim) end
 end)
 connect(LP.CharacterRemoving,function() stop("Your character removed. Press 3 again.");bindCapture() end)
 connect(UIS.WindowFocusReleased,function() if active then stop("Window lost focus. Press 3 again.");bindCapture() end end)
 local function shutdown() enabledV2=false;enabledV3=false;CAS:UnbindAction(action);stop("Off");blackflashV2Trigger=nil;RS:UnbindFromRenderStep(cameraBind);RS:UnbindFromRenderStep(faceBind) end
 connect(unload.Activated,shutdown);connect(gui.Destroying,shutdown)

end)

;__JJSBoot:run("Player ESP",function()

 local on,names,health,distance,highlights,teamCheck,throughWalls=false,true,true,true,true,false,false
 local maxDistance=1000
 local closed=false
 local entries={}
 local panel=card(pages.ESP,"Player ESP","")
 local folder=Instance.new("Folder")
 folder.Name="JJS_HUB_ESP_"..tostring(LP.UserId)
 folder.Parent=workspace
 local function drop(player)
  local e=entries[player]
  if not e then return end
  e.highlight:Destroy();e.billboard:Destroy();entries[player]=nil
 end
 local function clear()
  local list={}
  for player in pairs(entries) do table.insert(list,player) end
  for _,player in ipairs(list) do drop(player) end
 end
 local function stop()
  if closed then return end
  closed=true;on=false;clear();folder:Destroy()
 end
 local function entryFor(player,character,root)
  local e=entries[player]
  if e and e.character~=character then drop(player);e=nil end
  if not e then
   local h=Instance.new("Highlight");h.Name="PlayerHighlight";h.Adornee=character;h.FillTransparency=.78;h.OutlineTransparency=0;h.Parent=folder
   local b=Instance.new("BillboardGui");b.Name="PlayerLabel";b.Size=UDim2.fromOffset(230,52);b.StudsOffsetWorldSpace=Vector3.new(0,3.5,0);b.LightInfluence=0;b.Parent=gui
   local l=Instance.new("TextLabel");l.Size=UDim2.fromScale(1,1);l.BackgroundTransparency=1;l.TextColor3=T.txt;l.TextStrokeColor3=Color3.new(0,0,0);l.TextStrokeTransparency=.25;l.Font=Enum.Font.GothamBold;l.TextSize=12;l.TextWrapped=true;l.Parent=b
   e={character=character,highlight=h,billboard=b,label=l};entries[player]=e
  end
  e.billboard.Adornee=character:FindFirstChild("Head") or root
  return e
 end
 toggle(panel,"Enable ESP",function() return on end,function(v) on=v;if not v then clear() end end)
 toggle(panel,"Highlights",function() return highlights end,function(v) highlights=v end)
 toggle(panel,"Names",function() return names end,function(v) names=v end)
 toggle(panel,"Health",function() return health end,function(v) health=v end)
 toggle(panel,"Distance",function() return distance end,function(v) distance=v end)
 toggle(panel,"Hide teammates",function() return teamCheck end,function(v) teamCheck=v end)
 toggle(panel,"Through walls",function() return throughWalls end,function(v) throughWalls=v end)
 moduleSlider(panel,"Maximum distance",50,5000,maxDistance," studs",function() return maxDistance end,function(v) maxDistance=v end)
 connect(Players.PlayerRemoving,drop)
 connect(LP.CharacterRemoving,clear)
 connect(unload.Activated,stop)
 connect(gui.Destroying,stop)
 local elapsed=0
 connect(RS.Heartbeat,function(dt)
  elapsed+=dt;if elapsed<.15 then return end;elapsed=0
  if closed then return end
  if not running or not gui.Parent then stop();return end
  if not on then return end
  local own=LP.Character;local ownRoot=own and own:FindFirstChild("HumanoidRootPart")
  if not ownRoot then clear();return end
  local seen={}
  for _,p in ipairs(Players:GetPlayers()) do
   if p~=LP then
    local c=p.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local r=c and c:FindFirstChild("HumanoidRootPart")
    local teammate=not LP.Neutral and not p.Neutral and LP.Team~=nil and p.Team==LP.Team
    local d=r and(r.Position-ownRoot.Position).Magnitude or math.huge
    if h and r and h.Health>0 and d<=maxDistance and not(teamCheck and teammate) then
     seen[p]=true;local e=entryFor(p,c,r);local color=teammate and T.ok or T.acc
     e.highlight.Enabled=highlights;e.highlight.FillColor=color;e.highlight.OutlineColor=color
     e.highlight.DepthMode=throughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
     e.billboard.AlwaysOnTop=throughWalls;e.billboard.MaxDistance=maxDistance
     local text,detail={},{}
     if names then table.insert(text,p.DisplayName.." (@"..p.Name..")") end
     if health then table.insert(detail,string.format("%d/%d HP",math.floor(h.Health+.5),math.floor(h.MaxHealth+.5))) end
     if distance then table.insert(detail,string.format("%d studs",math.floor(d+.5))) end
     if #detail>0 then table.insert(text,table.concat(detail," | ")) end
     e.billboard.Enabled=#text>0;e.label.Text=table.concat(text,"\n");e.label.TextColor3=color
    end
   end
  end
  local stale={};for p in pairs(entries) do if not seen[p] then table.insert(stale,p) end end
  for _,p in ipairs(stale) do drop(p) end
 end)

end)


;__JJSBoot:run("Fling Kill All",function()

 local active=false
 local closed=false
 local generation=0
 local snapshot=nil
 local mouseDown=false
 local skipTeam=true
 local range=300
 local hitDelayMs=300
 local contactMs=450
 local ownedBusy=false
 local panel=card(pages.Combat,"Fling Kill All","")
 local feedback=make("TextLabel",panel,{Size=UDim2.new(1,0,0,44),BackgroundTransparency=1,Text="Ready - experimental; hits and kills unverified",TextColor3=T.dim,TextWrapped=true,TextSize=11,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=3})
 ord[panel]=3
 toggle(panel,"Skip teammates",function() return skipTeam end,function(v) if not active then skipTeam=v end end)
 moduleSlider(panel,"Maximum range",25,1000,range," studs",function() return range end,function(v) if not active then range=v end end)
 moduleSlider(panel,"After M1 delay",100,1000,hitDelayMs," ms",function() return hitDelayMs end,function(v) if not active then hitDelayMs=v end end)
 moduleSlider(panel,"Fling duration",100,700,contactMs," ms",function() return contactMs end,function(v) if not active then contactMs=v end end)
 local function makeButton(text,color)
  local b=make("TextButton",panel,{Size=UDim2.new(1,0,0,30),BackgroundColor3=color or T.p2,Text=text,TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=12,LayoutOrder=nextOrder(panel)+2})
  corner(b,6)
  return b
 end
 local testButton=makeButton("Test nearest: teleport > M1 > fling")
 local allButton=makeButton("Fling Kill All - one pass")
 local stopButton=makeButton("Stop (End)",T.warn)
 local function report(text)
  if feedback.Parent and not closed then feedback.Text=text end
 end
 local function living(player)
  local c=player.Character
  local h=c and c:FindFirstChildOfClass("Humanoid")
  local r=c and c:FindFirstChild("HumanoidRootPart")
  if h and r and h.Health>0 then return c,h,r end
 end
 local function teammate(p)
  return not LP.Neutral and not p.Neutral and LP.Team~=nil and LP.Team==p.Team
 end
 local function releaseMouse()
  if mouseDown and okVIM and VIM then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end
  mouseDown=false
 end
 local function restoreCharacter()
  releaseMouse()
  local state=snapshot
  snapshot=nil
  if not state then return end
  for part,value in pairs(state.collisions) do if part.Parent then pcall(function() part.CanCollide=value end) end end
  if state.humanoid.Parent then pcall(function() state.humanoid.AutoRotate=state.autoRotate end) end
  if state.root.Parent and LP.Character==state.character then
   pcall(function()
    state.root.AssemblyLinearVelocity=Vector3.zero
    state.root.AssemblyAngularVelocity=Vector3.zero
    state.root.CFrame=state.origin
   end)
  end
 end
 local function releaseOwnership()
  if ownedBusy then
   ownedBusy=false
   busy=false
   manualSequenceBusy=false
   if gui.Parent then gui:SetAttribute("FlingSequenceActive",false) end
  end
 end
 local function stop(message)
  generation+=1
  restoreCharacter()
  active=false
  releaseOwnership()
  report(message or "Stopped")
 end
 local function alive(id,player,state,target,targetHumanoid,targetRoot)
  return running and gui.Parent~=nil and not closed and active and generation==id and LP.Character==state.character and state.root.Parent~=nil and state.humanoid.Health>0 and player.Parent==Players and player.Character==target and targetRoot.Parent~=nil and targetHumanoid.Health>0
 end
 local function waitFor(seconds,id,player,state,target,targetHumanoid,targetRoot)
  local finish=os.clock()+seconds
  repeat
   if not alive(id,player,state,target,targetHumanoid,targetRoot) then return false end
   RS.Heartbeat:Wait()
  until os.clock()>=finish
  return alive(id,player,state,target,targetHumanoid,targetRoot)
 end
 local function attempt(player,id)
  local character,humanoid,root=living(LP)
  local target,targetHumanoid,targetRoot=living(player)
  if not root or not targetRoot or player==LP or(skipTeam and teammate(player)) then return false,false,0,"Skipped" end
  if(targetRoot.Position-root.Position).Magnitude>range then return false,false,0,"Out of range" end
  local state={character=character,humanoid=humanoid,root=root,origin=root.CFrame,autoRotate=humanoid.AutoRotate,collisions={}}
  snapshot=state
  local sent,completed,displacement=false,false,0
  local reason="Cancelled"
  local ok,err=pcall(function()
   humanoid.AutoRotate=false
   report("Teleport behind: "..player.DisplayName)
   local position=targetRoot.Position-targetRoot.CFrame.LookVector*2.6
   root.CFrame=CFrame.lookAt(position,Vector3.new(targetRoot.Position.X,position.Y,targetRoot.Position.Z))
   root.AssemblyLinearVelocity=Vector3.zero
   root.AssemblyAngularVelocity=Vector3.zero
   if not waitFor(.08,id,player,state,target,targetHumanoid,targetRoot) then return end
   if(root.Position-targetRoot.Position).Magnitude>7 then reason="Target moved before M1";return end
   if UIS:GetFocusedTextBox() then reason="Typing - cancelled";return end
   report("M1 input: "..player.DisplayName)
   mouseDown=true
   local inputOK,inputError=pcall(function() VIM:SendMouseButtonEvent(0,0,0,true,game,0) end)
   if not inputOK then releaseMouse();reason="M1 input unavailable";return end
   local valid=waitFor(.035,id,player,state,target,targetHumanoid,targetRoot)
   releaseMouse()
   if not valid then return end
   sent=true
   if not waitFor(hitDelayMs/1000,id,player,state,target,targetHumanoid,targetRoot) then reason="Target unavailable after M1";return end
   if(root.Position-targetRoot.Position).Magnitude>18 then reason="Target moved before fling";return end
   for _,part in ipairs(character:GetDescendants()) do if part:IsA("BasePart") then state.collisions[part]=part.CanCollide;part.CanCollide=true end end
   local targetOrigin=targetRoot.Position
   local began=os.clock()
   report("Fling attempt: "..player.DisplayName)
   while os.clock()-began<contactMs/1000 do
    if not alive(id,player,state,target,targetHumanoid,targetRoot) then break end
    if UIS:GetFocusedTextBox() then reason="Typing - cancelled";break end
    local delta=targetRoot.Position-root.Position
    if delta.Magnitude>18 then break end
    local direction=Vector3.new(delta.X,0,delta.Z)
    if direction.Magnitude<.05 then direction=Vector3.new(targetRoot.CFrame.LookVector.X,0,targetRoot.CFrame.LookVector.Z) end
    if direction.Magnitude<.05 then direction=Vector3.new(0,0,-1) end
    root.AssemblyAngularVelocity=Vector3.new(0,55,0)
    root.AssemblyLinearVelocity=direction.Unit*120+Vector3.new(0,8,0)
    RS.Heartbeat:Wait()
   end
   displacement=targetRoot.Parent and(targetRoot.Position-targetOrigin).Magnitude or 0
   completed=true
   reason="Attempt completed"
  end)
  if snapshot==state then restoreCharacter() end
  if not ok then return false,sent,0,tostring(err) end
  return completed,sent,displacement,reason
 end
 local function start(nearestOnly)
  if active or closed or not running or not gui.Parent then return end
  if busy or todoBusy or manualSequenceBusy or tripleJumpBusy then report("Wait for the other macro to finish");return end
  if UIS:GetFocusedTextBox() then report("Finish typing first");return end
  if not okVIM or not VIM then report("Input simulation unavailable");return end
  local _,_,root=living(LP)
  if not root then report("Character unavailable");return end
  local queue={}
  for _,p in ipairs(Players:GetPlayers()) do
   local _,_,other=living(p)
   if p~=LP and other and(not skipTeam or not teammate(p)) then
    local d=(other.Position-root.Position).Magnitude
    if d<=range then table.insert(queue,{player=p,distance=d}) end
   end
  end
  table.sort(queue,function(a,b) return a.distance<b.distance end)
  if #queue==0 then report("No eligible targets in range");return end
  if nearestOnly then queue={queue[1]} end
  active=true;ownedBusy=true;busy=true;manualSequenceBusy=true
  gui:SetAttribute("FlingSequenceActive",true)
  generation+=1
  local id=generation
  task.spawn(function()
   local completed,inputs,moved=0,0,0
   local ok,err=xpcall(function()
    RS.Heartbeat:Wait();RS.Heartbeat:Wait()
    for _,item in ipairs(queue) do
     if not running or closed or generation~=id or not active then break end
     if not living(LP) then stop("Character unavailable - stopped");return end
     if UIS:GetFocusedTextBox() then stop("Typing - stopped");return end
     local done,sent,distance,reason=attempt(item.player,id)
     if sent then inputs+=1 end
     if done then completed+=1;if distance>=8 then moved+=1 end end
     if generation~=id then break end
     if not done then report(reason) end
     local deadline=os.clock()+.2
     while os.clock()<deadline and generation==id and active and running and not closed do RS.Heartbeat:Wait() end
    end
   end,function(e) return tostring(e) end)
   if generation==id then
    restoreCharacter();active=false;releaseOwnership()
    report(ok and string.format("%d M1 inputs | %d fling attempts | %d moved >=8 studs\nHits, kills and credit unverified",inputs,completed,moved) or "Stopped: "..tostring(err))
   end
  end)
 end
 connect(testButton.Activated,function() start(true) end)
 connect(allButton.Activated,function() start(false) end)
 connect(stopButton.Activated,function() if active then stop("Stopped") end end)
 connect(UIS.InputBegan,function(input)
  if input.KeyCode==Enum.KeyCode.End and active then stop("Stopped") end
 end)
 connect(LP.CharacterRemoving,function() if active then stop("Character removed - stopped") end end)
 connect(UIS.WindowFocusReleased,function() if active then stop("Focus lost - stopped") end end)
 local function shutdown()
  if closed then return end
  stop("Stopped")
  closed=true
 end
 connect(unload.Activated,shutdown)
 connect(gui.Destroying,shutdown)

end)


