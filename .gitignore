  params.FilterDescendantsInstances=exclude;params.RespectCanCollide=true;sharedParams=params;paramsModel=model;paramsCharacter=character;return params
 end
 local function objectInRoute(r,tr,direction,length)
  if direction.Magnitude<.01 then return false end;local vector=direction.Unit*length;local params=paramsFor(tr);local side=Vector3.new(-direction.Z,0,direction.X).Unit
  for _,shift in ipairs({Vector3.zero,Vector3.new(0,-1.5,0),Vector3.new(0,1,0),side,-side}) do if workspace:Raycast(r.Position+shift,vector,params) then return true end end;return false
 end
 local function navigationRight(away)
  local cam=workspace.CurrentCamera;local right=cam and flat(cam.CFrame.RightVector) or Vector3.new(-away.Z,0,away.X)
  if os.clock()<flickUntil and flickNavigationRight.Magnitude>.01 then right=flickNavigationRight end;if right.Magnitude<.01 then right=Vector3.new(-away.Z,0,away.X) end;return right.Unit
 end
 local function signedYaw(from,to) from=flat(from);to=flat(to);if from.Magnitude<.01 or to.Magnitude<.01 then return 0 end;from=from.Unit;to=to.Unit;return math.deg(math.atan2(from:Cross(to).Y,math.clamp(from:Dot(to),-1,1))) end
 local function calculateRoute(tr,right,force)
  local radius,offset,h,r=spacing(tr);if not radius or radius<.5 then return nil end
  local look=flat(tr.CFrame.LookVector);if look.Magnitude<.01 then return nil end;look=look.Unit;local now=os.clock();local speed=math.max(h.WalkSpeed,1)
