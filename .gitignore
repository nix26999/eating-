  local halo=F({AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(s*2.4,s*2.4),Position=UDim2.new(x,0,y,0),BackgroundColor3=orange,BackgroundTransparency=.88,BorderSizePixel=0,ZIndex=z}); round(halo)
