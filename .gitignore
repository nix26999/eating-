 local function interrupted() if gui:GetAttribute("FlingSequenceActive") then return true end;if (busy and not bfAssistActive) or todoBusy or UIS:GetFocusedTextBox() then return true end;for k in pairs(keys) do if movement[k] then return true end end;return not sprintDown and not held[Enum.KeyCode.W] and UIS:IsKeyDown(Enum.KeyCode.W) end
