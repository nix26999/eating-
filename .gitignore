local __baseCard=card
card=function(p,name,sub)
 local c=__baseCard(p,name,sub)
 make("UIStroke",c,{Color=Color3.fromRGB(8,4,12),Thickness=4,Transparency=.55,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
 make("UIGradient",c,{Color=ColorSequence.new(Color3.fromRGB(44,32,26),Color3.fromRGB(24,18,16)),Rotation=90})
 return c
end

