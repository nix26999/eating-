;__JJSBoot:run("Item and Dummy ESP",function()
 -- JJS25: Item and Dummy ESP
 local itemOn,dummyOn=false,false;local alive=true;local elapsed=0;local entries={}
 local folder=make("Folder",gui,{Name="JJS25WorldESP"})
 local box=card(pages.ESP,"Items and Non-player Dummies","")
 local feedback=make("TextLabel",box,{Size=UDim2.new(1,0,0,45),Text="Items: workspace.Items. Dummies: non-player humanoids in workspace.Characters. Local markers only.",TextWrapped=true,BackgroundTransparency=1,TextColor3=T.mut,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3});ord[box]=3
 local function clear() for o,e in pairs(entries) do e.tag:Destroy();e.highlight:Destroy();entries[o]=nil end end
 toggle(box,"Item ESP",function() return itemOn end,function(v) itemOn=v;clear() end)
 toggle(box,"Dummy ESP",function() return dummyOn end,function(v) dummyOn=v;clear() end)
 local function add(o,part,caption)
  if entries[o] then entries[o].label.Text=caption;return end
  local h=make("Highlight",folder,{Adornee=o,FillColor=T.acc,FillTransparency=.8,OutlineColor=T.txt,DepthMode=Enum.HighlightDepthMode.Occluded})
  local tag=make("BillboardGui",folder,{Adornee=part,Size=UDim2.fromOffset(180,26),StudsOffset=Vector3.new(0,2.5,0),AlwaysOnTop=false})
  local label=make("TextLabel",tag,{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=caption,TextColor3=T.txt,TextStrokeTransparency=.3,TextSize=12,Font=Enum.Font.Gotham})
  entries[o]={tag=tag,highlight=h,label=label}
 end
 connect(RS.Heartbeat,function(dt)
  if not alive or not itemOn and not dummyOn then return end
  elapsed+=dt;if elapsed<.5 then return end;elapsed=0
  local seen={};local count=0
  local items=workspace:FindFirstChild("Items")
  if itemOn and items then for _,o in ipairs(items:GetChildren()) do
   local p=o:IsA("BasePart") and o or o:FindFirstChildWhichIsA("BasePart",true)
   if p and (o:IsA("BasePart") or o:IsA("Model")) then add(o,p,o.Name);seen[o]=true;count+=1 end
  end end
  local chars=workspace:FindFirstChild("Characters")
  if dummyOn and chars then for _,m in ipairs(chars:GetChildren()) do
   if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then
    local h=m:FindFirstChildOfClass("Humanoid");local p=m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
    if h and p and h.Health>0 then add(m,p,string.format("%s | %.0f/%.0f HP",m.Name,h.Health,h.MaxHealth));seen[m]=true;count+=1 end
   end
  end end
  for o,e in pairs(entries) do if not seen[o] then e.tag:Destroy();e.highlight:Destroy();entries[o]=nil end end
  feedback.Text="Tracked: "..count.." | Items: "..(items and "found" or "unavailable").." | Characters: "..(chars and "found" or "unavailable")
 end)
 local function stop() if not alive then return end;alive=false;clear();folder:Destroy() end
 connect(unload.Activated,stop);connect(gui.Destroying,stop)

end)

