  if down then if typing() then error(PAUSED_FOR_TYPING,0) end;if held[code] then return end;held[code]=true;if code==Enum.KeyCode.Three then suppressStartUntil=os.clock()+.1 end;sendKey(code,true)
  elseif held[code] then sendKey(code,false);held[code]=nil end
 end
 local function releaseInputs() for code in pairs(held) do pcall(function() sendKey(code,false) end) end;held={};if mouseDown then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end;mouseDown=false end
