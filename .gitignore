  local name,id=spec[1],spec[2]
  local paint=toggle(box,name,function() return current==id end,function(v)
   stop();if not v then return end
   local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid");local animator=h and h:FindFirstChildOfClass("Animator")
   if not hubUnlocked or not h or h.Health<=0 or not animator then feedback.Text="Unlock hub and wait for a live character/Animator.";return end
   local ok,err=pcall(function() object=Instance.new("Animation");object.AnimationId="rbxassetid://"..id;track=animator:LoadAnimation(object);track.Looped=true;track:Play(.1);current=id end)
   if ok then feedback.Text="Playing "..name.." (cosmetic)." else stop();feedback.Text="Playback unavailable: "..tostring(err) end
  end)
  table.insert(paints,paint)
 end
 connect(LP.CharacterRemoving,stop);connect(UIS.WindowFocusReleased,stop)
