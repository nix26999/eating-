  local mouth=F({AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(s*.5,s*.13),Position=UDim2.new(x,0,y,s*.16),BackgroundColor3=ink,BorderSizePixel=0,ZIndex=z+2}); round(mouth,6)
 end
 for _,p in ipairs({{.08,.93,70},{.22,.97,46},{.36,.94,56},{.6,.97,44},{.74,.93,64},{.9,.97,50},{.5,.99,36},{.16,.99,30}}) do pumpkin(p[1],p[2],p[3],12) end
