-- ===== PART 3: layered Halloween scenery (drawn with frames, no uploads needed) =====
;__JJSBoot:run("UI component 26",function()

 local function shape(parent,props) return make("Frame",parent,props) end
 local function rounded(o,r) make("UICorner",o,{CornerRadius=UDim.new(0,r or 999)}) end
 local ink=Color3.fromRGB(12,6,18)
 local orange=Color3.fromRGB(255,120,30)

 -- LAYER 0: moon, fog and spider web (behind everything)
 local moon=shape(main,{Size=UDim2.fromOffset(70,70),Position=UDim2.new(1,-100,0,56),BackgroundColor3=Color3.fromRGB(255,236,190),BorderSizePixel=0,ZIndex=0})
 rounded(moon); make("UIGradient",moon,{Color=ColorSequence.new(Color3.fromRGB(255,240,200),Color3.fromRGB(255,160,80)),Rotation=45})
 make("UIStroke",moon,{Color=Color3.fromRGB(255,170,80),Thickness=3,Transparency=.5})

 local fog=shape(main,{Size=UDim2.new(1,0,0,130),Position=UDim2.new(0,0,1,-130),BackgroundColor3=Color3.fromRGB(80,30,100),BorderSizePixel=0,ZIndex=0})
 make("UIGradient",fog,{Color=ColorSequence.new(Color3.fromRGB(90,35,120),Color3.fromRGB(10,4,16)),Rotation=90,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.35),NumberSequenceKeypoint.new(1,1)})})

 for _,a in ipairs({8,24,42,60}) do
  local rad=math.rad(a);local dx,dy=-math.cos(rad),math.sin(rad)
  local web=shape(main,{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(180,1),Position=UDim2.new(1,dx*90,0,dy*90),Rotation=math.deg(math.atan2(dy,dx)),BackgroundColor3=Color3.fromRGB(170,150,190),BackgroundTransparency=.45,BorderSizePixel=0,ZIndex=0})
 end

 -- LAYER 0: bats in the background
 local function bat(x,y,s,rot)
  local body=shape(main,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(s*.35,s*.4),BackgroundColor3=ink,BorderSizePixel=0,Rotation=rot,ZIndex=0}); rounded(body)
  for _,side in ipairs({-1,1}) do
   local wing=shape(main,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(x+side*s*.35,y-s*.05),Size=UDim2.fromOffset(s*.6,s*.22),BackgroundColor3=ink,BorderSizePixel=0,Rotation=rot+side*-22,ZIndex=0}); rounded(wing,6)
  end
 end
 bat(230,90,34,-8); bat(560,140,26,10); bat(120,300,22,-14)

 -- LAYER 0: pumpkins on the bottom-right (behind the cards, visible through the gaps)
 local function pumpkin(x,y,s)
  local body=shape(main,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.new(0,x,1,y),Size=UDim2.fromOffset(s,s*.82),BackgroundColor3=orange,BorderSizePixel=0,ZIndex=0}); rounded(body,s)
  make("UIGradient",body,{Color=ColorSequence.new(Color3.fromRGB(255,175,70),Color3.fromRGB(190,60,10)),Rotation=90})
  local stem=shape(main,{AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(0,x,1,y-s*.4),Size=UDim2.fromOffset(s*.14,s*.24),BackgroundColor3=Color3.fromRGB(90,60,20),BorderSizePixel=0,ZIndex=0}); rounded(stem,4)
  for _,ex in ipairs({-s*.2,s*.2}) do shape(main,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.new(0,x+ex,1,y-s*.08),Size=UDim2.fromOffset(s*.18,s*.18),BackgroundColor3=ink,BorderSizePixel=0,Rotation=45,ZIndex=1}) end
  local mouth=shape(main,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.new(0,x,1,y+s*.16),Size=UDim2.fromOffset(s*.5,s*.13),BackgroundColor3=ink,BorderSizePixel=0,ZIndex=1}); rounded(mouth,6)
 end
 pumpkin(700,-58,64); pumpkin(664,-30,38)

 -- LAYER 0: floating embers
 local embers={}
 for i=1,12 do
  local e=shape(main,{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(4,4),BackgroundColor3=Color3.fromRGB(255,160,60),BorderSizePixel=0,ZIndex=0}); rounded(e)
