 local savedPunch={}
 local flightHum,flightRoot,oldRotate,oldPlatform,attachment,velocity,orientation
 local focused=true
 local savedBoxes={};local hitboxHumanoids={}
 for _,o in ipairs(workspace:GetDescendants()) do if o:IsA("Humanoid") then hitboxHumanoids[o]=true end end
 connect(workspace.DescendantAdded,function(o) if o:IsA("Humanoid") then hitboxHumanoids[o]=true end end)
 connect(workspace.DescendantRemoving,function(o) if o:IsA("Humanoid") then hitboxHumanoids[o]=nil end end)
 local function note(panel,message)
  return make("TextLabel",panel,{Size=UDim2.new(1,0,0,48),BackgroundTransparency=1,Text=message,TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=nextOrder(panel)+2})
 end
 local function stopFlight()
  if velocity then velocity:Destroy();velocity=nil end
  if orientation then orientation:Destroy();orientation=nil end
  if attachment then attachment:Destroy();attachment=nil end
  if flightHum and flightHum.Parent then flightHum.AutoRotate=oldRotate;flightHum.PlatformStand=oldPlatform end
  if flightRoot and flightRoot.Parent then flightRoot.AssemblyLinearVelocity=Vector3.zero;flightRoot.AssemblyAngularVelocity=Vector3.zero end
  flightHum=nil;flightRoot=nil
 end
 local function restoreBox(part)
  local original=savedBoxes[part];if not original then return end
  if part.Parent then pcall(function()
   part.Size=original.size
   part.Transparency=original.transparency
   part.CanCollide=original.collide
   if original.massless~=nil then part.Massless=original.massless end
   if original.canQuery~=nil then part.CanQuery=original.canQuery end
  end) end
  savedBoxes[part]=nil
 end
 local function restoreBoxes()
  local list={};for part in pairs(savedBoxes) do table.insert(list,part) end
  for _,part in ipairs(list) do restoreBox(part) end
 end
 local hitboxParts={"HumanoidRootPart","Torso","UpperTorso","LowerTorso","Head","Left Arm","Right Arm","LeftArm","RightArm","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","Left Hand","Right Hand","LeftHand","RightHand"}
 local function collectHitParts(char)
  local list={}
  for _,name in ipairs(hitboxParts) do
   local p=char:FindFirstChild(name)
   if p and p:IsA("BasePart") then table.insert(list,p) end
  end
  if #list==0 then
   local root=char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
   if root and root:IsA("BasePart") then table.insert(list,root) end
  end
  return list
 end
 local panel=card(pages.Movement,"Fly","")
 toggle(panel,"Fly",function() return fly end,function(v) fly=v;if not v then stopFlight() end end)
 moduleSlider(panel,"Flight speed",10,150,speed,"",function() return speed end,function(v) speed=v end)
 note(panel,"Camera-relative movement. WASD / thumbstick; Space rises; Left Ctrl descends. Local physics; server acceptance is not guaranteed.")
 local up,down=false,false
 for _,entry in ipairs({{"Hold to rise",true},{"Hold to descend",false}}) do
  local isUp=entry[2]
  local b=make("TextButton",panel,{Size=UDim2.new(1,0,0,30),Text=entry[1],BackgroundColor3=T.p2,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=12,LayoutOrder=nextOrder(panel)+2});corner(b,6)
  connect(b.InputBegan,function(i) if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then if isUp then up=true else down=true end end end)
  connect(b.InputEnded,function(i) if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then if isUp then up=false else down=false end end end)
 end
