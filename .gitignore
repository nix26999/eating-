 running=false; scriptsPaused=false
 enabled=false; todoEnabled=false; perfectClapEnabled=false; tripleJumpEnabled=false; pullEnabled=false; lockOn=false; chainEnabled=false; release()
 pcall(function() RS:UnbindFromRenderStep(bind) end)
 for _,conn in ipairs(conns) do pcall(function() conn:Disconnect() end) end
 destroyBackdrop() -- always unload Halloween background with the hub
