end)

-- ===== PART 4: depth (parallax, vignette, shadows, lightning) =====
;__JJSBoot:run("UI component 27",function()

 local ink=Color3.fromRGB(8,4,12)
 local TweenS=game:GetService("TweenService")

 -- far haze blobs (deepest layer)
 for i=1,3 do
  local b=make("Frame",main,{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(240+i*70,240+i*70),Position=UDim2.fromOffset(170*i,130*i),BackgroundColor3=Color3.fromRGB(110,60,30),BackgroundTransparency=.93,BorderSizePixel=0,ZIndex=0})
  make("UICorner",b,{CornerRadius=UDim.new(0,999)})
 end

 -- parallax: back-layer frames anchored to the top move a little with the mouse.
 -- Bottom-anchored pumpkins and fog, and the 4px embers, are left alone.
 local nodes={}
 for _,o in ipairs(main:GetChildren()) do
  if o:IsA("Frame") and o.ZIndex==0 and o.Size.X.Scale==0 and o.Size.Y.Scale==0 and o.Position.Y.Scale==0 and o.Size.X.Offset~=4 then
   local k=o.Size.X.Offset>=200 and .05 or (o.Size.Y.Offset==1 and .25 or .35)
   table.insert(nodes,{f=o,b=o.Position,k=k})
  end
 end
 local mx,my=0,0
 connect(RS.Heartbeat,function(dt)
  local m=UIS:GetMouseLocation();local ap,as=main.AbsolutePosition,main.AbsoluteSize
  local tx=math.clamp((m.X-ap.X-as.X*.5)/(as.X*.5),-1,1)
  local ty=math.clamp((m.Y-ap.Y-as.Y*.5)/(as.Y*.5),-1,1)
  local a=math.min(1,dt*5);mx+=(tx-mx)*a;my+=(ty-my)*a
  for _,n in ipairs(nodes) do
   local dx,dy=-mx*n.k*40,-my*n.k*30
   n.f.Position=UDim2.new(n.b.X.Scale,n.b.X.Offset+dx,n.b.Y.Scale,n.b.Y.Offset+dy)
  end
 end)

 -- vignette: dark edges that pull the eye to the middle (layer above the content)
 local function edge(size,pos,rot)
  local f=make("Frame",main,{Size=size,Position=pos,BackgroundColor3=ink,BorderSizePixel=0,ZIndex=8})
  make("UIGradient",f,{Color=ColorSequence.new(ink,ink),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.8),NumberSequenceKeypoint.new(1,1)}),Rotation=rot})
 end
 edge(UDim2.new(1,0,0,90),UDim2.new(0,0,0,0),90)
 edge(UDim2.new(1,0,0,90),UDim2.new(0,0,1,-90),-90)
 edge(UDim2.new(0,70,1,0),UDim2.new(0,0,0,0),0)
 edge(UDim2.new(0,70,1,0),UDim2.new(1,-70,0,0),180)

 -- inner shadow under the sidebar edge (depth between sidebar and page)
 local sideShadow=make("Frame",main,{Size=UDim2.new(0,12,1,-44),Position=UDim2.new(0,150,0,44),BackgroundColor3=ink,BorderSizePixel=0,ZIndex=2})
 make("UIGradient",sideShadow,{Color=ColorSequence.new(ink,ink),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.45),NumberSequenceKeypoint.new(1,1)}),Rotation=0})

 -- title drop shadow so the orange title sits above the top bar
 for _,o in ipairs(top:GetChildren()) do
  if o:IsA("TextLabel") and o.Text=="JJS HUB" then
   o.ZIndex=3
   local sh=o:Clone();sh.Name="TitleShadow";sh.ZIndex=2;sh.TextColor3=ink;sh.TextTransparency=.35;sh.TextStrokeTransparency=1
   sh.Position=o.Position+UDim2.fromOffset(2,2);sh.Parent=top
  end
 end

 
end)

