  ZIndex=200,
 })
 corner(toast,8)
 stroke(toast)
 task.delay(2.2,function()
  if toast and toast.Parent then toast:Destroy() end
 end)
end
local function copyDiscordLink()
 local ok=false
 if typeof(setclipboard)=="function" then ok=pcall(setclipboard,DISCORD_URL)
 elseif typeof(toclipboard)=="function" then ok=pcall(toclipboard,DISCORD_URL)
 elseif typeof(Clipboard)=="table" and typeof(Clipboard.set)=="function" then ok=pcall(Clipboard.set,DISCORD_URL)
 end
 return ok
end
local function openDiscordInvite()
 local opened=false
 for _,fn in ipairs({
  function() if typeof(openurl)=="function" then openurl(DISCORD_URL); return true end end,
  function() if typeof(OpenUrl)=="function" then OpenUrl(DISCORD_URL); return true end end,
 }) do
  local ok,res=pcall(fn)
  if ok and res then opened=true; break end
 end
 if opened then return end
 copyDiscordLink()
 showLinkCopiedToast()
end
connect(discordBtn.Activated,openDiscordInvite)
local reopen=make("TextButton",gui,{Name="JJSReopenButton",AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-18,1,-110),Size=UDim2.fromOffset(58,58),BackgroundColor3=T.acc,Text="JJS",TextColor3=Color3.fromRGB(25,12,6),Font=Enum.Font.GothamBold,TextSize=16,Visible=false,Active=true,ZIndex=100})
corner(reopen,29)
make("UIStroke",reopen,{Color=Color3.fromRGB(255,220,150),Thickness=2})
-- Floating reopen button can be dragged anywhere on touch or desktop.
local reopenDragging,reopenStart,reopenOrigin,reopenTouch,reopenMoved=false,nil,nil,nil,false
connect(reopen.InputBegan,function(input)
 if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
  reopenDragging=true;reopenMoved=false;reopenStart=input.Position;reopenOrigin=reopen.Position;reopenTouch=input
 end
end)
connect(UIS.InputChanged,function(input)
 if reopenDragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input==reopenTouch) then
  local delta=input.Position-reopenStart
  if math.abs(delta.X)+math.abs(delta.Y)>6 then reopenMoved=true end
  if reopenMoved then reopen.Position=UDim2.new(reopenOrigin.X.Scale,reopenOrigin.X.Offset+delta.X,reopenOrigin.Y.Scale,reopenOrigin.Y.Offset+delta.Y) end
 end
end)
connect(UIS.InputEnded,function(input) if input==reopenTouch then reopenDragging=false;reopenTouch=nil end end)
connect(reopen.Activated,function() if not reopenMoved and hubUnlocked and main.Parent then main.Visible=true;reopen.Visible=false end;reopenMoved=false end)
