 end
 local function flickCameraAfterSideDash(dashKey,right)
  local cam=workspace.CurrentCamera;if not cam or typing() then return end
  local configuredAngle=setting("Turn");local degrees=dashKey==Enum.KeyCode.D and -configuredAngle or configuredAngle
