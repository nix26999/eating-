 connect(UIS.WindowFocused,function() focused=true end)
 local hitPanel=card(pages.Combat,"Hitbox Expander (Local Only)","")
 toggle(hitPanel,"Hitbox Expander",function() return expand end,function(v) expand=v;if not v then restoreBoxes() end end)
 moduleSlider(hitPanel,"Enemy part size",2,25,boxSize," studs",function() return boxSize end,function(v) boxSize=v end)
 note(hitPanel,"Local-only: enlarges nearby players'/NPCs' body parts on your client (HRP + torso/arms/head when present). Does not change server hit detection. Sizes restore on disable.")
 local punchPanel=card(pages.Combat,"Expand Punch Range (Local Only)","")
 toggle(punchPanel,"Expand Punch Range",function() return punchExpand end,function(v) punchExpand=v;if not v then for part in pairs(savedPunch) do local o=savedPunch[part];if part.Parent and o then pcall(function() part.Size=o.size;part.Transparency=o.transparency;part.Massless=o.massless end) end end;table.clear(savedPunch) end end)
 moduleSlider(punchPanel,"Arm / hand size",2,20,punchSize," studs",function() return punchSize end,function(v) punchSize=v end)
 note(punchPanel,"Local-only: enlarges YOUR arms/hands (and slightly HRP) so punch reach is easier to see/judge on this client. Server hit detection is unchanged.")
 local recovery=card(pages.Player,"Local Recovery","")
