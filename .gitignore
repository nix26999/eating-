-- JJS HUB v2.6: sequential initialization + device badge + inspected additions.
local __JJSBoot=(function()
 local b={done=0,failed=0,total=33,ready=false,screen=nil,label=nil,fill=nil}
 local Players=game:GetService("Players")
 local Input=game:GetService("UserInputService")
 local mobile=Input.TouchEnabled and not Input.KeyboardEnabled
 b.device=mobile and "MOBILE" or "PC"
 b.color=mobile and Color3.fromRGB(255,209,64) or Color3.fromRGB(65,160,255)
 function b:icon(parent,position,size)
  local icon=Instance.new("Frame");icon.Name="DeviceIcon";icon.BackgroundTransparency=1;icon.Position=position;icon.Size=UDim2.fromOffset(size,size);icon.Parent=parent
  local outline=Instance.new("Frame");outline.BackgroundColor3=self.color;outline.BorderSizePixel=0
  if self.device=="PC" then outline.Size=UDim2.new(1,0,.65,0);outline.Position=UDim2.new(0,0,.05,0)
  else outline.Size=UDim2.new(.6,0,.95,0);outline.Position=UDim2.new(.2,0,0,0) end
  outline.Parent=icon
  local radius=Instance.new("UICorner");radius.CornerRadius=UDim.new(0,3);radius.Parent=outline
  local inset=Instance.new("Frame");inset.Size=UDim2.new(1,-4,1,-5);inset.Position=UDim2.fromOffset(2,2);inset.BorderSizePixel=0;inset.BackgroundColor3=Color3.fromRGB(34,26,22);inset.Parent=outline
  if self.device=="PC" then
   local stand=Instance.new("Frame");stand.BackgroundColor3=self.color;stand.BorderSizePixel=0;stand.Size=UDim2.new(.14,0,.19,0);stand.Position=UDim2.new(.43,0,.7,0);stand.Parent=icon
   local foot=Instance.new("Frame");foot.BackgroundColor3=self.color;foot.BorderSizePixel=0;foot.Size=UDim2.new(.55,0,.09,0);foot.Position=UDim2.new(.225,0,.88,0);foot.Parent=icon
  end
  return icon
 end
 local player=Players.LocalPlayer
 local pg=player and (player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui",10))
 if pg then
  local old=pg:FindFirstChild("JJSLoadingScreen");if old then old:Destroy() end
  for _,name in ipairs({"JJSStartupStatus","JJSHubStartupDiagnostic"}) do local stale=pg:FindFirstChild(name);if stale then stale:Destroy() end end
  local screen=Instance.new("ScreenGui");screen.Name="JJSLoadingScreen";screen.IgnoreGuiInset=true;screen.ResetOnSpawn=false;screen.DisplayOrder=2147483647;b.screen=screen
  local dim=Instance.new("TextButton");dim.Name="InputShield";dim.Text="";dim.AutoButtonColor=false;dim.Size=UDim2.fromScale(1,1);dim.BackgroundColor3=Color3.fromRGB(10,7,6);dim.BackgroundTransparency=.15;dim.BorderSizePixel=0;dim.Modal=true;dim.Parent=screen
  local panel=Instance.new("Frame");panel.Size=UDim2.fromOffset(500,250);panel.AnchorPoint=Vector2.new(.5,.5);panel.Position=UDim2.fromScale(.5,.5);panel.BackgroundColor3=Color3.fromRGB(34,26,22);panel.BorderSizePixel=0;panel.Parent=dim
  local scale=Instance.new("UIScale");local camera=workspace.CurrentCamera;local viewport=camera and camera.ViewportSize or Vector2.new(760,540);scale.Scale=math.min(1,(viewport.X-30)/500,(viewport.Y-30)/250);scale.Parent=panel
  local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,12);corner.Parent=panel
  local stroke=Instance.new("UIStroke");stroke.Color=Color3.fromRGB(255,122,26);stroke.Thickness=1;stroke.Parent=panel
  local title=Instance.new("TextLabel");title.Size=UDim2.fromOffset(450,34);title.Position=UDim2.fromOffset(24,22);title.BackgroundTransparency=1;title.Font=Enum.Font.GothamBold;title.TextSize=22;title.TextColor3=Color3.fromRGB(255,242,224);title.TextXAlignment=Enum.TextXAlignment.Left;title.Text="JJS HUB  /  v2.6";title.Parent=panel
  b:icon(panel,UDim2.fromOffset(26,72),34)
  local device=Instance.new("TextLabel");device.Size=UDim2.fromOffset(390,32);device.Position=UDim2.fromOffset(74,74);device.BackgroundTransparency=1;device.Font=Enum.Font.GothamBold;device.TextSize=15;device.TextColor3=b.color;device.TextXAlignment=Enum.TextXAlignment.Left;device.Text="Detected "..b.device.."  -  preparing modules";device.Parent=panel
  local label=Instance.new("TextLabel");label.Size=UDim2.fromOffset(450,48);label.Position=UDim2.fromOffset(24,120);label.BackgroundTransparency=1;label.Font=Enum.Font.Gotham;label.TextSize=12;label.TextColor3=Color3.fromRGB(200,160,180);label.TextXAlignment=Enum.TextXAlignment.Left;label.TextWrapped=true;label.Text="Device checked. Initializing interface...";label.Parent=panel;b.label=label
  local bar=Instance.new("Frame");bar.Size=UDim2.fromOffset(450,8);bar.Position=UDim2.fromOffset(24,185);bar.BackgroundColor3=Color3.fromRGB(52,40,32);bar.BorderSizePixel=0;bar.Parent=panel
  local fill=Instance.new("Frame");fill.Size=UDim2.fromScale(0,1);fill.BackgroundColor3=Color3.fromRGB(255,138,40);fill.BorderSizePixel=0;fill.Parent=bar;b.fill=fill
  local foot=Instance.new("TextLabel");foot.Size=UDim2.fromOffset(450,24);foot.Position=UDim2.fromOffset(24,205);foot.BackgroundTransparency=1;foot.Font=Enum.Font.Gotham;foot.TextSize=10;foot.TextColor3=Color3.fromRGB(150,110,140);foot.Text="Sequential startup - optional features remain off";foot.Parent=panel
  screen.Parent=pg
 end
 function b:run(name,fn)
  if self.label and self.label.Parent then self.label.Text=string.format("Loading %d / %d: %s",self.done+1,self.total,name) end
  task.wait(.025)
  local ok,err=xpcall(fn,function(e) return tostring(e) end)
  if not ok then self.failed+=1;warn("JJS v2.6 ["..name.."]: "..tostring(err)) end
  self.done+=1
  if self.fill and self.fill.Parent then self.fill.Size=UDim2.fromScale(math.clamp(self.done/self.total,0,1),1) end
  task.wait(.025)
  return ok,err
 end
 function b:finish(ok)
  self.ready=ok and true or false
  if self.label and self.label.Parent then self.label.Text=ok and (self.failed==0 and "Ready. Opening hub..." or "Hub ready; "..self.failed.." component(s) unavailable. See console.") or "Startup incomplete. See console." end
  task.wait(.3)
  if self.screen then self.screen:Destroy();self.screen=nil;self.label=nil;self.fill=nil end
 end
 task.wait(.05)
 return b
end)()
local __okMain,__errMain=xpcall(function()
local fxShutdown,onBlackflashPair

local Players=game:GetService("Players")
local RS=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local LP=Players.LocalPlayer
assert(LP,"Client required")
local PG=LP:WaitForChild("PlayerGui")
local old=PG:FindFirstChild("JJS HUB") or PG:FindFirstChild("AutoBlackflash")
if old then old:Destroy() end
-- remove leftover backdrop from a previous session
local oldBg=PG:FindFirstChild("JJSHalloweenBackdrop")
if oldBg then oldBg:Destroy() end
local running=true
-- when the hub window is open (Visible), combat macros pause; when closed they resume
local scriptsPaused=false
local hubUnlocked=false -- set true after key gate (or saved key)
local function scriptsActive() return running and not scriptsPaused and hubUnlocked and __JJSBoot.ready end
local todoEnabled,todoBusy=false,false
local perfectClapEnabled=false
local clapState={generation=0,pending=false}
local perfectClapDelay=350
local tripleJumpEnabled=false
local tripleJumpBusy=false
local lockDistance=250
local pullStrength=10
local pullEnabled=false
local lockTargetMode="Torso"
local enabled,lockOn,includeNPC,chainEnabled=false,false,false,false
local chainRepeats=3
local chainCooldownUntil=0
local lastThreeTime=0
local delayMs,mode=325,"Single"
local busy=false
local manualSequenceBusy=false
local blackflashV2Trigger=nil
local bfAssistActive=false
local followSetEnabled=nil
local assistState={getFollow=nil,previous=nil}
local lockOnPaint=nil
local followPaint=nil
local conns={}
local function bfAssistOn()
 if bfAssistActive then return end
 assistState.previous={lock=lockOn,follow=assistState.getFollow and assistState.getFollow() or false}
 bfAssistActive=true;lockOn=true
 if lockOnPaint then lockOnPaint() end
 if followSetEnabled then followSetEnabled(true) end
 if followPaint then followPaint() end
end
local function bfAssistOff()
 if not bfAssistActive then return end
 bfAssistActive=false
 local previous=assistState.previous;assistState.previous=nil
 if previous then lockOn=previous.lock;if followSetEnabled then followSetEnabled(previous.follow) end end
 if lockOnPaint then lockOnPaint() end
 if followPaint then followPaint() end
end
local T={bg=Color3.fromRGB(12,12,16),panel=Color3.fromRGB(18,18,24),p2=Color3.fromRGB(24,24,32),card=Color3.fromRGB(22,22,30),stroke=Color3.fromRGB(40,40,55),acc=Color3.fromRGB(168,85,255),txt=Color3.fromRGB(235,235,245),dim=Color3.fromRGB(140,140,160),mut=Color3.fromRGB(90,90,110),ok=Color3.fromRGB(80,200,120),warn=Color3.fromRGB(255,190,90)}
local function make(class,parent,props)
 local o=Instance.new(class)
 local ok,err=pcall(function() for k,v in pairs(props or {}) do o[k]=v end;o.Parent=parent end)
 if not ok then o:Destroy();error("Cannot create "..class..": "..tostring(err),2) end
 return o
end
local function connect(signal,fn) local c=signal:Connect(fn); table.insert(conns,c); return c end
local function corner(o,r) make("UICorner",o,{CornerRadius=UDim.new(0,r or 8)}) end
local function stroke(o) make("UIStroke",o,{Color=T.stroke,Thickness=1}) end
-- ===== PART 1: Halloween palette =====
;__JJSBoot:run("Halloween theme",function()

 T.bg=Color3.fromRGB(20,16,14)          -- midnight black-purple window
 T.panel=Color3.fromRGB(34,26,22)      -- top bar and sidebar
 T.p2=Color3.fromRGB(52,40,32)         -- buttons, inputs, selected tab
 T.card=Color3.fromRGB(40,30,26)       -- module cards
 T.stroke=Color3.fromRGB(255,122,26)   -- pumpkin orange outlines
 T.acc=Color3.fromRGB(255,138,40)      -- accent (ON states, selected text)
 T.txt=Color3.fromRGB(255,242,224)     -- warm cream text
 T.dim=Color3.fromRGB(200,160,180)     -- unselected labels
 T.mut=Color3.fromRGB(150,110,140)     -- hints and descriptions
 T.ok=Color3.fromRGB(160,255,120)      -- slime green
 T.warn=Color3.fromRGB(255,84,64)      -- blood red
 T.purple=Color3.fromRGB(255,190,90)   -- witch purple
 T.ghost=Color3.fromRGB(190,255,210)   -- ghost glow

end)

local gui=make("ScreenGui",PG,{Name="JJS HUB",ResetOnSpawn=false,DisplayOrder=999,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
-- Key gate: join Discord to get the key, then unlock the hub
local SCRIPT_KEY="J1nxhub01932456" -- post this key in your Discord
local KEY_FILE="JJSHub_key.txt"
local function keyAlreadySaved()
 if typeof(readfile)~="function" or typeof(isfile)~="function" then return false end
 local ok,data=pcall(function()
  if not isfile(KEY_FILE) then return false end
  return (readfile(KEY_FILE) or ""):gsub("%s+","")
 end)
 return ok and data==SCRIPT_KEY
end
local function saveKeyUnlock()
 if typeof(writefile)=="function" then pcall(writefile,KEY_FILE,SCRIPT_KEY) end
end
if keyAlreadySaved() then hubUnlocked=true end
local main=make("Frame",gui,{Size=UDim2.fromOffset(760,540),AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),BackgroundColor3=T.bg,BorderSizePixel=0,Active=true,Visible=hubUnlocked})
corner(main,12); stroke(main)
local scale=make("UIScale",main,{Scale=1})
local top=make("Frame",main,{Size=UDim2.new(1,0,0,44),BackgroundColor3=T.panel,BorderSizePixel=0,Active=true})
corner(top,12)
make("Frame",top,{Size=UDim2.new(1,0,0,14),Position=UDim2.new(0,0,1,-14),BackgroundColor3=T.panel,BorderSizePixel=0})
make("TextLabel",top,{Size=UDim2.fromOffset(225,44),Position=UDim2.fromOffset(16,0),BackgroundTransparency=1,Text="JJS HUB v2.6",TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=15,TextXAlignment=Enum.TextXAlignment.Left})
local badge=make("TextLabel",top,{Size=UDim2.fromOffset(48,18),Position=UDim2.new(0,220,.5,-9),BackgroundColor3=T.p2,Text="325",TextColor3=T.acc,Font=Enum.Font.GothamBold,TextSize=11}); corner(badge,4)
local DISCORD_URL="https://discord.gg/RrQQh6B4nP"
local discordBtn=make("TextButton",top,{Size=UDim2.fromOffset(86,28),Position=UDim2.new(1,-130,.5,-14),BackgroundColor3=Color3.fromRGB(88,101,242),Text="Discord",TextColor3=Color3.new(1,1,1),Font=Enum.Font.GothamBold,TextSize=12}); corner(discordBtn,6)
local close=make("TextButton",top,{Size=UDim2.fromOffset(28,28),Position=UDim2.new(1,-36,.5,-14),BackgroundColor3=T.p2,Text="x",TextColor3=T.dim,Font=Enum.Font.GothamBold,TextSize=16}); corner(close,6)
local function showLinkCopiedToast()
 local toast=make("TextLabel",gui,{
  Name="DiscordLinkToast",
  AnchorPoint=Vector2.new(.5,1),
  Position=UDim2.new(.5,0,1,-28),
  Size=UDim2.fromOffset(280,36),
  BackgroundColor3=Color3.fromRGB(20,20,24),
  BackgroundTransparency=.15,
  Text="LINK COPIED",
  TextColor3=Color3.new(1,1,1),
  Font=Enum.Font.GothamBold,
  TextSize=16,
  ZIndex=200,
 })
 corner(toast,8)
 stroke(toast)
 task.delay(2.2,function()
  if toast and toast.Parent then toast:Destroy() end
 end)
end
local function copyDiscordLink()
 local ok=false
 if typeof(setclipboard)=="function" then ok=pcall(setclipboard,DISCORD_URL)
 elseif typeof(toclipboard)=="function" then ok=pcall(toclipboard,DISCORD_URL)
 elseif typeof(Clipboard)=="table" and typeof(Clipboard.set)=="function" then ok=pcall(Clipboard.set,DISCORD_URL)
 end
 return ok
end
local function openDiscordInvite()
 local opened=false
 for _,fn in ipairs({
  function() if typeof(openurl)=="function" then openurl(DISCORD_URL); return true end end,
  function() if typeof(OpenUrl)=="function" then OpenUrl(DISCORD_URL); return true end end,
 }) do
  local ok,res=pcall(fn)
  if ok and res then opened=true; break end
 end
 if opened then return end
 copyDiscordLink()
 showLinkCopiedToast()
end
connect(discordBtn.Activated,openDiscordInvite)
local reopen=make("TextButton",gui,{Name="JJSReopenButton",AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-18,1,-110),Size=UDim2.fromOffset(58,58),BackgroundColor3=T.acc,Text="JJS",TextColor3=Color3.fromRGB(25,12,6),Font=Enum.Font.GothamBold,TextSize=16,Visible=false,Active=true,ZIndex=100})
corner(reopen,29)
make("UIStroke",reopen,{Color=Color3.fromRGB(255,220,150),Thickness=2})
-- Floating reopen button can be dragged anywhere on touch or desktop.
local reopenDragging,reopenStart,reopenOrigin,reopenTouch,reopenMoved=false,nil,nil,nil,false
connect(reopen.InputBegan,function(input)
 if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
  reopenDragging=true;reopenMoved=false;reopenStart=input.Position;reopenOrigin=reopen.Position;reopenTouch=input
 end
end)
connect(UIS.InputChanged,function(input)
 if reopenDragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input==reopenTouch) then
  local delta=input.Position-reopenStart
  if math.abs(delta.X)+math.abs(delta.Y)>6 then reopenMoved=true end
  if reopenMoved then reopen.Position=UDim2.new(reopenOrigin.X.Scale,reopenOrigin.X.Offset+delta.X,reopenOrigin.Y.Scale,reopenOrigin.Y.Offset+delta.Y) end
 end
end)
connect(UIS.InputEnded,function(input) if input==reopenTouch then reopenDragging=false;reopenTouch=nil end end)
connect(reopen.Activated,function() if not reopenMoved and hubUnlocked and main.Parent then main.Visible=true;reopen.Visible=false end;reopenMoved=false end)
-- ===== KEY PAGE (shown until valid key from Discord) =====
local keyPage=nil
if not hubUnlocked then
 keyPage=make("Frame",gui,{
  Name="KeyPage",
  Size=UDim2.fromOffset(420,320),
  Position=UDim2.new(.5,-210,.5,-160),
  BackgroundColor3=T.bg,
  BorderSizePixel=0,
  Active=true,
  ZIndex=50,
 })
 corner(keyPage,12); stroke(keyPage)
 local keyClose=make("TextButton",keyPage,{
  Size=UDim2.fromOffset(28,28),Position=UDim2.new(1,-36,0,12),
  BackgroundColor3=T.p2,Text="x",TextColor3=T.dim,Font=Enum.Font.GothamBold,TextSize=16,ZIndex=52,
 }); corner(keyClose,6)
 connect(keyClose.Activated,function()
  if keyPage then keyPage:Destroy(); keyPage=nil end
  pcall(function() if gui.Parent then gui:Destroy() end end)
 end)
 make("TextLabel",keyPage,{
  Size=UDim2.new(1,-56,0,28),Position=UDim2.fromOffset(16,18),
  BackgroundTransparency=1,Text="JJS HUB — Key Required",
  TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=18,
  TextXAlignment=Enum.TextXAlignment.Left,ZIndex=51,
 })
 make("TextLabel",keyPage,{
  Size=UDim2.new(1,-32,0,48),Position=UDim2.fromOffset(16,52),
  BackgroundTransparency=1,
  Text="Join our Discord to get the free key, then paste it below to unlock the script.",
  TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=13,TextWrapped=true,
  TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,ZIndex=51,
 })
 local keyDiscord=make("TextButton",keyPage,{
  Size=UDim2.new(1,-32,0,36),Position=UDim2.fromOffset(16,110),
  BackgroundColor3=Color3.fromRGB(88,101,242),Text="Join Discord",
  TextColor3=Color3.new(1,1,1),Font=Enum.Font.GothamBold,TextSize=14,ZIndex=51,
 }); corner(keyDiscord,8)
 connect(keyDiscord.Activated,openDiscordInvite)
 local keyBox=make("TextBox",keyPage,{
  Size=UDim2.new(1,-32,0,36),Position=UDim2.fromOffset(16,158),
  BackgroundColor3=T.p2,Text="",PlaceholderText="Enter key from Discord...",
  TextColor3=T.txt,PlaceholderColor3=T.mut,Font=Enum.Font.Gotham,TextSize=14,
  ClearTextOnFocus=false,ZIndex=51,
 }); corner(keyBox,8)
 local keyStatus=make("TextLabel",keyPage,{
  Size=UDim2.new(1,-32,0,20),Position=UDim2.fromOffset(16,200),
  BackgroundTransparency=1,Text="",TextColor3=T.warn,Font=Enum.Font.Gotham,TextSize=12,
  TextXAlignment=Enum.TextXAlignment.Left,ZIndex=51,
 })
 local keySubmit=make("TextButton",keyPage,{
  Size=UDim2.new(1,-32,0,40),Position=UDim2.fromOffset(16,232),
  BackgroundColor3=T.acc,Text="Unlock Script",
  TextColor3=Color3.fromRGB(20,12,8),Font=Enum.Font.GothamBold,TextSize=15,ZIndex=51,
 }); corner(keySubmit,8)
 local function tryUnlock()
  local entered=(keyBox.Text or ""):gsub("^%s+",""):gsub("%s+$","")
  if entered=="" then keyStatus.Text="Enter a key first."; keyStatus.TextColor3=T.warn; return end
  if entered:lower()==SCRIPT_KEY:lower() then
   hubUnlocked=true
   saveKeyUnlock()
   keyStatus.Text="Unlocked!"; keyStatus.TextColor3=T.ok
   main.Visible=true
   if keyPage then keyPage:Destroy(); keyPage=nil end
  else
   keyStatus.Text="Invalid key — join Discord to get the correct one."
   keyStatus.TextColor3=T.warn
  end
 end
 connect(keySubmit.Activated,tryUnlock)
 connect(keyBox.FocusLost,function(enter) if enter then tryUnlock() end end)
end
local side=make("ScrollingFrame",main,{Size=UDim2.new(0,150,1,-44),Position=UDim2.fromOffset(0,44),BackgroundColor3=T.panel,BorderSizePixel=0,ScrollBarThickness=2,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new()})
make("UIListLayout",side,{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder})
make("UIPadding",side,{PaddingTop=UDim.new(0,10),PaddingLeft=UDim.new(0,8),PaddingRight=UDim.new(0,8)})
local content=make("Frame",main,{Size=UDim2.new(1,-150,1,-44),Position=UDim2.fromOffset(150,44),BackgroundColor3=T.bg,BorderSizePixel=0,ClipsDescendants=true})
local title=make("TextLabel",content,{Size=UDim2.new(1,-24,0,22),Position=UDim2.fromOffset(16,10),BackgroundTransparency=1,Text="Macros",TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=18,TextXAlignment=Enum.TextXAlignment.Left})
local desc=make("TextLabel",content,{Size=UDim2.new(1,-24,0,0),Position=UDim2.fromOffset(16,32),Visible=false,BackgroundTransparency=1,Text="",TextColor3=T.mut,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left})
local pages,buttons={},{}
local cats={{"Macros",""},{"Combat",""},{"Targeting",""},{"Movement",""},{"Player",""},{"ESP",""},{"Visuals",""},{"Animations",""},{"Settings",""}}
for i,cat in ipairs(cats) do
 local name,description=cat[1],cat[2]
 local groupStart={Macros="MAIN",Combat="COMBAT",Movement="MOVEMENT",Visuals="VISUALS"}
 if groupStart[name] then make("TextLabel",side,{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text="~ "..groupStart[name].." ~",TextColor3=T.mut,Font=Enum.Font.GothamBold,TextSize=10,LayoutOrder=i*10-5}) end
 local b=make("TextButton",side,{Size=UDim2.new(1,0,0,32),BackgroundColor3=T.p2,BackgroundTransparency=i==1 and 0 or 1,Text=name,TextColor3=i==1 and T.acc or T.dim,Font=Enum.Font.GothamMedium,TextSize=13,LayoutOrder=i*10}); corner(b,8); buttons[name]=b
 local p=make("ScrollingFrame",content,{Size=UDim2.new(1,0,1,-40),Position=UDim2.fromOffset(0,40),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),Visible=i==1})
 make("UIPadding",p,{PaddingLeft=UDim.new(0,14),PaddingRight=UDim.new(0,14),PaddingTop=UDim.new(0,4),PaddingBottom=UDim.new(0,16)})
 make("UIListLayout",p,{Padding=UDim.new(0,10),SortOrder=Enum.SortOrder.LayoutOrder}); pages[name]=p
 connect(b.Activated,function()
  title.Text=name; desc.Text=""
  for key,page in pairs(pages) do page.Visible=key==name end
  for key,btn in pairs(buttons) do
   btn.BackgroundTransparency=mobileMode and 0 or (key==name and 0 or 1)
   btn.BackgroundColor3=mobileMode and (key==name and T.acc or T.p2) or T.p2
   btn.TextColor3=mobileMode and (key==name and Color3.fromRGB(28,14,6) or T.dim) or (key==name and T.acc or T.dim)
   btn.Font=key==name and Enum.Font.GothamBold or Enum.Font.GothamMedium
  end
 end)
end

-- Responsive navigation: polished phone layout with large touch targets.
local sideLayout=side:FindFirstChildOfClass("UIListLayout")
local mobileMode=false
local function applyResponsiveLayout()
 local camera=workspace.CurrentCamera
 local viewport=camera and camera.ViewportSize or Vector2.new(760,540)
 local compact=UIS.TouchEnabled or viewport.X<700
 mobileMode=compact

 if compact then
  -- Compact floating window on mobile (not edge-to-edge). UIScale keeps the
  -- original layout proportions instead of stretching the desktop panel.
  main.Size=UDim2.fromOffset(760,540)
  main.Position=UDim2.fromScale(.5,.5)
  scale.Scale=math.min(.78,(viewport.X-28)/760,(viewport.Y-48)/540)
  scale.Scale=math.max(.38,scale.Scale)
  top.Size=UDim2.new(1,0,0,52)
  side.Position=UDim2.fromOffset(0,52)
  side.Size=UDim2.new(1,0,0,54)
  side.ScrollingDirection=Enum.ScrollingDirection.X
  side.AutomaticCanvasSize=Enum.AutomaticSize.X
  side.CanvasSize=UDim2.new()
  side.ScrollBarThickness=0
  side.BackgroundColor3=T.panel
  if sideLayout then sideLayout.FillDirection=Enum.FillDirection.Horizontal;sideLayout.Padding=UDim.new(0,8) end
  local sidePad=side:FindFirstChildOfClass("UIPadding")
  if sidePad then
   sidePad.PaddingTop=UDim.new(0,6);sidePad.PaddingBottom=UDim.new(0,6)
   sidePad.PaddingLeft=UDim.new(0,10);sidePad.PaddingRight=UDim.new(0,10)
  end
  for name,nav in pairs(buttons) do
   nav.Size=UDim2.fromOffset(112,42);nav.TextSize=13
   nav.TextWrapped=false
   nav.BackgroundTransparency=0
   nav.BackgroundColor3=pages[name] and pages[name].Visible and T.acc or T.p2
   nav.TextColor3=pages[name] and pages[name].Visible and Color3.fromRGB(28,14,6) or T.dim
   nav.Font=pages[name] and pages[name].Visible and Enum.Font.GothamBold or Enum.Font.GothamMedium
  end
  for _,child in ipairs(side:GetChildren()) do if child:IsA("TextLabel") then child.Visible=false end end
  content.Position=UDim2.fromOffset(0,106)
  content.Size=UDim2.new(1,0,1,-106)
  title.TextSize=16;title.Position=UDim2.fromOffset(14,9)
  discordBtn.Visible=false
  badge.Size=UDim2.fromOffset(42,20);badge.Position=UDim2.new(0,142,.5,-10)
  close.Size=UDim2.fromOffset(40,40);close.Position=UDim2.new(1,-46,.5,-20)
  close.TextSize=20
 else
  main.Size=UDim2.fromOffset(760,540)
  main.Position=UDim2.fromScale(.5,.5)
  scale.Scale=math.min(1,(viewport.X-24)/760,(viewport.Y-40)/540)
  top.Size=UDim2.new(1,0,0,44)
  side.Position=UDim2.fromOffset(0,44)
  side.Size=UDim2.new(0,150,1,-44)
  side.ScrollingDirection=Enum.ScrollingDirection.Y
  side.AutomaticCanvasSize=Enum.AutomaticSize.Y
  side.ScrollBarThickness=2
  side.BackgroundColor3=T.panel
  if sideLayout then sideLayout.FillDirection=Enum.FillDirection.Vertical;sideLayout.Padding=UDim.new(0,4) end
  local sidePad=side:FindFirstChildOfClass("UIPadding")
  if sidePad then
   sidePad.PaddingTop=UDim.new(0,10);sidePad.PaddingBottom=UDim.new(0,0)
   sidePad.PaddingLeft=UDim.new(0,8);sidePad.PaddingRight=UDim.new(0,8)
  end
  for name,nav in pairs(buttons) do
   nav.Size=UDim2.new(1,0,0,32);nav.TextSize=13
   nav.BackgroundTransparency=pages[name] and pages[name].Visible and 0 or 1
   nav.BackgroundColor3=T.p2
   nav.TextColor3=pages[name] and pages[name].Visible and T.acc or T.dim
   nav.Font=pages[name] and pages[name].Visible and Enum.Font.GothamBold or Enum.Font.GothamMedium
  end
  for _,child in ipairs(side:GetChildren()) do if child:IsA("TextLabel") then child.Visible=true end end
  content.Position=UDim2.fromOffset(150,44)
  content.Size=UDim2.new(1,-150,1,-44)
  title.TextSize=18;title.Position=UDim2.fromOffset(16,10)
  discordBtn.Visible=true
  badge.Size=UDim2.fromOffset(48,18);badge.Position=UDim2.new(0,220,.5,-9)
  close.Size=UDim2.fromOffset(28,28);close.Position=UDim2.new(1,-36,.5,-14)
  close.TextSize=16
 end

 if keyPage and keyPage.Parent then
  keyPage.AnchorPoint=Vector2.new(.5,.5);keyPage.Position=UDim2.fromScale(.5,.5)
  local keyScale=keyPage:FindFirstChildOfClass("UIScale")
  if not keyScale then keyScale=Instance.new("UIScale");keyScale.Parent=keyPage end
  keyScale.Scale=math.min(1,(viewport.X-24)/420,(viewport.Y-24)/320)
 end
end
applyResponsiveLayout()
local ord={}
local function nextOrder(p) ord[p]=(ord[p] or 0)+1; return ord[p] end
local function card(p,name,sub)
 local c=make("Frame",p,{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=T.card,BorderSizePixel=0,LayoutOrder=nextOrder(p)}); corner(c,10); stroke(c)
 make("UIPadding",c,{PaddingTop=UDim.new(0,10),PaddingBottom=UDim.new(0,10),PaddingLeft=UDim.new(0,12),PaddingRight=UDim.new(0,12)})
 make("UIListLayout",c,{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder})
 make("TextLabel",c,{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,Text=name,TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=0})
 make("Frame",c,{Size=UDim2.new(1,0,0,1),BackgroundColor3=T.stroke,BorderSizePixel=0,LayoutOrder=2}); return c
end
local function toggle(p,name,get,set)
 local r=make("TextButton",p,{Size=UDim2.new(1,0,0,UIS.TouchEnabled and 48 or 40),BackgroundTransparency=1,Text="",LayoutOrder=nextOrder(p)+2})
 make("TextLabel",r,{Size=UDim2.new(1,-50,1,0),BackgroundTransparency=1,Text=name,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=UIS.TouchEnabled and 14 or 12,TextXAlignment=Enum.TextXAlignment.Left})
 local track=make("Frame",r,{Size=UIS.TouchEnabled and UDim2.fromOffset(44,24) or UDim2.fromOffset(36,18),Position=UIS.TouchEnabled and UDim2.new(1,-44,.5,-12) or UDim2.new(1,-36,.5,-9),BackgroundColor3=T.p2,BorderSizePixel=0}); corner(track,9)
 local knob=make("Frame",track,{Size=UIS.TouchEnabled and UDim2.fromOffset(18,18) or UDim2.fromOffset(14,14),Position=UDim2.new(0,2,.5,UIS.TouchEnabled and -9 or -7),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0}); corner(knob,7)
 local function paint() track.BackgroundColor3=get() and T.acc or Color3.fromRGB(45,45,55); knob.Position=get() and UDim2.new(1,UIS.TouchEnabled and -20 or -16,.5,UIS.TouchEnabled and -9 or -7) or UDim2.new(0,2,.5,UIS.TouchEnabled and -9 or -7) end
 connect(r.Activated,function() set(not get()); paint() end); paint()
 return paint
end
