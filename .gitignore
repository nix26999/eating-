 hill(.86,360,Color3.fromRGB(20,9,7),10)
 for i=1,10 do
  local x=rnd(.02,.98)
  local st=F({AnchorPoint=Vector2.new(.5,1),Size=UDim2.fromOffset(18,28),Position=UDim2.new(x,0,.9,0),BackgroundColor3=Color3.fromRGB(58,52,48),BorderSizePixel=0,ZIndex=11}); round(st,9)
  make("UIGradient",st,{Color=ColorSequence.new(Color3.fromRGB(80,72,66),Color3.fromRGB(30,26,24)),Rotation=90})
