toggle(tc,"Todo Macro",function() return todoEnabled end,function(v) todoEnabled=v end)
local todoStatus=make("TextLabel",tc,{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,Text="Ready",TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=nextOrder(tc)+2})
toggle(tc,"Perfect Clap",function() return perfectClapEnabled end,function(v) perfectClapEnabled=v;clapState.generation+=1;clapState.pending=false end)
moduleSlider(tc,"Clap delay",50,1000,perfectClapDelay," ms",function() return perfectClapDelay end,function(v) perfectClapDelay=v end)
local sc=card(pages.Settings,"Session","")
local status=make("TextLabel",sc,{Size=UDim2.new(1,0,0,42),BackgroundTransparency=1,Text="Ready",TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=3})
local unload=make("TextButton",sc,{Size=UDim2.new(1,0,0,30),BackgroundColor3=Color3.fromRGB(130,45,65),Text="Unload",TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=12,LayoutOrder=4}); corner(unload,8)
local okVIM,VIM=pcall(function() return game:GetService("VirtualInputManager") end)
local function todoWait(seconds)
 local finish=os.clock()+seconds
 while running and todoEnabled and os.clock()<finish do task.wait() end
 return running and todoEnabled
end
local function todoKey(key)
 assert(okVIM and VIM,"Input simulation unavailable")
 VIM:SendKeyEvent(true,key,false,game)
 task.wait(.035)
 VIM:SendKeyEvent(false,key,false,game)
end
local function runTodo()
 if todoBusy or busy or manualSequenceBusy or UIS:GetFocusedTextBox() or not scriptsActive() or not todoEnabled then return end
 todoBusy=true; busy=true
 local ok,err=pcall(function()
  if not todoWait(.8) then return end
  todoKey(Enum.KeyCode.R)
  if not todoWait(.1) then return end
  todoKey(Enum.KeyCode.Two)
  if not todoWait(.65) then return end
  todoKey(Enum.KeyCode.Two)
 end)
 todoBusy=false; busy=false
 if running then
  todoStatus.Text=ok and (todoEnabled and "Sequence finished" or "Cancelled") or tostring(err)
  todoStatus.TextColor3=ok and T.dim or T.warn
 end
end
local keyHeld=false
local function release() if keyHeld and okVIM then pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.Three,false,game) end) end; keyHeld=false end
local function send(duration)
 assert(okVIM and VIM,"Input simulation unavailable")
 keyHeld=true; VIM:SendKeyEvent(true,Enum.KeyCode.Three,false,game)
 local untilTime=os.clock()+duration
 while scriptsActive() and enabled and os.clock()<untilTime do task.wait() end
 release()
end
local function run()
 if busy or not enabled or not scriptsActive() then return end
 busy=true
 local ms,action=delayMs,mode
 local ok,err=pcall(function()
  task.wait(ms/1000)
  if not scriptsActive() or not enabled then return end
  local count=action=="Triple" and 3 or action=="Double" and 2 or 1
  for i=1,count do
   if not enabled or not scriptsActive() then break end
   send(action=="Hold" and ms/1000 or .035)
   if i<count then task.wait(.08) end
  end
 end)
 release(); busy=false
 if running then status.Text=ok and "Sequence finished" or tostring(err) end
end
local function chainActive() return scriptsActive() and chainEnabled end
local function chainWait(seconds)
 local finish=os.clock()+seconds
 while chainActive() and os.clock()<finish do task.wait() end
 return chainActive()
end
local function chainClickLMB()
 if not chainActive() then return false end
 assert(okVIM and VIM,"Input simulation unavailable")
 VIM:SendMouseButtonEvent(0,0,0,true,game,0)
 chainWait(.035)
 VIM:SendMouseButtonEvent(0,0,0,false,game,0)
 return chainActive()
end
local function chainPress3()
 if not chainActive() then return false end
 send(.035)
 return chainActive()
end
local function runChain()
 if busy or not chainActive() then return end
 busy=true
 local ok,err=pcall(function()
  for i=1,chainRepeats do
   if not chainActive() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(.65) then break end
   if not chainClickLMB() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(.65) then break end
   if not chainClickLMB() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if i%2==0 and i<chainRepeats then
    chainCooldownUntil=os.clock()+5
    busy=false
    return
   end
  end
 end)
 release()
 busy=false
 if running then status.Text=ok and "Copied Auto Blackflash sequence finished" or tostring(err) end
end
local humanoids={}
local function track(o) if o:IsA("Humanoid") then humanoids[o]=true end end
connect(workspace.DescendantAdded,track)
connect(workspace.DescendantRemoving,function(o) humanoids[o]=nil end)
for _,o in ipairs(workspace:GetDescendants()) do track(o) end
local function target()
 local char=LP.Character; local root=char and char:FindFirstChild("HumanoidRootPart")
 if not root then return nil,nil end
 local best,distance=nil,lockDistance
 local bestModel=nil
 for hum in pairs(humanoids) do
  local model=hum.Parent
  if model and model:IsA("Model") and model~=char and hum.Health>0 then
   local owner=Players:GetPlayerFromCharacter(model)
   if owner or includeNPC then
    local part=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if part and part:IsA("BasePart") then
     local d=(part.Position-root.Position).Magnitude
     if d<distance then best=part; distance=d; bestModel=model end
    end
   end
  end
 end
 return best,bestModel
end
local bind="AutoBlackflashCamera"
local cached,targetModel,lastScan=nil,nil,0
RS:BindToRenderStep(bind,Enum.RenderPriority.Camera.Value+1,function(dt)
 if not running or not lockOn or gui:GetAttribute("FlingSequenceActive") then cached=nil; return end
 if UIS:GetFocusedTextBox() then return end
 if os.clock()-lastScan>.2 then cached,targetModel=target(); lastScan=os.clock() end
 local cam=workspace.CurrentCamera
 if cam and cached and cached.Parent then
  local aimPos=cached.Position
  if targetModel and lockTargetMode=="Back" then
   local root=targetModel:FindFirstChild("HumanoidRootPart")
   if root then aimPos=root.Position-root.CFrame.LookVector*3 end
  end
  local delta=aimPos-cam.CFrame.Position
  if delta.Magnitude>.01 then cam.CFrame=cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position,aimPos),1-math.exp(-18*dt)) end
  if pullEnabled and cached.Parent then
   local char=LP.Character
   local root=char and char:FindFirstChild("HumanoidRootPart")
   if root then
    local direction=aimPos-root.Position
    if direction.Magnitude>.5 then root.AssemblyLinearVelocity=direction.Unit*pullStrength end
   end
  end
 end
end)
local function clapClick()
 if not okVIM or not VIM or not scriptsActive() or UIS:GetFocusedTextBox() then return end
 local cursor=UIS:GetMouseLocation()
 local ok,err=pcall(function() VIM:SendMouseButtonEvent(cursor.X,cursor.Y,0,true,game,0);task.wait(.035) end)
 pcall(function() VIM:SendMouseButtonEvent(cursor.X,cursor.Y,0,false,game,0) end)
 if not ok then warn("Clap input: "..tostring(err)) end
end
local function runPerfectClap()
 if not perfectClapEnabled or not scriptsActive() or clapState.pending or busy or manualSequenceBusy then return end
 clapState.pending=true
 local ticket=clapState.generation;local character=LP.Character
 task.delay(perfectClapDelay/1000,function()
  if ticket~=clapState.generation then return end
  clapState.pending=false
  local h=character and character:FindFirstChildOfClass("Humanoid")
  if scriptsActive() and perfectClapEnabled and LP.Character==character and h and h.Health>0 and not busy and not manualSequenceBusy then clapClick() end
 end)
end
connect(LP.CharacterRemoving,function() clapState.generation+=1;clapState.pending=false end)
connect(UIS.WindowFocusReleased,function() clapState.generation+=1;clapState.pending=false end)

local function runTripleJump()
 if tripleJumpBusy or busy or todoBusy or manualSequenceBusy or UIS:GetFocusedTextBox() or not scriptsActive() or not tripleJumpEnabled then return end
 if not okVIM or not VIM then return end
 tripleJumpBusy=true; busy=true
 local ok,err=pcall(function()
  for i=1,3 do
   if not scriptsActive() or not tripleJumpEnabled then break end

   VIM:SendMouseButtonEvent(0,0,0,true,game,0)
   task.wait(.035)
   VIM:SendMouseButtonEvent(0,0,0,false,game,0)

   task.wait(.100)
   local char=LP.Character
   local hum=char and char:FindFirstChildOfClass("Humanoid")
   if hum and hum.Health>0 then
    hum.Jump=true
    pcall(function() VIM:SendKeyEvent(true,Enum.KeyCode.Space,false,game) end)
    task.wait(.035)
    pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.Space,false,game) end)
   end

   task.wait(.050)
   VIM:SendMouseButtonEvent(0,0,0,true,game,0)
   task.wait(.035)
   VIM:SendMouseButtonEvent(0,0,0,false,game,0)
   if i<3 then task.wait(.05) end
  end
 end)
 pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.Space,false,game) end)
 pcall(function() local c=UIS:GetMouseLocation();VIM:SendMouseButtonEvent(c.X,c.Y,0,false,game,0) end)
 tripleJumpBusy=false; busy=false
 if running and status and status.Parent then
  status.Text=ok and "Triple jump sequence sent" or tostring(err)
 end
end

;__JJSBoot:run("Standard True Stun Lock",function()

 local active=false
 local token=0
 local heldKey=nil
 local mouseHeld=false
 local panel=card(pages.Combat,"Standard True Stun Lock","")
 local label=make("TextLabel",panel,{Size=UDim2.new(1,0,0,42),BackgroundTransparency=1,Text="Ready",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3})
 local button=make("TextButton",panel,{Size=UDim2.new(1,0,0,30),BackgroundColor3=T.p2,Text="Play / Cancel True Stun Lock (K)",TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=12,LayoutOrder=4}); corner(button,6)

 local timing={
  punchGap=.60,
  clickHold=.035,
  startup=.08,
  qHold=.18,
  afterQ=.25,
  afterThreeM1=.07,
  afterCursed=2.0,
  afterSecondM1=.30,
  blackFlashGap=.325,
  afterBlackFlash=.40,
  jumpLead=.12,
  afterJumpBeforeTwo=.05,
 }
 local function releaseCombo()
  if okVIM and VIM then
   if heldKey then pcall(function() VIM:SendKeyEvent(false,heldKey,false,game) end) end
   if mouseHeld then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end
  end
  heldKey=nil; mouseHeld=false
 end
 local function cancel()
  token+=1; active=false; manualSequenceBusy=false; releaseCombo()
  if label.Parent then label.Text="Ready" end
 end
 local function toggleCombo()
  if active then cancel(); return end
  if busy or manualSequenceBusy then label.Text="Wait for the other macro to finish"; return end
  if not okVIM or not VIM then label.Text="Input simulation unavailable"; return end
  active=true; manualSequenceBusy=true; token+=1
  local id=token
  task.spawn(function()
   local function check()
    local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if not running or token~=id or not h or h.Health<=0 then error("Combo cancelled",0) end
   end
   local function waitFor(seconds)
    local finish=os.clock()+seconds
    repeat check(); task.wait() until os.clock()>=finish
    check()
   end
   local function click()
    check(); mouseHeld=true
    local cursor=UIS:GetMouseLocation()
    VIM:SendMouseButtonEvent(cursor.X,cursor.Y,0,true,game,0)
    waitFor(timing.clickHold or .05)
    VIM:SendMouseButtonEvent(cursor.X,cursor.Y,0,false,game,0); mouseHeld=false
   end
   local function key(code,hold)
    check()
    hold=hold or .08
    heldKey=code
    VIM:SendKeyEvent(true,code,false,game)
    waitFor(hold)
    VIM:SendKeyEvent(false,code,false,game)
    heldKey=nil
   end
   local function threeM1(afterWait)
    for i=1,3 do
     click()
     if i<3 then waitFor(timing.punchGap) end
    end
    if afterWait and afterWait>0 then waitFor(afterWait) end
   end
   local ok,err=pcall(function()
    label.Text="True Stun Lock: Approach / Dash Q"
    heldKey=Enum.KeyCode.Q
    VIM:SendKeyEvent(true,Enum.KeyCode.Q,false,game)
    waitFor(timing.qHold)
    VIM:SendKeyEvent(false,Enum.KeyCode.Q,false,game)
    heldKey=nil
    waitFor(timing.afterQ)
    label.Text="True Stun Lock: 3 M1 (no 4th)"
    waitFor(timing.startup)
    threeM1(nil)

    if mouseHeld then
     local c=UIS:GetMouseLocation()
     VIM:SendMouseButtonEvent(c.X,c.Y,0,false,game,0)
     mouseHeld=false
    end
    waitFor(timing.afterThreeM1)
    label.Text="True Stun Lock: Ability 1 Cursed Strikes"
    key(Enum.KeyCode.One,.12)
    waitFor(timing.afterCursed)
    label.Text="True Stun Lock: 3 M1 follow-up"
    threeM1(timing.afterSecondM1)
    label.Text="True Stun Lock: Ability 3 Divergent Fist / Black Flash"
    local first=os.clock()
    key(Enum.KeyCode.Three)
    local remain=timing.blackFlashGap-(os.clock()-first)
    if remain>0 then waitFor(remain) end
    key(Enum.KeyCode.Three)
    waitFor(timing.afterBlackFlash)
    label.Text="True Stun Lock: Jump + Ability 2 Crushing Blow"
    heldKey=Enum.KeyCode.Space
    VIM:SendKeyEvent(true,Enum.KeyCode.Space,false,game)
    local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.Jump=true end
    waitFor(timing.jumpLead)
    key(Enum.KeyCode.Two)
    VIM:SendKeyEvent(false,Enum.KeyCode.Space,false,game)
    heldKey=nil
   end)
   if token==id then
    releaseCombo(); active=false; manualSequenceBusy=false
    if label.Parent then label.Text=ok and "True Stun Lock inputs sent" or tostring(err) end
   end
  end)
 end
 connect(button.Activated,toggleCombo)
 connect(UIS.InputBegan,function(input,processed)
  if processed or UIS:GetFocusedTextBox() then return end
  if input.KeyCode==Enum.KeyCode.K then toggleCombo() end
 end)
 connect(LP.CharacterRemoving,cancel)
 connect(gui.Destroying,cancel)
 connect(unload.Activated,cancel)

end)

;__JJSBoot:run("Hyper King 90% DMG",function()

 local active=false
 local token=0
 local heldKey=nil
 local mouseHeld=false
 local side=Enum.KeyCode.D
 local panel=card(pages.Combat,"Hyper King 90% DMG","")
 local label=make("TextLabel",panel,{Size=UDim2.new(1,0,0,42),BackgroundTransparency=1,Text="Ready",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3})
 local sideBtn=make("TextButton",panel,{Size=UDim2.new(1,0,0,28),BackgroundColor3=T.p2,Text="Side dash: D (right)",TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=11,LayoutOrder=4}); corner(sideBtn,6)
 connect(sideBtn.Activated,function()
  side=side==Enum.KeyCode.D and Enum.KeyCode.A or Enum.KeyCode.D
  sideBtn.Text=side==Enum.KeyCode.D and "Side dash: D (right)" or "Side dash: A (left)"
 end)
 local button=make("TextButton",panel,{Size=UDim2.new(1,0,0,30),BackgroundColor3=T.p2,Text="Play / Cancel Hyper King (H)",TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=12,LayoutOrder=5}); corner(button,6)

 local timing={
  punchGap=.60,
  clickHold=.035,
  startup=.08,
  afterThree=.30,
  downslamLead=.12,
  afterDownslam=.40,
  afterTwo=.40,
  afterOne=1.80,
  afterSecondDownslam=.40,
  dashHold=.10,
  afterDash=.25,
  blackFlashGap=.325,
 }
 local function releaseCombo()
  if okVIM and VIM then
   if heldKey then pcall(function() VIM:SendKeyEvent(false,heldKey,false,game) end) end
   if mouseHeld then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end
  end
  heldKey=nil; mouseHeld=false
 end
 local function cancel()
  token+=1; active=false; manualSequenceBusy=false; releaseCombo()
  if label.Parent then label.Text="Ready" end
 end
 local function toggleCombo()
  if active then cancel(); return end
  if busy or manualSequenceBusy then label.Text="Wait for the other macro to finish"; return end
  if not okVIM or not VIM then label.Text="Input simulation unavailable"; return end
  active=true; manualSequenceBusy=true; token+=1
  local id=token
  local chosenSide=side
  task.spawn(function()
   local function check()
    local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if not running or token~=id or not h or h.Health<=0 then error("Hyper King cancelled",0) end
   end
   local function waitFor(seconds)
    local finish=os.clock()+seconds
    repeat check(); task.wait() until os.clock()>=finish
    check()
   end
   local function click()
    check(); mouseHeld=true
    local cursor=UIS:GetMouseLocation()
    VIM:SendMouseButtonEvent(cursor.X,cursor.Y,0,true,game,0)
    waitFor(timing.clickHold or .05)
    VIM:SendMouseButtonEvent(cursor.X,cursor.Y,0,false,game,0); mouseHeld=false
   end
   local function key(code)
    check(); heldKey=code; VIM:SendKeyEvent(true,code,false,game)
    waitFor(.05)
    VIM:SendKeyEvent(false,code,false,game); heldKey=nil
   end
   local function threeM1()
    for i=1,3 do
     click()
     if i<3 then waitFor(timing.punchGap) end
    end
    waitFor(timing.afterThree)
   end
   local ok,err=pcall(function()
    label.Text="Hyper King: 3 M1"
    waitFor(timing.startup)
    threeM1()
    label.Text="Hyper King: Downslam"
    heldKey=Enum.KeyCode.Space
    VIM:SendKeyEvent(true,Enum.KeyCode.Space,false,game)
    local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.Jump=true end
    waitFor(timing.downslamLead)
    click()
    VIM:SendKeyEvent(false,Enum.KeyCode.Space,false,game)
    heldKey=nil
    waitFor(timing.afterDownslam)
    label.Text="Hyper King: Ability 2 Crushing Blow"
    key(Enum.KeyCode.Two)
    waitFor(timing.afterTwo)
    label.Text="Hyper King: Ability 1 Cursed Strikes (M1 reset)"
    key(Enum.KeyCode.One)
    waitFor(timing.afterOne)
    label.Text="Hyper King: Downslam"
    heldKey=Enum.KeyCode.Space
    VIM:SendKeyEvent(true,Enum.KeyCode.Space,false,game)
    local hum2=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum2 then hum2.Jump=true end
    waitFor(timing.downslamLead)
    click()
    VIM:SendKeyEvent(false,Enum.KeyCode.Space,false,game)
    heldKey=nil
    waitFor(timing.afterSecondDownslam)
    label.Text="Hyper King: Side dash behind"
    heldKey=chosenSide
    VIM:SendKeyEvent(true,chosenSide,false,game)
    VIM:SendKeyEvent(true,Enum.KeyCode.Q,false,game)
    waitFor(.035)
    VIM:SendKeyEvent(false,Enum.KeyCode.Q,false,game)
    if timing.dashHold>.035 then waitFor(timing.dashHold-.035) end
    VIM:SendKeyEvent(false,chosenSide,false,game)
    heldKey=nil
    waitFor(timing.afterDash)
    label.Text="Hyper King: Behind Black Flash (3+3)"
    local first=os.clock()
    key(Enum.KeyCode.Three)
    local remain=timing.blackFlashGap-(os.clock()-first)
    if remain>0 then waitFor(remain) end
    key(Enum.KeyCode.Three)
   end)
   if token==id then
    releaseCombo(); active=false; manualSequenceBusy=false
    if label.Parent then label.Text=ok and "Hyper King inputs sent" or tostring(err) end
   end
  end)
 end
 connect(button.Activated,toggleCombo)
 connect(UIS.InputBegan,function(input,processed)
  if processed or UIS:GetFocusedTextBox() then return end
  if input.KeyCode==Enum.KeyCode.H then toggleCombo() end
 end)
 connect(LP.CharacterRemoving,cancel)
 connect(gui.Destroying,cancel)
 connect(unload.Activated,cancel)

end)

;__JJSBoot:run("Follow Behind - Automatic Path Jumps",function()

 local PFS=game:GetService("PathfindingService")
