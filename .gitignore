 local action="JJSBlackflashV2Activate";local cameraBind,faceBind="JJSBlackflashV2Camera","JJSBlackflashV2Facing"
 local v2StartedAt=0;local V2_MAX_DURATION=8
 local box=card(pages.Macros,"Blackflash Chain V2","")
 local feedback=make("TextLabel",box,{Size=UDim2.new(1,0,0,64),BackgroundTransparency=1,Text="Off - enable V2 and press 3",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3});ord[box]=3
 local boxV3=card(pages.Macros,"Blackflash Chain V3","")
 local feedbackV3=make("TextLabel",boxV3,{Size=UDim2.new(1,0,0,64),BackgroundTransparency=1,Text="Off - enable V3 and press 3; V3 takes priority if both are enabled",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3});ord[boxV3]=3
 local calcBox=card(pages.Macros,"V2 / V3 Route Calculator","")
 local calcStatus=make("TextLabel",calcBox,{Size=UDim2.new(1,0,0,106),BackgroundTransparency=1,Text="Waiting for a live target",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=3});ord[calcBox]=3
 gui:SetAttribute("BlackflashChainV2Active",false);gui:SetAttribute("BlackflashChainV3Active",false)
 local start,bindCapture,stop,stopForDefeat
 local function enabledForRun() if runVersion==3 then return enabledV3 else return enabledV2 end end

 local function abilityCooldownActive()
  local pg=LP:FindFirstChild("PlayerGui")
  if not pg then return false end
  for _,d in ipairs(pg:GetDescendants()) do
   if d:IsA("GuiObject") and d.Visible then
    local n=string.lower(d.Name)
    if n:find("cooldown",1,true) or n:find("cdframe",1,true) or n:find("cd_",1,true) or n=="cd" then
     local parentName=d.Parent and string.lower(d.Parent.Name) or ""
     local grandName=d.Parent and d.Parent.Parent and string.lower(d.Parent.Parent.Name) or ""
     local ctx=parentName.." "..grandName.." "..n
     if ctx:find("skill",1,true) or ctx:find("ability",1,true) or ctx:find("hotbar",1,true) or ctx:find("slot",1,true) or ctx:find("move",1,true) or ctx:find("black",1,true) or ctx:find("3",1,true) or ctx:find("combat",1,true) then

      if d:IsA("ImageLabel") or d:IsA("Frame") or d:IsA("TextLabel") then
       if d:IsA("ImageLabel") and d.ImageTransparency>=.99 then

       else
        return true
       end
      end
     end
    end
   end
  end
  return false
 end
 local function setting(name)
  if runVersion==3 then return V3_FIXED[name] end
  if name=="Turn" then return postDashTurnDegrees elseif name=="CameraHold" then return cameraFlickHoldMs elseif name=="RepeatGap" then return repeatGapMs elseif name=="JumpLead" then return jumpLeadMs end
 end
 local function say(text) local label=runVersion==3 and feedbackV3 or feedback;if runVersion==3 then text=text:gsub("^V2","V3") end;if label.Parent and label.Text~=text then label.Text=text end end
 local function flat(v) return Vector3.new(v.X,0,v.Z) end
 local function rig() local c=LP.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local r=c and c:FindFirstChild("HumanoidRootPart");if h and r and h.Health>0 then return h,r end end
 local function typing() return UIS:GetFocusedTextBox()~=nil end
 local function invalidateCaches() targetCacheAt=-math.huge;targetCacheReady=false;cachedCandidate=nil;cachedRoot=nil;routeCache=nil;sharedParams=nil;paramsModel=nil;paramsCharacter=nil end
 local function sendKey(code,down) local ok,err=pcall(function() VIM:SendKeyEvent(down,code,false,game) end);if not ok then error(err,0) end end
 local function key(code,down)
  if down then if typing() then error(PAUSED_FOR_TYPING,0) end;if held[code] then return end;held[code]=true;if code==Enum.KeyCode.Three then suppressStartUntil=os.clock()+.1 end;sendKey(code,true)
  elseif held[code] then sendKey(code,false);held[code]=nil end
 end
 local function releaseInputs() for code in pairs(held) do pcall(function() sendKey(code,false) end) end;held={};if mouseDown then pcall(function() VIM:SendMouseButtonEvent(0,0,0,false,game,0) end) end;mouseDown=false end
 local function restoreLockOn() if borrowedLock then lockOn=previousLockOn;if lockOnPaint then lockOnPaint() end end;borrowedLock=false;lockSuppressed=false;mixFacing=Vector3.zero end
 local function restoreFacing() if ownedHumanoid and ownedHumanoid.Parent then ownedHumanoid.AutoRotate=previousAutoRotate end;ownedHumanoid=nil end
 local function move(mode,vector)
  if typing() then error(PAUSED_FOR_TYPING,0) end;phase=mode;steering=vector or Vector3.zero
  key(Enum.KeyCode.W,mode=="catchup" or mode=="attackApproach" or mode=="jumpOver")
  key(Enum.KeyCode.S,mode=="backMixup" or mode=="postJumpBackoff")
  local side=mode=="side";key(Enum.KeyCode.D,side and strafeKey==Enum.KeyCode.D);key(Enum.KeyCode.A,side and strafeKey==Enum.KeyCode.A)
