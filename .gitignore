 toggle(recovery,"Anti Ragdoll (local recovery attempt)",function() return antiRagdoll end,function(v) antiRagdoll=v end)
 note(recovery,"Attempts recovery from local Physics / PlatformStand / FallingDown / Ragdoll states only. Does not remove JJS server stun, constraints, or cooldowns.")
 local unavailable={
  {pages.Combat,"Remote Train Activation","Unavailable: verified train handler and arguments were not present in the provided implementation."},
  {pages.Movement,"Domain Invade","Unavailable: no verified domain entry implementation was provided."},
  {pages.Player,"Serversided Box Morph","Unavailable: no verified server-authorized morph handler was provided. No local morph is presented as server-sided."},
  {pages.Combat,"Auto Counter","Unavailable: character counter inputs, attack signals, and cooldown rules have not been verified."}
 }
 for _,entry in ipairs(unavailable) do
  local p=card(entry[1],entry[2],"");note(p,entry[3]);p:SetAttribute("FeatureStatus","Unavailable")
 end
 local accumulator=0
 connect(RS.Heartbeat,function(dt)
  if not alive then return end
  local permitted=focused and scriptsActive() and not gui:GetAttribute("FlingSequenceActive")
  local character=LP.Character
  local hum=character and character:FindFirstChildOfClass("Humanoid")
  local root=character and character:FindFirstChild("HumanoidRootPart")
  if fly and permitted and hum and hum.Health>0 and root and not root.Anchored then
   if flightRoot~=root then
    stopFlight();flightHum=hum;flightRoot=root;oldRotate=hum.AutoRotate;oldPlatform=hum.PlatformStand;hum.AutoRotate=false;hum.PlatformStand=true
    attachment=Instance.new("Attachment");attachment.Name="JJSFlyAttachment";attachment.Parent=root
    velocity=Instance.new("LinearVelocity");velocity.Name="JJSFlyVelocity";velocity.Attachment0=attachment;velocity.RelativeTo=Enum.ActuatorRelativeTo.World;velocity.MaxForce=math.max(root.AssemblyMass,1)*workspace.Gravity*40;velocity.VectorVelocity=Vector3.zero;velocity.Parent=root
    orientation=Instance.new("AlignOrientation");orientation.Name="JJSFlyOrientation";orientation.Attachment0=attachment;orientation.Mode=Enum.OrientationAlignmentMode.OneAttachment;orientation.MaxTorque=1000000;orientation.Responsiveness=20;orientation.Parent=root
   end
   local camera=workspace.CurrentCamera
   if camera then
    local direction=Vector3.zero
    local typing=UIS:GetFocusedTextBox()~=nil
    if not typing then
     if UIS.KeyboardEnabled then
      local x=(UIS:IsKeyDown(Enum.KeyCode.D) and 1 or 0)-(UIS:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
      local z=(UIS:IsKeyDown(Enum.KeyCode.W) and 1 or 0)-(UIS:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
      direction=camera.CFrame.RightVector*x+camera.CFrame.LookVector*z
     else direction=hum.MoveDirection end
     direction+=Vector3.yAxis*((up or UIS:IsKeyDown(Enum.KeyCode.Space)) and 1 or 0)
     direction-=Vector3.yAxis*((down or UIS:IsKeyDown(Enum.KeyCode.LeftControl)) and 1 or 0)
    end
    if direction.Magnitude>1 then direction=direction.Unit end
    velocity.VectorVelocity=direction*speed
    local look=Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z);if look.Magnitude>.01 then orientation.CFrame=CFrame.lookAt(Vector3.zero,look.Unit) end;root.AssemblyAngularVelocity=Vector3.zero
   else velocity.VectorVelocity=Vector3.zero end
  elseif flightRoot then stopFlight() end
  accumulator+=dt;if accumulator<.15 then return end;accumulator=0
  if permitted and not flightRoot and hum and hum.Health>0 then
   local state=hum:GetState()
   if antiStun and (hum.PlatformStand or state==Enum.HumanoidStateType.Physics) then hum.PlatformStand=false;hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
   if antiRagdoll and (state==Enum.HumanoidStateType.Ragdoll or state==Enum.HumanoidStateType.FallingDown) then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
  end
  if expand and permitted then
   local keep={}
   local myRoot=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
   for h in pairs(hitboxHumanoids) do
    local char=h.Parent
    if char and char~=LP.Character and char:IsDescendantOf(workspace) and h and h.Health>0 then
     local root=char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
     if root and root:IsA("BasePart") then
      local far=myRoot and (root.Position-myRoot.Position).Magnitude or 0
      if not myRoot or far<=250 then
       for _,part in ipairs(collectHitParts(char)) do
        keep[part]=true
        if not savedBoxes[part] then
         savedBoxes[part]={size=part.Size,transparency=part.Transparency,collide=part.CanCollide,massless=part.Massless,canQuery=part.CanQuery}
        end
        local target=Vector3.new(boxSize,boxSize,boxSize)
        -- Scale limbs a bit smaller than root so the silhouette stays readable
        local n=part.Name
        if n=="Head" then target=Vector3.new(boxSize*.55,boxSize*.55,boxSize*.55)
        elseif n:find("Arm",1,true) or n:find("Hand",1,true) then target=Vector3.new(boxSize*.4,boxSize*.7,boxSize*.4)
        elseif n=="UpperTorso" or n=="LowerTorso" or n=="Torso" then target=Vector3.new(boxSize*.85,boxSize*.7,boxSize*.5)
        end
        pcall(function()
         if (part.Size-target).Magnitude>.05 then part.Size=target end
         part.Transparency=.65
         part.CanCollide=false
         part.Massless=true
        end)
       end
      end
     end
    end
   end
   local stale={};for part in pairs(savedBoxes) do if not keep[part] then table.insert(stale,part) end end
   for _,part in ipairs(stale) do restoreBox(part) end
  else restoreBoxes() end
  -- Local punch-range expand on own character
  if punchExpand and permitted and character and hum and hum.Health>0 then
   local keep={}
   local names={"Left Arm","Right Arm","LeftArm","RightArm","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","Left Hand","Right Hand","LeftHand","RightHand","HumanoidRootPart"}
   for _,name in ipairs(names) do
    local part=character:FindFirstChild(name)
    if part and part:IsA("BasePart") then
     keep[part]=true
     if not savedPunch[part] then savedPunch[part]={size=part.Size,transparency=part.Transparency,massless=part.Massless} end
     local target
     if part.Name=="HumanoidRootPart" then
      target=Vector3.new(math.max(part.Size.X,punchSize*.55),math.max(part.Size.Y,punchSize*.55),math.max(part.Size.Z,punchSize*.55))
     else
      target=Vector3.new(punchSize*.45,punchSize,punchSize*.45)
     end
     pcall(function()
      if (part.Size-target).Magnitude>.05 then part.Size=target end
      part.Transparency=math.min(part.Transparency,.4)
      part.Massless=true
     end)
    end
   end
   local stale={};for part in pairs(savedPunch) do if not keep[part] then table.insert(stale,part) end end
   for _,part in ipairs(stale) do
    local o=savedPunch[part]
    if part.Parent and o then pcall(function() part.Size=o.size;part.Transparency=o.transparency;part.Massless=o.massless end) end
    savedPunch[part]=nil
   end
  elseif next(savedPunch) then
   for part,o in pairs(savedPunch) do
    if part.Parent and o then pcall(function() part.Size=o.size;part.Transparency=o.transparency;part.Massless=o.massless end) end
   end
   table.clear(savedPunch)
  end
 end)
 local function cleanup()
  if not alive then return end;alive=false;fly=false;expand=false;punchExpand=false;up=false;down=false;stopFlight();restoreBoxes()
  for part,o in pairs(savedPunch) do if part.Parent and o then pcall(function() part.Size=o.size;part.Transparency=o.transparency;part.Massless=o.massless end) end end
  table.clear(savedPunch)
 end
 connect(LP.CharacterRemoving,function() up=false;down=false;stopFlight();restoreBoxes() end)
 connect(gui.Destroying,cleanup);connect(unload.Activated,cleanup)
end)


;__JJSBoot:run("Advanced ESP and Experimental Range",function()
 local alive=true;local raw=__JJSBoot.rawMake
 local options={boxes=false,corners=false,skeleton=false,tracers=false,chams=false,items=false,reach=false};local maxDistance=1000;local range=12
 local records={};local tools={};local tags={}
 local screen=raw("ScreenGui",PG,{Name="JJSAdvancedESP",ResetOnSpawn=false,IgnoreGuiInset=true,DisplayOrder=995})
 local function note(p,text) return make("TextLabel",p,{Size=UDim2.new(1,0,0,64),Text=text,TextWrapped=true,BackgroundTransparency=1,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=nextOrder(p)+2}) end
 for _,e in ipairs({{"2D Boxes","boxes"},{"Corner Boxes","corners"},{"Skeleton ESP","skeleton"},{"Tracers","tracers"},{"Chams","chams"},{"Dropped Items ESP","items"}}) do
  local key=e[2];local p=card(pages.ESP,e[1],"");toggle(p,e[1],function() return options[key] end,function(v) options[key]=v end)
  if key=="items" then note(p,"Marks streamed-in Workspace Tools with Handles, excluding equipped tools. Non-Tool pickups need game-specific identification.") end
 end
 local config=card(pages.ESP,"Advanced ESP Distance","");moduleSlider(config,"Maximum distance",100,3000,maxDistance," studs",function() return maxDistance end,function(v) maxDistance=v end)
 local reachPanel=card(pages.Combat,"Range Expander (Local Preview)","")
 toggle(reachPanel,"Range preview",function() return options.reach end,function(v) options.reach=v end)
 moduleSlider(reachPanel,"Preview radius",3,40,range," studs",function() return range end,function(v) range=v end)
 note(reachPanel,"Local visualization of a reach radius around you (ground ring + vertical volume). Does not extend server hit detection or change attacks.")
 local ring=Instance.new("Part");ring.Name="JJSRangePreview";ring.Shape=Enum.PartType.Cylinder;ring.Anchored=true;ring.CanCollide=false;ring.CanTouch=false;ring.CanQuery=false;ring.Material=Enum.Material.ForceField;ring.Color=T.acc;ring.Transparency=.55;ring.CastShadow=false
 local volume=Instance.new("Part");volume.Name="JJSRangeVolume";volume.Shape=Enum.PartType.Cylinder;volume.Anchored=true;volume.CanCollide=false;volume.CanTouch=false;volume.CanQuery=false;volume.Material=Enum.Material.ForceField;volume.Color=T.acc;volume.Transparency=.85;volume.CastShadow=false
 local function segment(rec,n,a,b)
  local l=rec.lines[n]
  if not l then l=raw("Frame",rec.folder,{AnchorPoint=Vector2.new(.5,.5),BorderSizePixel=0,BackgroundColor3=T.acc});rec.lines[n]=l end
  local d=b-a;l.Position=UDim2.fromOffset((a.X+b.X)/2,(a.Y+b.Y)/2);l.Size=UDim2.fromOffset(d.Magnitude,1.5);l.Rotation=math.deg(math.atan2(d.Y,d.X));l.Visible=true
 end
 local function consider(o) if o:IsA("Tool") then tools[o]=true end end
 for _,o in ipairs(workspace:GetDescendants()) do consider(o) end
 connect(workspace.DescendantAdded,consider)
 connect(workspace.DescendantRemoving,function(o) tools[o]=nil;if tags[o] then tags[o]:Destroy();tags[o]=nil end end)
 connect(Players.PlayerRemoving,function(p) local r=records[p];if r then r.folder:Destroy();if r.highlight then r.highlight:Destroy() end;records[p]=nil end end)
 local elapsed=0
 connect(RS.RenderStepped,function(dt)
  if not alive then return end;elapsed+=dt;if elapsed<1/30 then return end;elapsed=0
  local camera=workspace.CurrentCamera;if not camera then return end
  local own=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart");local active=scriptsActive()
  if active and options.reach and own then
   -- Cylinder axis is local X: flat ground ring + upright volume
   local d=math.max(2,range*2)
   ring.Size=Vector3.new(0.12,d,d)
   ring.CFrame=CFrame.new(own.Position.X,own.Position.Y-2.6,own.Position.Z)*CFrame.Angles(0,0,math.pi/2)
   ring.Color=T.acc;ring.Parent=workspace
   volume.Size=Vector3.new(6,d,d)
   volume.CFrame=CFrame.new(own.Position)*CFrame.Angles(0,0,math.pi/2)
   volume.Color=T.acc;volume.Parent=workspace
  else ring.Parent=nil;volume.Parent=nil end
  local function project(v) local p,on=camera:WorldToViewportPoint(v);return Vector2.new(p.X,p.Y),on and p.Z>.1 end
  for _,player in ipairs(Players:GetPlayers()) do if player~=LP then
   local r=records[player]
   if not r then r={folder=raw("Folder",screen,{Name="ESP_"..player.UserId}),lines={}};records[player]=r end
   for _,l in ipairs(r.lines) do l.Visible=false end
   local c=player.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local root=c and c:FindFirstChild("HumanoidRootPart")
   local valid=active and own and root and h and h.Health>0 and (own.Position-root.Position).Magnitude<=maxDistance
   if r.character~=c then
    r.character=c;r.motors={};if r.highlight then r.highlight:Destroy();r.highlight=nil end
    if c then for _,o in ipairs(c:GetDescendants()) do if o:IsA("Motor6D") then table.insert(r.motors,o) end end end
   end
   if valid and options.chams then
    if not r.highlight then local t=Instance.new("Highlight");t.Name="JJSChams";t.Adornee=c;t.FillColor=T.acc;t.OutlineColor=T.txt;t.FillTransparency=.65;t.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop;t.Parent=screen;r.highlight=t end
    r.highlight.Enabled=true
   elseif r.highlight then r.highlight.Enabled=false end
   if valid then
    local n=0;local function draw(a,b) n+=1;segment(r,n,a,b) end
    if options.boxes or options.corners then
     local ok,cf,size=pcall(c.GetBoundingBox,c)
     if ok then
      local lo=Vector2.new(math.huge,math.huge);local hi=Vector2.new(-math.huge,-math.huge);local front=true;local any=false
      for x=-1,1,2 do for y=-1,1,2 do for z=-1,1,2 do
       local p,on=camera:WorldToViewportPoint(cf:PointToWorldSpace(Vector3.new(size.X*x,size.Y*y,size.Z*z)*.5))
       front=front and p.Z>.1;any=any or on;lo=Vector2.new(math.min(lo.X,p.X),math.min(lo.Y,p.Y));hi=Vector2.new(math.max(hi.X,p.X),math.max(hi.Y,p.Y))
      end end end
      if front and any then
       local a,b,c2,d=lo,Vector2.new(hi.X,lo.Y),hi,Vector2.new(lo.X,hi.Y)
       if options.boxes then draw(a,b);draw(b,c2);draw(c2,d);draw(d,a) end
       if options.corners then local w=(hi.X-lo.X)*.25;local hh=(hi.Y-lo.Y)*.25
        for _,v in ipairs({{a,w,hh},{b,-w,hh},{c2,-w,-hh},{d,w,-hh}}) do draw(v[1],v[1]+Vector2.new(v[2],0));draw(v[1],v[1]+Vector2.new(0,v[3])) end
       end
      end
     end
    end
    if options.tracers then local p,on=project(root.Position);if on then draw(Vector2.new(camera.ViewportSize.X/2,camera.ViewportSize.Y-10),p) end end
    if options.skeleton then for _,j in ipairs(r.motors) do
     local a,b=j.Part0,j.Part1
     if a and b and a:IsDescendantOf(c) and b:IsDescendantOf(c) and not a:FindFirstAncestorOfClass("Accessory") and not b:FindFirstAncestorOfClass("Accessory") then local p,on=project(a.Position);local q,visible=project(b.Position);if on and visible then draw(p,q) end end
    end end
   end
  end end
  for tool in pairs(tools) do
   local h=tool:FindFirstChild("Handle");local parent=tool.Parent
   local held=parent and parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid")
   local valid=active and options.items and own and h and h:IsA("BasePart") and tool:IsDescendantOf(workspace) and not held and (h.Position-own.Position).Magnitude<=maxDistance
   local tag=tags[tool]
   if valid then
    if not tag then tag=Instance.new("BillboardGui");tag.Name="JJSDroppedItem";tag.Size=UDim2.fromOffset(200,38);tag.StudsOffset=Vector3.new(0,1.5,0);tag.AlwaysOnTop=true;tag.Parent=screen;raw("TextLabel",tag,{Name="Label",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,TextColor3=T.acc,TextStrokeTransparency=.3,Font=Enum.Font.GothamBold,TextSize=12});tags[tool]=tag end
    tag.Adornee=h;tag.Enabled=true;tag.Label.Text=tool.Name.."  "..math.floor((h.Position-own.Position).Magnitude).." studs"
   elseif tag then tag.Enabled=false end
  end
 end)
 local function cleanup() if not alive then return end;alive=false;ring:Destroy();volume:Destroy();screen:Destroy();table.clear(records);table.clear(tools);table.clear(tags) end
 connect(gui.Destroying,cleanup);connect(unload.Activated,cleanup)
end)

;__JJSBoot:run("Combo Studio",function()
 local Http=game:GetService("HttpService");local p=card(pages.Macros,"Combo Studio","")
 local alive,recording,playing=true,false,false;local generation=0;local started=0;local events={};local held={};local recorded={};local library={}
 local allowed={W=true,A=true,S=true,D=true,Q=true,F=true,R=true,G=true,One=true,Two=true,Three=true,Four=true,Space=true,LeftControl=true,LeftShift=true}
 local function textBox(text,height)
  return make("TextBox",p,{Size=UDim2.new(1,0,0,height),Text=text,ClearTextOnFocus=false,BackgroundColor3=T.p2,TextColor3=T.txt,Font=Enum.Font.Code,TextSize=11,LayoutOrder=nextOrder(p)+2})
 end
 local name=textBox("Custom Combo",32);local editor=textBox("",160);editor.MultiLine=true;editor.TextWrapped=true;editor.TextXAlignment=Enum.TextXAlignment.Left;editor.TextYAlignment=Enum.TextYAlignment.Top
 local status=make("TextLabel",p,{Size=UDim2.new(1,0,0,72),Text="Keyboard / left-click recording. Disable other macros first. Practice templates are not verified true combos.",TextWrapped=true,BackgroundTransparency=1,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=nextOrder(p)+2})
 local function setBusy() gui:SetAttribute("ComboStudioBusy",recording or playing) end
 local function send(e)
  if e.kind=="key" then VIM:SendKeyEvent(e.down,Enum.KeyCode[e.code],false,game)
  else local pos=UIS:GetMouseLocation();local inset=game:GetService("GuiService"):GetGuiInset();VIM:SendMouseButtonEvent(pos.X-inset.X,pos.Y-inset.Y,0,e.down,game,0) end
  held[e.kind..":"..e.code]=e.down and e or nil
 end
 local function release()
  local list={};for _,e in pairs(held) do table.insert(list,{kind=e.kind,code=e.code,down=false}) end
  for _,e in ipairs(list) do pcall(send,e) end;table.clear(held)
 end
 local function stop()
  generation+=1
  if recording then for _,e in pairs(recorded) do if #events<2000 then table.insert(events,{t=math.min(os.clock()-started,120),kind=e.kind,code=e.code,down=false}) end end end
  recording=false;playing=false;table.clear(recorded);release();setBusy()
 end
 local function export() editor.Text=Http:JSONEncode({schema="JJSCombo",version=1,name=name.Text,events=events});return editor.Text end
 local function validate(text)
  assert(#text<=300000,"JSON exceeds size limit");local data=Http:JSONDecode(text)
  assert(type(data)=="table" and data.schema=="JJSCombo" and data.version==1 and type(data.events)=="table" and #data.events<=2000,"Unsupported combo schema or event count")
  local clean={};local last=-1
  for _,e in ipairs(data.events) do
   assert(type(e)=="table" and type(e.t)=="number" and e.t==e.t and e.t>=0 and e.t<=120 and e.t>=last,"Invalid timing (0-120 seconds, sorted)")
   assert(type(e.down)=="boolean" and ((e.kind=="key" and allowed[e.code]) or (e.kind=="mouse" and e.code=="MouseButton1")),"Unsupported input")
   table.insert(clean,{t=e.t,kind=e.kind,code=e.code,down=e.down});last=e.t
  end
  return clean,type(data.name)=="string" and data.name:sub(1,80) or "Imported Combo"
 end
 local function button(title,fn)
  local b=make("TextButton",p,{Size=UDim2.new(1,0,0,32),Text=title,BackgroundColor3=T.p2,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=12,LayoutOrder=nextOrder(p)+2});corner(b,5)
  connect(b.Activated,function() local ok,err=pcall(fn);if not ok then status.Text=tostring(err) end end)
 end
 button("Record (3 second countdown)",function()
  stop();events={};local id=generation;status.Text="Recording starts in 3 seconds. Close menu; Escape or Stop ends recording."
  task.spawn(function() task.wait(3);if alive and generation==id then recording=true;started=os.clock();setBusy();status.Text="Recording (120 seconds max)." end end)
 end)
 local function capture(i,down,processed)
  if not recording or UIS:GetFocusedTextBox() then return end
  if down and i.KeyCode==Enum.KeyCode.Escape then stop();export();return end
  local e
  if i.UserInputType==Enum.UserInputType.Keyboard and allowed[i.KeyCode.Name] then e={kind="key",code=i.KeyCode.Name}
  elseif i.UserInputType==Enum.UserInputType.MouseButton1 then e={kind="mouse",code="MouseButton1"} else return end
  local key=e.kind..":"..e.code
  if down and processed or not down and not recorded[key] then return end
  if #events>=1990 then stop();export();status.Text="Event limit reached.";return end
  e.down=down;e.t=math.min(os.clock()-started,120);table.insert(events,e);recorded[key]=down and e or nil
 end
 connect(UIS.InputBegan,function(i,g) capture(i,true,g);if playing and i.KeyCode==Enum.KeyCode.Escape then stop();status.Text="Replay cancelled." end end)
 connect(UIS.InputEnded,function(i,g) capture(i,false,g) end)
 button("Stop / Cancel",function() stop();export();status.Text="Stopped: "..#events.." events." end)
 button("Replay (3 second countdown)",function()
  assert(okVIM and VIM,"Input simulation unavailable");stop();local copy=validate(export());assert(#copy>0,"No events");local id=generation;playing=true;setBusy();status.Text="Replay starts in 3 seconds. Close menu; Escape cancels."
  task.spawn(function()
   task.wait(3);local start=os.clock()
   local ok,err=pcall(function() for _,e in ipairs(copy) do
    while alive and generation==id and os.clock()-start<e.t do RS.Heartbeat:Wait() end
    if not alive or generation~=id or not running then return end
    if UIS:GetFocusedTextBox() then error("Stopped for typing") end;send(e)
   end end)
   if generation==id then release();playing=false;setBusy();status.Text=ok and "Replay finished." or tostring(err) end
  end)
 end)
 button("Export JSON",function() stop();export();status.Text="JSON exported to editor." end)
 button("Import JSON",function() stop();local data,title=validate(editor.Text);events=data;name.Text=title;status.Text="Imported "..#events.." events." end)
 local function safeName() local n=name.Text:gsub("[^%w_%-]","_"):sub(1,64);assert(#n>0,"Enter a name");return n end
 button("Save (session + file if supported)",function()
  stop();local n=safeName();local text=export();library[n]=text
  if type(writefile)=="function" and type(makefolder)=="function" then pcall(makefolder,"JJSCombos");writefile("JJSCombos/"..n..".json",text);status.Text="Saved session + JSON file: "..n else status.Text="Saved session only. Copy JSON to preserve it; file APIs unavailable." end
 end)
 button("Load named custom combo",function()
  stop();local n=safeName();local text=library[n];if not text and type(readfile)=="function" then text=readfile("JJSCombos/"..n..".json") end
  assert(text,"No combo with this name");local data,title=validate(text);events=data;name.Text=title;editor.Text=text;status.Text="Loaded "..#events.." events."
 end)
 local preset=0
 button("Cycle / Load built-in preset",function()
  stop();preset=preset%3+1;events={};name.Text=({"Three M1 practice","M1 jump practice","Skill sequence practice"})[preset]
  local function add(t,kind,code) table.insert(events,{t=t,kind=kind,code=code,down=true});table.insert(events,{t=t+.05,kind=kind,code=code,down=false}) end
  if preset<3 then for i=0,2 do add(i*.6,"mouse","MouseButton1") end;if preset==2 then add(1.9,"key","Space");add(2.05,"mouse","MouseButton1") end
  else for i,k in ipairs({"One","Two","Three","Four"}) do add((i-1)*1.5,"key",k) end end
  export();status.Text="Loaded practice template: "..name.Text..". Not a verified character combo."
 end)
 connect(RS.Heartbeat,function() if recording and os.clock()-started>=120 then stop();export() end end)
 connect(UIS.WindowFocusReleased,stop);connect(LP.CharacterRemoving,stop)
 local function cleanup() if not alive then return end;alive=false;stop() end
 connect(gui.Destroying,cleanup);connect(unload.Activated,cleanup)
end)


;__JJSBoot:run("Triggerbot",function()
 local alive=true
 local on=false
 local range=10
 local fov=70
 local gap=.18
 local last=-math.huge
 local teamCheck=true
 local p=card(pages.Combat,"Triggerbot","")
 toggle(p,"Triggerbot",function() return on end,function(v) on=v end)
 moduleSlider(p,"Trigger range",3,25,range," studs",function() return range end,function(v) range=v end)
 moduleSlider(p,"Trigger FOV",20,180,fov," deg",function() return fov end,function(v) fov=v end)
 moduleSlider(p,"Click gap",50,500,math.floor(gap*1000+.5)," ms",function() return math.floor(gap*1000+.5) end,function(v) gap=v/1000 end)
 toggle(p,"Skip teammates",function() return teamCheck end,function(v) teamCheck=v end)
 make("TextLabel",p,{Size=UDim2.new(1,0,0,56),BackgroundTransparency=1,Text="Auto M1 when a living enemy is inside range and FOV. Local input only; no aimbot lock. Pauses with hub open, typing, or other macros.",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=nextOrder(p)+2})
 local function click()
  if not okVIM or not VIM then return false end
  local pos=UIS:GetMouseLocation()
  local inset=game:GetService("GuiService"):GetGuiInset()
  local x,y=pos.X-inset.X,pos.Y-inset.Y
  local ok1=pcall(function() VIM:SendMouseButtonEvent(x,y,0,true,game,0) end)
  task.delay(.03,function() pcall(function() if okVIM and VIM then VIM:SendMouseButtonEvent(x,y,0,false,game,0) end end) end)
  return ok1
 end
 local function enemyInFront()
  local char=LP.Character
  local hum=char and char:FindFirstChildOfClass("Humanoid")
  local root=char and char:FindFirstChild("HumanoidRootPart")
  local cam=workspace.CurrentCamera
  if not hum or hum.Health<=0 or not root or not cam then return false end
  local best,bestDist=nil,range
  for _,plr in ipairs(Players:GetPlayers()) do
   if plr~=LP then
    if teamCheck and not LP.Neutral and not plr.Neutral and LP.Team and LP.Team==plr.Team then
    else
     local c=plr.Character
     local h=c and c:FindFirstChildOfClass("Humanoid")
     local r=c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso"))
     if h and h.Health>0 and r then
      local offset=r.Position-root.Position
      local dist=offset.Magnitude
      if dist<=bestDist and dist>1.2 then
       local toTarget=offset.Unit
       local look=cam.CFrame.LookVector
       local ang=math.deg(math.acos(math.clamp(look:Dot(toTarget),-1,1)))
       if ang<=fov*.5 then best=r;bestDist=dist end
      end
     end
    end
   end
  end
  -- NPCs
  for _,m in ipairs(workspace:GetChildren()) do
   if m:IsA("Model") and m~=LP.Character then
    local h=m:FindFirstChildOfClass("Humanoid")
    local r=m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso")
    if h and h.Health>0 and r and not Players:GetPlayerFromCharacter(m) then
     local offset=r.Position-root.Position
     local dist=offset.Magnitude
     if dist<=bestDist and dist>1.2 then
      local toTarget=offset.Unit
      local look=cam.CFrame.LookVector
      local ang=math.deg(math.acos(math.clamp(look:Dot(toTarget),-1,1)))
      if ang<=fov*.5 then best=r;bestDist=dist end
     end
    end
   end
  end
  return best~=nil
 end
 connect(RS.Heartbeat,function()
  if not alive or not on or not scriptsActive() or main.Visible or UIS:GetFocusedTextBox() or busy or todoBusy or tripleJumpBusy or manualSequenceBusy then return end
  if gui:GetAttribute("ComboStudioBusy") or gui:GetAttribute("AutoParryHolding") then return end
  if os.clock()-last<gap then return end
  if enemyInFront() then
   if click() then last=os.clock() end
  end
 end)
 local function cleanup() alive=false;on=false end
 connect(gui.Destroying,cleanup);connect(unload.Activated,cleanup)
end)


;__JJSBoot:run("Dash HUD",function()
 local alive=true
 local enabled=true
 -- JJS community notes: forward/still dash ~6s CD; side/back ~2s CD
 local FRONT_CD,SIDE_CD=6,2
 local lastKind="—"
 local frontReadyAt,sideReadyAt=0,0
 local flashUntil={Front=0,Left=0,Right=0,Back=0}
 local counts={Front=0,Left=0,Right=0,Back=0}
 local layer=Instance.new("ScreenGui")
 layer.Name="JJSDashHUD"
 layer.ResetOnSpawn=false
 layer.IgnoreGuiInset=true
 layer.DisplayOrder=1002
 layer.Parent=PG
 local panel=Instance.new("Frame")
 panel.Name="DashHudPanel"
 panel.Size=UDim2.fromOffset(188,150)
 panel.Position=UDim2.new(1,-206,0,96)
 panel.BackgroundColor3=Color3.fromRGB(22,15,12)
 panel.BackgroundTransparency=.12
 panel.BorderSizePixel=0
 panel.Active=true
 panel.Parent=layer
 local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,10);corner.Parent=panel
 local stroke=Instance.new("UIStroke");stroke.Color=T.acc;stroke.Thickness=1;stroke.Parent=panel
 local title=Instance.new("TextLabel")
 title.BackgroundTransparency=1
 title.Size=UDim2.new(1,-12,0,18)
 title.Position=UDim2.fromOffset(8,6)
 title.Font=Enum.Font.GothamBold
 title.TextSize=12
 title.TextXAlignment=Enum.TextXAlignment.Left
 title.TextColor3=T.txt
 title.Text="Dash CD  (drag)"
 title.Parent=panel
 local lastLabel=Instance.new("TextLabel")
 lastLabel.BackgroundTransparency=1
 lastLabel.Size=UDim2.new(1,-12,0,14)
 lastLabel.Position=UDim2.fromOffset(8,24)
 lastLabel.Font=Enum.Font.Gotham
 lastLabel.TextSize=11
 lastLabel.TextXAlignment=Enum.TextXAlignment.Left
 lastLabel.TextColor3=T.dim
 lastLabel.Text="Last: —"
 lastLabel.Parent=panel
 -- Front cooldown row
 local frontRow=Instance.new("Frame");frontRow.Size=UDim2.new(1,-16,0,28);frontRow.Position=UDim2.fromOffset(8,42);frontRow.BackgroundColor3=T.p2;frontRow.BorderSizePixel=0;frontRow.Parent=panel
 local fc=Instance.new("UICorner");fc.CornerRadius=UDim.new(0,6);fc.Parent=frontRow
 local frontFill=Instance.new("Frame");frontFill.Size=UDim2.fromScale(1,1);frontFill.BackgroundColor3=T.acc;frontFill.BorderSizePixel=0;frontFill.Parent=frontRow
 local ffc=Instance.new("UICorner");ffc.CornerRadius=UDim.new(0,6);ffc.Parent=frontFill
 local frontText=Instance.new("TextLabel");frontText.BackgroundTransparency=1;frontText.Size=UDim2.fromScale(1,1);frontText.Font=Enum.Font.GothamBold;frontText.TextSize=12;frontText.TextColor3=T.txt;frontText.Text="Front  READY";frontText.Parent=frontRow
 -- Side cooldown row (Left/Right/Back share ~2s in JJS notes)
 local sideRow=Instance.new("Frame");sideRow.Size=UDim2.new(1,-16,0,28);sideRow.Position=UDim2.fromOffset(8,74);sideRow.BackgroundColor3=T.p2;sideRow.BorderSizePixel=0;sideRow.Parent=panel
 local sc=Instance.new("UICorner");sc.CornerRadius=UDim.new(0,6);sc.Parent=sideRow
 local sideFill=Instance.new("Frame");sideFill.Size=UDim2.fromScale(1,1);sideFill.BackgroundColor3=Color3.fromRGB(80,200,120);sideFill.BorderSizePixel=0;sideFill.Parent=sideRow
 local sfc=Instance.new("UICorner");sfc.CornerRadius=UDim.new(0,6);sfc.Parent=sideFill
 local sideText=Instance.new("TextLabel");sideText.BackgroundTransparency=1;sideText.Size=UDim2.fromScale(1,1);sideText.Font=Enum.Font.GothamBold;sideText.TextSize=12;sideText.TextColor3=T.txt;sideText.Text="Side  READY";sideText.Parent=sideRow
 local cells={}
 local order={{"Front",UDim2.fromOffset(8,108)},{"Left",UDim2.fromOffset(52,108)},{"Right",UDim2.fromOffset(96,108)},{"Back",UDim2.fromOffset(140,108)}}
 for _,entry in ipairs(order) do
  local name,pos=entry[1],entry[2]
  local b=Instance.new("TextLabel")
  b.Size=UDim2.fromOffset(40,22)
  b.Position=pos
  b.BackgroundColor3=T.p2
  b.TextColor3=T.dim
  b.Font=Enum.Font.GothamBold
  b.TextSize=10
  b.Text=name:sub(1,1)
  b.BorderSizePixel=0
  b.Parent=panel
  local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,5);c.Parent=b
  cells[name]=b
 end
 local dragging,dragStart,origin,touch=false,nil,nil,nil
 connect(panel.InputBegan,function(input)
  if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
   dragging=true;dragStart=input.Position;origin=panel.Position;touch=input
  end
 end)
 connect(UIS.InputChanged,function(input)
  if dragging and (input==touch or input.UserInputType==Enum.UserInputType.MouseMovement) then
   local d=input.Position-dragStart
   panel.Position=UDim2.new(origin.X.Scale,origin.X.Offset+d.X,origin.Y.Scale,origin.Y.Offset+d.Y)
  end
 end)
 connect(UIS.InputEnded,function(input) if input==touch then dragging=false;touch=nil end end)
 local function paint()
  local now=os.clock()
  local fLeft=math.max(0,frontReadyAt-now)
  local sLeft=math.max(0,sideReadyAt-now)
  if fLeft<=0 then
   frontFill.Size=UDim2.fromScale(1,1);frontText.Text="Front  READY ("..FRONT_CD.."s)";frontText.TextColor3=T.ok
  else
   frontFill.Size=UDim2.fromScale(math.clamp(1-fLeft/FRONT_CD,0,1),1)
   frontText.Text=string.format("Front  %.1fs",fLeft);frontText.TextColor3=T.txt
  end
  if sLeft<=0 then
   sideFill.Size=UDim2.fromScale(1,1);sideText.Text="Side  READY ("..SIDE_CD.."s)";sideText.TextColor3=T.ok
  else
   sideFill.Size=UDim2.fromScale(math.clamp(1-sLeft/SIDE_CD,0,1),1)
   sideText.Text=string.format("Side  %.1fs",sLeft);sideText.TextColor3=T.txt
  end
  for kind,cell in pairs(cells) do
   local hot=now<flashUntil[kind]
   cell.BackgroundColor3=hot and T.acc or T.p2
   cell.TextColor3=hot and Color3.fromRGB(28,14,6) or T.dim
  end
  lastLabel.Text="Last: "..lastKind
  layer.Enabled=enabled and hubUnlocked and __JJSBoot.ready
 end
 local function classifyDash()
  local char=LP.Character
  local hum=char and char:FindFirstChildOfClass("Humanoid")
  local root=char and char:FindFirstChild("HumanoidRootPart")
  if not hum or not root then return "Front" end
  local move=hum.MoveDirection
  if move.Magnitude<.08 then return "Front" end
  local look=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
  if look.Magnitude<.05 then return "Front" end
  look=look.Unit
  local flat=Vector3.new(move.X,0,move.Z)
  if flat.Magnitude<.05 then return "Front" end
  flat=flat.Unit
  local forward=look:Dot(flat)
  local right=look:Cross(Vector3.yAxis).Unit:Dot(flat)
  if forward>.55 then return "Front" end
  if forward<-.55 then return "Back" end
  if right>0 then return "Right" end
  return "Left"
 end
 local function noteDash()
  local kind=classifyDash()
  lastKind=kind
  counts[kind]=(counts[kind] or 0)+1
  flashUntil[kind]=os.clock()+.45
  local now=os.clock()
  if kind=="Front" then frontReadyAt=now+FRONT_CD else sideReadyAt=now+SIDE_CD end
  paint()
 end
 connect(UIS.InputBegan,function(input,g)
  if g or not alive then return end
  if input.KeyCode==Enum.KeyCode.Q then noteDash() end
 end)
 local lastVel=Vector3.zero
 connect(RS.Heartbeat,function()
  if not alive then return end
  paint()
  local char=LP.Character
  local root=char and char:FindFirstChild("HumanoidRootPart")
  if not root then return end
  local vel=root.AssemblyLinearVelocity
  local horizontal=Vector3.new(vel.X,0,vel.Z)
  local prev=Vector3.new(lastVel.X,0,lastVel.Z)
  lastVel=vel
  if horizontal.Magnitude>38 and (horizontal.Magnitude-prev.Magnitude)>28 then
   local recent=false
   local now=os.clock()
   for _,t in pairs(flashUntil) do if now<t then recent=true break end end
   if not recent then noteDash() end
  end
 end)
 local ui=card(pages.Visuals,"Dash HUD","")
 toggle(ui,"Show Dash HUD",function() return enabled end,function(v) enabled=v;paint() end)
 make("TextLabel",ui,{Size=UDim2.new(1,0,0,56),BackgroundTransparency=1,Text="Movable cooldown HUD. Front dash CD = 6s, Side/Back dash CD = 2s (JJS community estimates). Bars count down after Q / dash burst. Not server-synced.",TextWrapped=true,TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=nextOrder(ui)+2})
 local function cleanup()
  if not alive then return end
  alive=false
  if layer then layer:Destroy() end
 end
 connect(gui.Destroying,cleanup);connect(unload.Activated,cleanup)
end)




;__JJSBoot:run("Stun Status ESP",function()
 -- JJS: stun = upright action lock after hit (~0.75s on M1); ragdoll = knockdown/physics (separate from stun).
 -- Client-side only: Humanoid state + hit-reaction anim names. Not a server stun flag.
 local alive=true
 local on=false
 local maxDist=200
 local showSelf=false
 local teamSkip=true
 local raw=__JJSBoot.rawMake
 local screen=raw("ScreenGui",PG,{Name="JJSStunStatusESP",ResetOnSpawn=false,IgnoreGuiInset=true,DisplayOrder=996})
 local records={}
 local hitNames={"hitreaction","hitreact","hitstun","gethit","takinghit","receivedhit","hurt","flinch","stagger","stun","ragdoll","knockback","knockdown","landedhit","damage"}
 local function norm(s) return tostring(s or ""):lower():gsub("[^%w]","") end
 local function isHitAnim(track)
  if not track or not track.IsPlaying or track.Speed<=0 then return false end
  local names={track.Name}
  local anim=track.Animation
  if anim then table.insert(names,anim.Name) end
  for _,n0 in ipairs(names) do
   local n=norm(n0)
   for _,bad in ipairs(hitNames) do if n:find(bad,1,true) then return true end end
  end
  return false
 end
 local function isStunned(char,hum)
  if not hum or hum.Health<=0 then return false,"down" end
  local st=hum:GetState()
  if hum.PlatformStand then return true,"platform" end
  if st==Enum.HumanoidStateType.Ragdoll then return true,"ragdoll" end
  if st==Enum.HumanoidStateType.FallingDown then return true,"falling" end
  if st==Enum.HumanoidStateType.Physics then return true,"physics" end
  if st==Enum.HumanoidStateType.Dead then return false,"dead" end
  local animator=hum:FindFirstChildOfClass("Animator") or (char and char:FindFirstChildOfClass("Animator"))
  if animator then
   for _,t in ipairs(animator:GetPlayingAnimationTracks()) do
    if isHitAnim(t) then return true,"hitstun" end
   end
  end
  return false,"free"
 end
 local function ensure(player)
  local r=records[player]
  if r then return r end
  local folder=raw("Folder",screen,{Name="Stun_"..player.UserId})
  local box=raw("Frame",folder,{Name="Box",BackgroundTransparency=.72,BorderSizePixel=0,Visible=false})
  local stroke=Instance.new("UIStroke");stroke.Thickness=2;stroke.Parent=box
  local tag=raw("TextLabel",folder,{Name="Tag",BackgroundTransparency=1,Size=UDim2.fromOffset(90,16),Font=Enum.Font.GothamBold,TextSize=11,TextStrokeTransparency=.4,Visible=false,TextXAlignment=Enum.TextXAlignment.Center})
  r={folder=folder,box=box,stroke=stroke,tag=tag,character=nil}
  records[player]=r
  return r
 end
 local function clearPlayer(player)
  local r=records[player]
  if r then r.folder:Destroy();records[player]=nil end
 end
 local panel=card(pages.ESP,"Stun Status (Special)","")
 -- Special module chrome: blue outline frame
 local special=make("Frame",panel,{
  Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=Color3.fromRGB(18,28,48),
  BorderSizePixel=0,LayoutOrder=nextOrder(panel)+1
 })
 corner(special,8)
 local blue=Instance.new("UIStroke");blue.Name="SpecialBlueOutline";blue.Color=Color3.fromRGB(64,156,255);blue.Thickness=2.5;blue.Parent=special
 make("TextLabel",special,{
  Size=UDim2.new(1,-16,0,18),Position=UDim2.fromOffset(8,8),BackgroundTransparency=1,
  Text="SPECIAL MODULE",TextColor3=Color3.fromRGB(120,190,255),Font=Enum.Font.GothamBold,TextSize=11,
  TextXAlignment=Enum.TextXAlignment.Left
 })
 make("TextLabel",special,{
  Size=UDim2.new(1,-16,0,64),Position=UDim2.fromOffset(8,28),BackgroundTransparency=1,TextWrapped=true,
  Text="RED box = stunned or ragdolled (JJS: upright M1 stun ~0.75s, or ragdoll / physics / falling / hit-reaction anim). GREEN box = free to act. Client estimate only — not a server stun flag.",
  TextColor3=Color3.fromRGB(180,200,230),Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left
 })
 make("Frame",special,{Size=UDim2.new(1,0,0,8),BackgroundTransparency=1}) -- bottom pad
 toggle(panel,"Stun Status ESP",function() return on end,function(v) on=v;if not v then for _,r in pairs(records) do r.box.Visible=false;r.tag.Visible=false end end end)
 moduleSlider(panel,"Max distance",50,500,maxDist," studs",function() return maxDist end,function(v) maxDist=v end)
 toggle(panel,"Skip teammates",function() return teamSkip end,function(v) teamSkip=v end)
 toggle(panel,"Show self",function() return showSelf end,function(v) showSelf=v end)
 connect(Players.PlayerRemoving,clearPlayer)
 local elapsed=0
 connect(RS.RenderStepped,function(dt)
  if not alive then return end
  elapsed+=dt;if elapsed<1/30 then return end;elapsed=0
  local cam=workspace.CurrentCamera
  local own=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
  local active=on and scriptsActive()
  for _,player in ipairs(Players:GetPlayers()) do
   if player==LP and not showSelf then
    local r=records[player];if r then r.box.Visible=false;r.tag.Visible=false end
   else
    local skip=teamSkip and player~=LP and not LP.Neutral and not player.Neutral and LP.Team and LP.Team==player.Team
    local char=player.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    local root=char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
    local r=ensure(player)
    local ok=active and not skip and root and hum and hum.Health>0 and own and (root.Position-own.Position).Magnitude<=maxDist
    if not ok then r.box.Visible=false;r.tag.Visible=false
    else
     local stunned,reason=isStunned(char,hum)
     local color=stunned and Color3.fromRGB(220,48,48) or Color3.fromRGB(64,210,96)
     local label=stunned and ("STUN "..string.upper(tostring(reason))) or "FREE"
     -- Bounding box from character
     local cf,size
     local okbb,cf0,size0=pcall(function() return char:GetBoundingBox() end)
     if okbb and typeof(cf0)=="CFrame" then cf,size=cf0,size0 else cf,size=root.CFrame,Vector3.new(4,6,2) end
     local corners={}
     local hx,hy,hz=size.X*.5,size.Y*.5,size.Z*.5
     local any,minX,minY,maxX,maxY=false,math.huge,math.huge,-math.huge,-math.huge
     for _,ox in ipairs({-hx,hx}) do for _,oy in ipairs({-hy,hy}) do for _,oz in ipairs({-hz,hz}) do
      local p,onScreen=cam:WorldToViewportPoint(cf:PointToWorldSpace(Vector3.new(ox,oy,oz)))
      if p.Z>.1 then
       any=true
       minX=math.min(minX,p.X);minY=math.min(minY,p.Y);maxX=math.max(maxX,p.X);maxY=math.max(maxY,p.Y)
      end
     end end end
     if any then
      local pad=3
      r.box.Position=UDim2.fromOffset(minX-pad,minY-pad)
      r.box.Size=UDim2.fromOffset(math.max(8,maxX-minX+pad*2),math.max(8,maxY-minY+pad*2))
      r.box.BackgroundColor3=color
      r.stroke.Color=color
      r.box.Visible=true
      r.tag.Text=label
      r.tag.TextColor3=color
      r.tag.Position=UDim2.fromOffset((minX+maxX)*.5-45,minY-18)
      r.tag.Visible=true
     else r.box.Visible=false;r.tag.Visible=false end
    end
   end
  end
 end)
 local function cleanup()
  if not alive then return end;alive=false;on=false
  for _,r in pairs(records) do r.folder:Destroy() end
  table.clear(records)
  if screen then screen:Destroy() end
 end
 connect(gui.Destroying,cleanup);connect(unload.Activated,cleanup)
end)


-- Organize module cards inside each category page (stable LayoutOrder)
do
 local orderMap={
  Macros={"Follow-up","Todo macro","Copied sequence","Blackflash Chain V2","Blackflash Chain V3","V2 / V3 Route Calculator","Combo Studio"},
  Combat={"Auto Block / Auto Parry","Triggerbot","Hitbox Expander (Local Only)","Expand Punch Range (Local Only)","Range Expander (Local Preview)","Cursed Partners Blackflash","Fling Kill All","Remote Train Activation","Auto Counter"},
  Targeting={"Camera assist and pull"},
  Movement={"Fly","Follow Behind - Automatic Path Jumps","Speed","Build Speed","Jump Power","Loop Teleport Behind","Low Gravity - Local","Slow Spin","Domain Invade"},
  Player={"Invisible (Local Only)","Local Recovery","Player Scanner","Serversided Box Morph"},
  ESP={"Stun Status (Special)","Player ESP","Advanced ESP Distance","2D Boxes","Corner Boxes","Skeleton ESP","Skeleton Overlay","Tracers","Chams","Dropped Items ESP","Items and Non-player Dummies","Build Logic Visibility"},
  Visuals={"Dash HUD","Popups, voices and kill finisher","Decorative Background"},
  Animations={"Cosmetic Animation Previews"},
  Settings={"Session","v2.20 Device and Loading","Mobile compatibility","Device and Loading"},
 }
 local function organizePages()
  for pageName,order in pairs(orderMap) do
   local page=pages[pageName]
   if page then
    local rank={}
    for i,title in ipairs(order) do rank[title]=i end
    for _,child in ipairs(page:GetChildren()) do
     if child:IsA("Frame") and child.Name:find("Group_",1,true)==1 then
      local title=child.Name:gsub("^Group_","")
      local r=rank[title]
      if r then child.LayoutOrder=r
      else child.LayoutOrder=(child.LayoutOrder or 0)+500 end
     end
    end
   end
  end
 end
 organizePages()
 task.defer(organizePages)
end

applyResponsiveLayout()
end,function(e) return debug.traceback(tostring(e),2) end)
if not __okMain then warn("JJS HUB v2.20: "..tostring(__errMain)) end
__JJSBoot:finish(__okMain)
