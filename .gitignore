 end
 local function releasePositioning() phase="idle";steering=Vector3.zero;for _,code in ipairs(MOVE_KEYS) do key(code,false) end;key(Enum.KeyCode.Q,false) end
 local function disconnectFight() for _,c in ipairs(fightLinks) do c:Disconnect() end;fightLinks={};fightModel=nil;fightHumanoid=nil end
 stop=function(message)
  generation+=1;local owned=active;active=false

  releasePositioning();releaseInputs();disconnectFight();invalidateCaches()
  phase="idle";steering=Vector3.zero;targetRoot=nil
  flickUntil=0;flickRotation=nil;flickNavigationRight=Vector3.zero;needPostJumpBackoff=false
  frontSequenceArmed=false;frontSequenceModel=nil
  lockSuppressed=false;mixFacing=Vector3.zero;borrowedLock=false
  restoreFacing()
  local h,r=rig()
  if h then
   h.AutoRotate=true
   h:Move(Vector3.zero,false)
  end
  if r then

   local v=r.AssemblyLinearVelocity
   r.AssemblyLinearVelocity=Vector3.new(v.X,v.Y,v.Z)
   r.AssemblyAngularVelocity=Vector3.zero
  end
  bfAssistOff()
  v2StartedAt=0
