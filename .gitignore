-- JJS HUB v2.20: sequential initialization + device badge + inspected additions.
local __JJSBoot=(function()
 local b={done=0,failed=0,total=36,ready=false,screen=nil,label=nil,fill=nil}
 local Players=game:GetService("Players")
 local Input=game:GetService("UserInputService")
 local mobile=Input.TouchEnabled and not Input.KeyboardEnabled
 b.device=mobile and "MOBILE" or "PC"
 b.color=mobile and Color3.fromRGB(255,209,64) or Color3.fromRGB(65,160,255)
 function b:icon(parent,position,size)
  local icon=Instance.new("Frame");icon.Name="DeviceIcon";icon.BackgroundTransparency=1;icon.Position=position;icon.Size=UDim2.fromOffset(size,size);icon.Parent=parent
  local outline=Instance.new("Frame");outline.BackgroundColor3=self.color;outline.BorderSizePixel=0
  if self.device=="PC" then outline.Size=UDim2.new(1,0,.65,0);outline.Position=UDim2.new(0,0,.05,0)
  else outline.Size=UDim2.new(.6,0,.95,0);outline.Position=UDim2.new(.2,0,0,0) end
  outline.Parent=icon
  local radius=Instance.new("UICorner");radius.CornerRadius=UDim.new(0,3);radius.Parent=outline
  local inset=Instance.new("Frame");inset.Size=UDim2.new(1,-4,1,-5);inset.Position=UDim2.fromOffset(2,2);inset.BorderSizePixel=0;inset.BackgroundColor3=Color3.fromRGB(34,26,22);inset.Parent=outline
  if self.device=="PC" then
   local stand=Instance.new("Frame");stand.BackgroundColor3=self.color;stand.BorderSizePixel=0;stand.Size=UDim2.new(.14,0,.19,0);stand.Position=UDim2.new(.43,0,.7,0);stand.Parent=icon
   local foot=Instance.new("Frame");foot.BackgroundColor3=self.color;foot.BorderSizePixel=0;foot.Size=UDim2.new(.55,0,.09,0);foot.Position=UDim2.new(.225,0,.88,0);foot.Parent=icon
  end
  return icon
 end
 local player=Players.LocalPlayer
 local pg=player and (player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui",10))
 if pg then
  local old=pg:FindFirstChild("JJSLoadingScreen");if old then old:Destroy() end
  for _,name in ipairs({"JJSStartupStatus","JJSHubStartupDiagnostic"}) do local stale=pg:FindFirstChild(name);if stale then stale:Destroy() end end
  local screen=Instance.new("ScreenGui");screen.Name="JJSLoadingScreen";screen.IgnoreGuiInset=true;screen.ResetOnSpawn=false;screen.DisplayOrder=2147483647;b.screen=screen
  local dim=Instance.new("TextButton");dim.Name="InputShield";dim.Text="";dim.AutoButtonColor=false;dim.Size=UDim2.fromScale(1,1);dim.BackgroundColor3=Color3.fromRGB(10,7,6);dim.BackgroundTransparency=.15;dim.BorderSizePixel=0;dim.Modal=true;dim.Parent=screen
  local panel=Instance.new("Frame");panel.Size=UDim2.fromOffset(500,250);panel.AnchorPoint=Vector2.new(.5,.5);panel.Position=UDim2.fromScale(.5,.5);panel.BackgroundColor3=Color3.fromRGB(34,26,22);panel.BorderSizePixel=0;panel.Parent=dim
  local scale=Instance.new("UIScale");local camera=workspace.CurrentCamera;local viewport=camera and camera.ViewportSize or Vector2.new(760,540);scale.Scale=math.min(1,(viewport.X-30)/500,(viewport.Y-30)/250);scale.Parent=panel
  local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,12);corner.Parent=panel
  local stroke=Instance.new("UIStroke");stroke.Color=Color3.fromRGB(255,122,26);stroke.Thickness=1;stroke.Parent=panel
  local title=Instance.new("TextLabel");title.Size=UDim2.fromOffset(450,34);title.Position=UDim2.fromOffset(24,22);title.BackgroundTransparency=1;title.Font=Enum.Font.GothamBold;title.TextSize=22;title.TextColor3=Color3.fromRGB(255,242,224);title.TextXAlignment=Enum.TextXAlignment.Left;title.Text="JJS HUB  /  v2.20";title.Parent=panel
  b:icon(panel,UDim2.fromOffset(26,72),34)
  local device=Instance.new("TextLabel");device.Size=UDim2.fromOffset(390,32);device.Position=UDim2.fromOffset(74,74);device.BackgroundTransparency=1;device.Font=Enum.Font.GothamBold;device.TextSize=mobile and 18 or 15;device.TextColor3=b.color;device.TextXAlignment=Enum.TextXAlignment.Left;device.Text="Detected "..b.device.."  -  preparing modules";device.Parent=panel
  local label=Instance.new("TextLabel");label.Size=UDim2.fromOffset(450,48);label.Position=UDim2.fromOffset(24,120);label.BackgroundTransparency=1;label.Font=Enum.Font.Gotham;label.TextSize=mobile and 18 or 12;label.TextColor3=Color3.fromRGB(200,160,180);label.TextXAlignment=Enum.TextXAlignment.Left;label.TextWrapped=true;label.Text="Device checked. Initializing interface...";label.Parent=panel;b.label=label
  local bar=Instance.new("Frame");bar.Size=UDim2.fromOffset(450,8);bar.Position=UDim2.fromOffset(24,185);bar.BackgroundColor3=Color3.fromRGB(52,40,32);bar.BorderSizePixel=0;bar.Parent=panel
  local fill=Instance.new("Frame");fill.Size=UDim2.fromScale(0,1);fill.BackgroundColor3=Color3.fromRGB(255,138,40);fill.BorderSizePixel=0;fill.Parent=bar;b.fill=fill
  local foot=Instance.new("TextLabel");foot.Size=UDim2.fromOffset(450,24);foot.Position=UDim2.fromOffset(24,205);foot.BackgroundTransparency=1;foot.Font=Enum.Font.Gotham;foot.TextSize=10;foot.TextColor3=Color3.fromRGB(150,110,140);foot.Text="Sequential startup - optional features remain off";foot.Parent=panel;foot.Visible=not mobile
  screen.Parent=pg
 end
 function b:run(name,fn)
  if self.label and self.label.Parent then self.label.Text=string.format("Loading %d / %d: %s",self.done+1,self.total,name) end
  task.wait(.025)
  local ok,err=xpcall(fn,function(e) return tostring(e) end)
  if not ok then self.failed+=1;warn("JJS v2.20 ["..name.."]: "..tostring(err)) end
  self.done+=1
  if self.fill and self.fill.Parent then self.fill.Size=UDim2.fromScale(math.clamp(self.done/self.total,0,1),1) end
  task.wait(.025)
  return ok,err
 end
 function b:finish(ok)
  self.ready=ok and true or false
  if self.label and self.label.Parent then self.label.Text=ok and (self.failed==0 and "Ready. Opening hub..." or "Hub ready; "..self.failed.." component(s) unavailable. See console.") or "Startup incomplete. See console." end
  task.wait(.3)
  if self.screen then self.screen:Destroy();self.screen=nil;self.label=nil;self.fill=nil end
 end
 task.wait(.05)
 return b
end)()
local __okMain,__errMain=xpcall(function()
local fxShutdown,onBlackflashPair

local Players=game:GetService("Players")
local RS=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local LP=Players.LocalPlayer
assert(LP,"Client required")
local PG=LP:WaitForChild("PlayerGui")
local old=PG:FindFirstChild("JJS HUB") or PG:FindFirstChild("AutoBlackflash")
if old then old:Destroy() end
-- remove leftover backdrop from a previous session
local oldBg=PG:FindFirstChild("JJSHalloweenBackdrop")
if oldBg then oldBg:Destroy() end
local running=true
-- when the hub window is open (Visible), combat macros pause; when closed they resume
local scriptsPaused=false
local hubUnlocked=false -- set true after key gate (or saved key)
local function scriptsActive() return running and not scriptsPaused and hubUnlocked and __JJSBoot.ready end
local todoEnabled,todoBusy=false,false
local perfectClapEnabled=false
local clapState={generation=0,pending=false}
local perfectClapDelay=350
local tripleJumpEnabled=false
local tripleJumpBusy=false
local lockDistance=250
local pullStrength=10
local pullEnabled=false
local lockTargetMode="Torso"
local enabled,lockOn,includeNPC,chainEnabled=false,false,false,false
local chainRepeats=3
local chainCooldownUntil=0
local lastThreeTime=0
local delayMs,mode=325,"Single"
local busy=false
local manualSequenceBusy=false
local blackflashV2Trigger=nil
local bfAssistActive=false
local followSetEnabled=nil
local assistState={getFollow=nil,previous=nil}
local lockOnPaint=nil
local followPaint=nil
local conns={}
local function bfAssistOn()
 if bfAssistActive then return end
 assistState.previous={lock=lockOn,follow=assistState.getFollow and assistState.getFollow() or false}
 bfAssistActive=true;lockOn=true
 if lockOnPaint then lockOnPaint() end
 if followSetEnabled then followSetEnabled(true) end
 if followPaint then followPaint() end
end
local function bfAssistOff()
 if not bfAssistActive then return end
 bfAssistActive=false
 local previous=assistState.previous;assistState.previous=nil
 if previous then lockOn=previous.lock;if followSetEnabled then followSetEnabled(previous.follow) end end
 if lockOnPaint then lockOnPaint() end
 if followPaint then followPaint() end
end
local T={bg=Color3.fromRGB(12,12,16),panel=Color3.fromRGB(18,18,24),p2=Color3.fromRGB(24,24,32),card=Color3.fromRGB(22,22,30),stroke=Color3.fromRGB(40,40,55),acc=Color3.fromRGB(168,85,255),txt=Color3.fromRGB(235,235,245),dim=Color3.fromRGB(140,140,160),mut=Color3.fromRGB(90,90,110),ok=Color3.fromRGB(80,200,120),warn=Color3.fromRGB(255,190,90)}
local attachTooltip
local function make(class,parent,props)
 local o=Instance.new(class)
 local ok,err=pcall(function() for k,v in pairs(props or {}) do o[k]=v end;o.Parent=parent end)
 if not ok then o:Destroy();error("Cannot create "..class..": "..tostring(err),2) end
 if attachTooltip then pcall(attachTooltip,o) end
 return o
end
local function connect(signal,fn) local c=signal:Connect(fn); table.insert(conns,c); return c end
local function corner(o,r) make("UICorner",o,{CornerRadius=UDim.new(0,r or 8)}) end
local function stroke(o) make("UIStroke",o,{Color=T.stroke,Thickness=1}) end
-- ===== PART 1: Halloween palette =====
;__JJSBoot:run("Halloween theme",function()

 T.bg=Color3.fromRGB(20,16,14)          -- midnight black-purple window
 T.panel=Color3.fromRGB(34,26,22)      -- top bar and sidebar
 T.p2=Color3.fromRGB(52,40,32)         -- buttons, inputs, selected tab
 T.card=Color3.fromRGB(40,30,26)       -- module cards
 T.stroke=Color3.fromRGB(255,122,26)   -- pumpkin orange outlines
 T.acc=Color3.fromRGB(255,138,40)      -- accent (ON states, selected text)
 T.txt=Color3.fromRGB(255,242,224)     -- warm cream text
 T.dim=Color3.fromRGB(200,160,180)     -- unselected labels
 T.mut=Color3.fromRGB(150,110,140)     -- hints and descriptions
 T.ok=Color3.fromRGB(160,255,120)      -- slime green
