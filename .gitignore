do
 __JJSBoot.groups={};__JJSBoot.features={};__JJSBoot.cancels={};__JJSBoot.rawMake=make
 __JJSBoot.options={["Include NPCs"]=true,["Automatic Pathfinding Jumps"]=true,["Use Front / Side / Back Dashes"]=true,["Reset speed when stopped"]=true,["Include NPCs (shared V2/V3)"]=true,["Front-only turnaround S + Q (shared)"]=true,["Auto camera angle (override slider/fixed turn)"]=true,["Highlights"]=true,["Names"]=true,["Health"]=true,["Distance"]=true,["Hide teammates"]=true,["Through walls"]=true,["Skip teammates"]=true,["Reduced flashes"]=true,["Allow ESTIMATED lethal triggers"]=true}
 __JJSBoot.alias={["Triple Jump (3x LMB > 300ms > Jump > 50ms > LMB)"]="Triple Jump",["Auto Lock On"]="Lock On",["Enable ESP"]="Player ESP",["Follow Behind + Sprint"]="Follow Behind",["Low gravity"]="Low Gravity",["Show decorative background"]="Background",["Player skeletons"]="Skeleton ESP",["Show build markers"]="Build Logic Visibility",["Enable scanner"]="Player Scanner",["Kill finisher (16 frames / 0.8 s)"]="Kill Finisher"}
 function __JJSBoot.refresh(r)
  if not r.outer.Parent then return end
  local ok,v=pcall(r.get);r.button.Text=ok and v and "ON" or "OFF";r.button.TextColor3=ok and v and T.acc or T.dim;r.arrow.Text=r.open and "v" or ">"
  local camera=workspace.CurrentCamera;local v=camera and camera.ViewportSize or Vector2.new(760,540);local factor=math.max(.01,scale.Scale);local content=r.layout.AbsoluteContentSize.Y/factor+14
  local cap=UIS.TouchEnabled and math.clamp(v.Y*.28,96,180) or math.clamp(v.Y*.35,120,240);local page=r.outer.Parent and r.outer.Parent.Parent
  if page and page:IsA("ScrollingFrame") then cap=math.min(cap,math.max(44,page.AbsoluteSize.Y/factor-r.h-16)) end
  local h=math.min(cap,math.max(20,content));r.body.CanvasSize=UDim2.fromOffset(0,content);r.body.Size=UDim2.new(1,0,0,r.open and h or 0);r.outer.Size=UDim2.new(1,0,0,r.h+(r.open and h+4 or 0))
 end

 __JJSBoot.keyRecords={};local keyCapture=nil
 function __JJSBoot.addModuleKey(r,label)
  if not UIS.KeyboardEnabled or UIS.TouchEnabled then return end
  label.Size=UDim2.new(1,-186,0,r.h)
  local b=__JJSBoot.rawMake("TextButton",r.outer,{Name="ModuleKeybind",Size=UDim2.fromOffset(54,24),Position=UDim2.new(1,-170,0,(r.h-24)/2),Text="[ - ]",BackgroundColor3=T.p2,TextColor3=T.dim,Font=Enum.Font.GothamBold,TextSize=10,TextTruncate=Enum.TextTruncate.AtEnd});corner(b,5)
  local entry={row=r,box=b};table.insert(__JJSBoot.keyRecords,entry)
  function entry.paint() b.Text=entry.key and ("["..entry.key.Name.."]") or "[ - ]" end
  connect(b.Activated,function() if keyCapture then keyCapture.paint() end;keyCapture=entry;b.Text="[...]" end)
 end
 connect(UIS.InputBegan,function(i,g)
  if not UIS.KeyboardEnabled or UIS.TouchEnabled or i.UserInputType~=Enum.UserInputType.Keyboard or UIS:GetFocusedTextBox() then return end
  if keyCapture then local e=keyCapture;keyCapture=nil;local k=i.KeyCode
   if k==Enum.KeyCode.Escape then e.paint();return end
   if k==Enum.KeyCode.Backspace then e.key=nil;e.paint();return end
   if k==Enum.KeyCode.Unknown then e.paint();return end
   for _,o in ipairs(__JJSBoot.keyRecords) do if o.key==k then o.key=nil;o.paint() end end;e.key=k;e.paint();return
  end
  if g or not scriptsActive() or gui:GetAttribute("ComboStudioBusy") then return end
  for _,e in ipairs(__JJSBoot.keyRecords) do if e.key==i.KeyCode and e.row.outer.Parent then local ok,v=pcall(e.row.get);if ok then pcall(e.row.set,not v) end;__JJSBoot.refresh(e.row);return end end
 end)
 connect(UIS.WindowFocusReleased,function() if keyCapture then keyCapture.paint();keyCapture=nil end end)

 function __JJSBoot.bind(group,name,get,set)
  local g=__JJSBoot.groups[group];if not g then return end
  if g.rows[name] then local r=g.rows[name];r.get=get;r.set=set;return r end
  local raw=__JJSBoot.rawMake;local title=__JJSBoot.alias[name] or name;local h=UIS.TouchEnabled and 48 or 36;g.count+=1
  local outer=raw("Frame",group,{Name="Feature_"..title,Size=UDim2.new(1,0,0,h),BackgroundColor3=T.card,BorderSizePixel=0,LayoutOrder=g.count});corner(outer,7);stroke(outer)
  local label=raw("TextLabel",outer,{Size=UDim2.new(1,-124,0,h),Position=UDim2.fromOffset(8,0),Text=title.." =",TextTruncate=Enum.TextTruncate.AtEnd,BackgroundTransparency=1,TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=UIS.TouchEnabled and 13 or 12,TextXAlignment=Enum.TextXAlignment.Left});label:SetAttribute("Tooltip",title)
  local button=raw("TextButton",outer,{Size=UDim2.fromOffset(56,h-4),Position=UDim2.new(1,-108,0,2),Text="OFF",BackgroundColor3=T.p2,TextColor3=T.dim,Font=Enum.Font.GothamBold,TextSize=12});corner(button,6)
  local arrow=raw("TextButton",outer,{Size=UDim2.fromOffset(44,h-4),Position=UDim2.new(1,-48,0,2),Text=">",BackgroundColor3=T.p2,TextColor3=T.acc,Font=Enum.Font.GothamBold,TextSize=18});corner(arrow,6)
  local body,layout
  if not g.primary then body=g.pending;body.Parent=outer;layout=g.layout else body=raw("ScrollingFrame",outer,{Size=UDim2.new(1,0,0,0),BackgroundColor3=T.card,BorderSizePixel=0,Visible=false,CanvasSize=UDim2.new(),ScrollBarThickness=5,ScrollingDirection=Enum.ScrollingDirection.Y,ClipsDescendants=true});layout=raw("UIListLayout",body,{Padding=UDim.new(0,5),SortOrder=Enum.SortOrder.LayoutOrder});raw("UIPadding",body,{PaddingTop=UDim.new(0,6),PaddingBottom=UDim.new(0,8),PaddingLeft=UDim.new(0,9),PaddingRight=UDim.new(0,12)}) end
  body.Position=UDim2.fromOffset(0,h+4);body.Visible=false
  local r={outer=outer,body=body,layout=layout,button=button,arrow=arrow,h=h,open=false,get=get,set=set};g.rows[name]=r;g.rows[title]=r;g.current=r;if not g.primary then g.primary=r end;table.insert(__JJSBoot.features,r)
  __JJSBoot.addModuleKey(r,label)
  connect(button.Activated,function() local ok,v=pcall(r.get);if ok then local good,e=pcall(r.set,not v);if not good then warn("Module "..title..": "..tostring(e)) end end;__JJSBoot.refresh(r) end)
  connect(arrow.Activated,function() r.open=not r.open;r.body.Visible=r.open;if r.open then local any=false;for _,o in ipairs(body:GetChildren()) do if o:IsA("GuiObject") then any=true;break end end;if not any then raw("TextLabel",body,{Size=UDim2.new(1,0,0,30),Text="No additional settings.",BackgroundTransparency=1,TextColor3=T.mut,TextSize=12,Font=Enum.Font.Gotham}) end end;__JJSBoot.refresh(r);task.defer(function() __JJSBoot.refresh(r) end) end)
  connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"),function() __JJSBoot.refresh(r) end);__JJSBoot.refresh(r);return r
 end
 function __JJSBoot.settings(group,name) local g=__JJSBoot.groups[group];if not g then return group end;local r=name and g.rows[name] or g.current or g.primary;return r and r.body or g.pending end
 function __JJSBoot.route(class,parent,props)
  if __JJSBoot.groups[parent] and (class=="Frame" or class=="TextLabel" or class=="TextButton" or class=="TextBox" or class=="ImageLabel" or class=="ImageButton" or class=="ScrollingFrame") then
   local text=props and props.Text;if typeof(text)=="string" and text:find("Key action:",1,true) then return __JJSBoot.settings(parent,"Auto Blackflash") elseif typeof(text)=="string" and text:find("Target mode:",1,true) then return __JJSBoot.settings(parent,"Auto Lock On") elseif typeof(text)=="string" and text:find("PREVIEW POPUP",1,true) then return __JJSBoot.settings(parent,"Blackflash popups") end;return __JJSBoot.settings(parent)
  end;return parent
 end
 make=function(class,parent,props)
  parent=__JJSBoot.route(class,parent,props)
  if UIS.TouchEnabled and props then
   if class=="TextButton" or class=="TextBox" then local z=props.Size;if z and z.Y.Scale==0 and z.Y.Offset>0 and z.Y.Offset<44 then props.Size=UDim2.new(z.X.Scale,z.X.Offset,0,44) end end
   if (class=="TextLabel" or class=="TextButton" or class=="TextBox") and props.TextSize then props.TextSize=math.max(12,props.TextSize) end
   if (class=="TextButton" or class=="TextBox") and parent and parent:IsA("Frame") and parent.AutomaticSize==Enum.AutomaticSize.None and parent.Size.Y.Scale==0 and parent.Size.Y.Offset>0 then local z=props.Size;local p=props.Position or UDim2.new();if z and z.Y.Scale==0 and p.Y.Scale==0 and p.Y.Offset+z.Y.Offset>parent.Size.Y.Offset then parent.Size=UDim2.new(parent.Size.X.Scale,parent.Size.X.Offset,0,p.Y.Offset+z.Y.Offset) end end
  end
  return __JJSBoot.rawMake(class,parent,props)
 end
 local elapsed=0;connect(RS.Heartbeat,function(dt) elapsed+=dt;if elapsed<.2 then return end;elapsed=0;for _,r in ipairs(__JJSBoot.features) do __JJSBoot.refresh(r) end end)
end
local function card(p,name,sub)
 if name:find("Device and Loading",1,true) and __JJSBoot.interfaceGroup then return __JJSBoot.interfaceGroup end
 local raw=__JJSBoot.rawMake;local group=raw("Frame",p,{Name="Group_"..name,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,BorderSizePixel=0,LayoutOrder=nextOrder(p)});raw("UIListLayout",group,{Padding=UDim.new(0,5),SortOrder=Enum.SortOrder.LayoutOrder})
 local pending=raw("ScrollingFrame",group,{Size=UDim2.new(1,0,0,0),BackgroundColor3=T.card,BorderSizePixel=0,Visible=false,CanvasSize=UDim2.new(),ScrollBarThickness=5,ScrollingDirection=Enum.ScrollingDirection.Y,ClipsDescendants=true});local layout=raw("UIListLayout",pending,{Padding=UDim.new(0,5),SortOrder=Enum.SortOrder.LayoutOrder});raw("UIPadding",pending,{PaddingTop=UDim.new(0,6),PaddingBottom=UDim.new(0,8),PaddingLeft=UDim.new(0,9),PaddingRight=UDim.new(0,12)})
 __JJSBoot.groups[group]={title=name,pending=pending,layout=layout,rows={},primary=nil,current=nil,count=0};if name=="Session" then __JJSBoot.interfaceGroup=group end;return group
end
local function toggle(p,name,get,set)
 if __JJSBoot.groups[p] and not __JJSBoot.options[name] then local r=__JJSBoot.bind(p,name,get,set);return function() __JJSBoot.refresh(r) end end
 local r=make("TextButton",p,{Size=UDim2.new(1,0,0,UIS.TouchEnabled and 48 or 40),BackgroundTransparency=1,Text="",LayoutOrder=nextOrder(p)+2})
 r:SetAttribute("Tooltip",tooltipDescriptions[name] or ("Toggle "..name.." on or off."))
 attachTooltip(r)
 make("TextLabel",r,{Size=UDim2.new(1,-50,1,0),BackgroundTransparency=1,Text=name,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=UIS.TouchEnabled and 14 or 12,TextXAlignment=Enum.TextXAlignment.Left})
 local track=make("Frame",r,{Size=UIS.TouchEnabled and UDim2.fromOffset(44,24) or UDim2.fromOffset(36,18),Position=UIS.TouchEnabled and UDim2.new(1,-44,.5,-12) or UDim2.new(1,-36,.5,-9),BackgroundColor3=T.p2,BorderSizePixel=0}); corner(track,9)
 local knob=make("Frame",track,{Size=UIS.TouchEnabled and UDim2.fromOffset(18,18) or UDim2.fromOffset(14,14),Position=UDim2.new(0,2,.5,UIS.TouchEnabled and -9 or -7),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0}); corner(knob,7)
 local function paint() track.BackgroundColor3=get() and T.acc or Color3.fromRGB(45,45,55); knob.Position=get() and UDim2.new(1,UIS.TouchEnabled and -20 or -16,.5,UIS.TouchEnabled and -9 or -7) or UDim2.new(0,2,.5,UIS.TouchEnabled and -9 or -7) end
 connect(r.Activated,function() set(not get()); paint() end); paint()
 return paint
end
-- ===== card depth: every module card gets an outer shadow and a lit top edge =====
local __baseCard=card -- compact rows provide styling

local c=card(pages.Macros,"Follow-up","")
toggle(c,"Auto Blackflash",function() return enabled end,function(v) enabled=v end)
local function moduleSlider(parent,name,min,max,initial,suffix,get,set)
 if __JJSBoot.groups[parent] then parent=__JJSBoot.settings(parent,name=="Clap delay" and "Perfect Clap" or nil) end
 local r=make("Frame",parent,{Size=UDim2.new(1,0,0,UIS.TouchEnabled and 76 or 52),BackgroundTransparency=1,LayoutOrder=nextOrder(parent)+2})
 r:SetAttribute("Tooltip",tooltipDescriptions[name] or ("Adjust "..name.." using the slider."))
 attachTooltip(r)
 make("TextLabel",r,{Size=UDim2.new(.7,0,0,14),BackgroundTransparency=1,Text=name,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left})
 local value=make("TextLabel",r,{Size=UDim2.new(.3,0,0,14),Position=UDim2.fromScale(.7,0),BackgroundTransparency=1,Text=tostring(get())..suffix,TextColor3=T.acc,Font=Enum.Font.GothamBold,TextSize=11,TextXAlignment=Enum.TextXAlignment.Right})
 local bar=make("TextButton",r,{Size=UDim2.new(1,0,0,UIS.TouchEnabled and 44 or 20),Position=UDim2.fromOffset(0,26),BackgroundColor3=Color3.fromRGB(40,40,52),BorderSizePixel=0,Text=""}); corner(bar,4)
 local fill=make("Frame",bar,{Size=UDim2.new((get()-min)/(max-min),0,1,0),BackgroundColor3=T.acc,BorderSizePixel=0}); corner(fill,4)
 local sliding=false;local activePointer=nil
 local function update(x)
  local a=math.clamp((x-bar.AbsolutePosition.X)/math.max(bar.AbsoluteSize.X,1),0,1)
  local v=math.floor(min+(max-min)*a+.5)
  set(v)
  fill.Size=UDim2.new(a,0,1,0)
  value.Text=tostring(v)..suffix
 end
 connect(bar.InputBegan,function(i)
  if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then sliding=true;activePointer=i;if r.Parent:IsA("ScrollingFrame") then r.Parent.ScrollingEnabled=false end;update(i.Position.X) end
 end)
 connect(UIS.InputChanged,function(i)
  if sliding and (i==activePointer or activePointer and activePointer.UserInputType==Enum.UserInputType.MouseButton1 and i.UserInputType==Enum.UserInputType.MouseMovement) then update(i.Position.X) end
 end)
 connect(UIS.WindowFocusReleased,function() sliding=false;activePointer=nil;if r.Parent and r.Parent:IsA("ScrollingFrame") then r.Parent.ScrollingEnabled=true end end)
 connect(main:GetPropertyChangedSignal("Visible"),function() sliding=false;activePointer=nil;if r.Parent and r.Parent:IsA("ScrollingFrame") then r.Parent.ScrollingEnabled=true end end)
 connect(UIS.InputEnded,function(i)
  if i==activePointer then sliding=false;activePointer=nil;if r.Parent and r.Parent:IsA("ScrollingFrame") then r.Parent.ScrollingEnabled=true end end
 end)
end
toggle(c,"Triple Jump (3x LMB > 300ms > Jump > 50ms > LMB)",function() return tripleJumpEnabled end,function(v) tripleJumpEnabled=v end)
local modes={"Single","Double","Triple","Hold"}
local modeBtn=make("TextButton",c,{Size=UDim2.new(1,0,0,28),BackgroundColor3=T.p2,Text="Key action: Single",TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=11,LayoutOrder=nextOrder(c)+2}); corner(modeBtn,6)
connect(modeBtn.Activated,function() mode=modes[(table.find(modes,mode)%#modes)+1]; modeBtn.Text="Key action: "..mode end)
local cc=card(pages.Macros,"Copied sequence","")
toggle(cc,"Auto Blackflash Chain",function() return chainEnabled end,function(v) chainEnabled=v end)
local lc=card(pages.Targeting,"Camera assist and pull","")
lockOnPaint=toggle(lc,"Auto Lock On",function() return lockOn end,function(v) lockOn=v end)
toggle(lc,"Include NPCs",function() return includeNPC end,function(v) includeNPC=v end)
toggle(lc,"Pull To Target",function() return pullEnabled end,function(v) pullEnabled=v end)
local lockModes={"Torso","Back"}
local lockModeBtn=make("TextButton",lc,{Size=UDim2.new(1,0,0,28),BackgroundColor3=T.p2,Text="Target mode: "..lockTargetMode,TextColor3=T.txt,Font=Enum.Font.GothamBold,TextSize=11,LayoutOrder=nextOrder(lc)+2}); corner(lockModeBtn,6)
connect(lockModeBtn.Activated,function()
 local i=table.find(lockModes,lockTargetMode) or 1
 lockTargetMode=lockModes[(i%#lockModes)+1]
 lockModeBtn.Text="Target mode: "..lockTargetMode
end)
local function lockSlider(name,min,max,initial,suffix,get,set)
 local r=make("Frame",__JJSBoot.settings(lc,name=="Pull Strength" and "Pull To Target" or "Auto Lock On"),{Size=UDim2.new(1,0,0,UIS.TouchEnabled and 76 or 44),BackgroundTransparency=1,LayoutOrder=nextOrder(lc)+2})
 r:SetAttribute("Tooltip",tooltipDescriptions[name] or ("Adjust "..name.." using the slider."))
 attachTooltip(r)
 make("TextLabel",r,{Size=UDim2.new(.7,0,0,14),BackgroundTransparency=1,Text=name,TextColor3=T.txt,Font=Enum.Font.Gotham,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left})
 local value=make("TextLabel",r,{Size=UDim2.new(.3,0,0,14),Position=UDim2.fromScale(.7,0),BackgroundTransparency=1,Text=tostring(get())..suffix,TextColor3=T.acc,Font=Enum.Font.GothamBold,TextSize=11,TextXAlignment=Enum.TextXAlignment.Right})
 local bar=make("TextButton",r,{Size=UDim2.new(1,0,0,UIS.TouchEnabled and 44 or 14),Position=UDim2.fromOffset(0,22),BackgroundColor3=Color3.fromRGB(40,40,52),BorderSizePixel=0,Text=""}); corner(bar,4)
 local fill=make("Frame",bar,{Size=UDim2.new((get()-min)/(max-min),0,1,0),BackgroundColor3=T.acc,BorderSizePixel=0}); corner(fill,4)
 local sliding=false;local activePointer=nil
 local function update(x)
  local a=math.clamp((x-bar.AbsolutePosition.X)/math.max(bar.AbsoluteSize.X,1),0,1)
  local v=math.floor(min+(max-min)*a+.5)
  set(v)
  fill.Size=UDim2.new(a,0,1,0)
  value.Text=tostring(v)..suffix
 end
 connect(bar.InputBegan,function(i)
  if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then sliding=true;activePointer=i;if r.Parent:IsA("ScrollingFrame") then r.Parent.ScrollingEnabled=false end;update(i.Position.X) end
 end)
 connect(UIS.InputChanged,function(i)
  if sliding and (i==activePointer or activePointer and activePointer.UserInputType==Enum.UserInputType.MouseButton1 and i.UserInputType==Enum.UserInputType.MouseMovement) then update(i.Position.X) end
 end)
 connect(UIS.WindowFocusReleased,function() sliding=false;activePointer=nil;if r.Parent and r.Parent:IsA("ScrollingFrame") then r.Parent.ScrollingEnabled=true end end)
 connect(main:GetPropertyChangedSignal("Visible"),function() sliding=false;activePointer=nil;if r.Parent and r.Parent:IsA("ScrollingFrame") then r.Parent.ScrollingEnabled=true end end)
 connect(UIS.InputEnded,function(i)
  if i==activePointer then sliding=false;activePointer=nil;if r.Parent and r.Parent:IsA("ScrollingFrame") then r.Parent.ScrollingEnabled=true end end
 end)
end
lockSlider("Lock Distance",10,500,lockDistance," studs",function() return lockDistance end,function(v) lockDistance=v end)
lockSlider("Pull Strength",1,100,pullStrength,"",function() return pullStrength end,function(v) pullStrength=v end)
local tc=card(pages.Macros,"Todo macro","")
toggle(tc,"Todo Macro",function() return todoEnabled end,function(v) todoEnabled=v end)
local todoStatus=make("TextLabel",tc,{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,Text="Ready",TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=nextOrder(tc)+2})
toggle(tc,"Perfect Clap",function() return perfectClapEnabled end,function(v) perfectClapEnabled=v;clapState.generation+=1;clapState.pending=false end)
moduleSlider(tc,"Clap delay",50,1000,perfectClapDelay," ms",function() return perfectClapDelay end,function(v) perfectClapDelay=v end)
local sc=card(pages.Settings,"Session","")
__JJSBoot.bind(sc,"Tooltips",function() return tooltipLayer.Enabled end,function(v) tooltipLayer.Enabled=v;if not v then hideTooltip() end end)
local status=make("TextLabel",sc,{Size=UDim2.new(1,0,0,36),BackgroundTransparency=1,Text="Hub running. Unload stops all macros, ESP, HUD overlays, and destroys this UI.",TextColor3=T.dim,Font=Enum.Font.Gotham,TextSize=11,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=3})
local unload=make("TextButton",sc,{Size=UDim2.new(1,0,0,44),BackgroundColor3=Color3.fromRGB(130,45,65),Text="Unload Hub",TextColor3=Color3.new(1,1,1),Font=Enum.Font.GothamBold,TextSize=14,LayoutOrder=4}); corner(unload,8)
unload:SetAttribute("Tooltip","Fully stops JJS HUB: macros, ESP, dash HUD, connections, and GUI.")
make("TextLabel",sc,{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,Text="Also available as Unload on the top bar.",TextColor3=T.mut,Font=Enum.Font.Gotham,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=5})
local okVIM,VIM=pcall(function() return game:GetService("VirtualInputManager") end)
local function todoWait(seconds)
 local finish=os.clock()+seconds
 while running and todoEnabled and os.clock()<finish do task.wait() end
 return running and todoEnabled
end
local function todoKey(key)
 assert(okVIM and VIM,"Input simulation unavailable")
 VIM:SendKeyEvent(true,key,false,game)
 task.wait(.035)
 VIM:SendKeyEvent(false,key,false,game)
end
local function runTodo()
 if todoBusy or busy or manualSequenceBusy or UIS:GetFocusedTextBox() or not scriptsActive() or not todoEnabled then return end
 todoBusy=true; busy=true
 local ok,err=pcall(function()
  if not todoWait(.8) then return end
  todoKey(Enum.KeyCode.R)
  if not todoWait(.1) then return end
  todoKey(Enum.KeyCode.Two)
  if not todoWait(.65) then return end
  todoKey(Enum.KeyCode.Two)
 end)
 todoBusy=false; busy=false
 if running then
  todoStatus.Text=ok and (todoEnabled and "Sequence finished" or "Cancelled") or tostring(err)
  todoStatus.TextColor3=ok and T.dim or T.warn
 end
end
local keyHeld=false
local function release() if keyHeld and okVIM then pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.Three,false,game) end) end; keyHeld=false end
local function send(duration)
 assert(okVIM and VIM,"Input simulation unavailable")
 keyHeld=true; VIM:SendKeyEvent(true,Enum.KeyCode.Three,false,game)
 local untilTime=os.clock()+duration
 while scriptsActive() and enabled and os.clock()<untilTime do task.wait() end
 release()
end
local function run()
 if busy or not enabled or not scriptsActive() then return end
 busy=true
 local ms,action=delayMs,mode
 local ok,err=pcall(function()
  task.wait(ms/1000)
  if not scriptsActive() or not enabled then return end
  local count=action=="Triple" and 3 or action=="Double" and 2 or 1
  for i=1,count do
   if not enabled or not scriptsActive() then break end
   send(action=="Hold" and ms/1000 or .035)
   if i<count then task.wait(.08) end
  end
 end)
 release(); busy=false
 if running then status.Text=ok and "Sequence finished" or tostring(err) end
end
local function chainActive() return scriptsActive() and chainEnabled end
local function chainWait(seconds)
 local finish=os.clock()+seconds
 while chainActive() and os.clock()<finish do task.wait() end
 return chainActive()
end
local function chainClickLMB()
 if not chainActive() then return false end
 assert(okVIM and VIM,"Input simulation unavailable")
 VIM:SendMouseButtonEvent(0,0,0,true,game,0)
 chainWait(.035)
 VIM:SendMouseButtonEvent(0,0,0,false,game,0)
 return chainActive()
end
local function chainPress3()
 if not chainActive() then return false end
 send(.035)
 return chainActive()
end
local function runChain()
 if busy or not chainActive() then return end
 busy=true
 local ok,err=pcall(function()
  for i=1,chainRepeats do
   if not chainActive() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(.65) then break end
   if not chainClickLMB() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(.65) then break end
   if not chainClickLMB() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if not chainWait(delayMs/1000) then break end
   if not chainPress3() then break end
   if i%2==0 and i<chainRepeats then
    chainCooldownUntil=os.clock()+5
    busy=false
    return
   end
  end
 end)
 release()
 busy=false
 if running then status.Text=ok and "Copied Auto Blackflash sequence finished" or tostring(err) end
end
local humanoids={}
local function track(o) if o:IsA("Humanoid") then humanoids[o]=true end end
connect(workspace.DescendantAdded,track)
connect(workspace.DescendantRemoving,function(o) humanoids[o]=nil end)
for _,o in ipairs(workspace:GetDescendants()) do track(o) end
local function target()
 local char=LP.Character; local root=char and char:FindFirstChild("HumanoidRootPart")
 if not root then return nil,nil end
 local best,distance=nil,lockDistance
 local bestModel=nil
 for hum in pairs(humanoids) do
  local model=hum.Parent
  if model and model:IsA("Model") and model~=char and hum.Health>0 then
   local owner=Players:GetPlayerFromCharacter(model)
   if owner or includeNPC then
    local part=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if part and part:IsA("BasePart") then
     local d=(part.Position-root.Position).Magnitude
     if d<distance then best=part; distance=d; bestModel=model end
    end
   end
  end
 end
 return best,bestModel
end
local bind="AutoBlackflashCamera"
local cached,targetModel,lastScan=nil,nil,0
RS:BindToRenderStep(bind,Enum.RenderPriority.Camera.Value+1,function(dt)
 if not running or not lockOn or gui:GetAttribute("FlingSequenceActive") then cached=nil; return end
 if UIS:GetFocusedTextBox() then return end
 if os.clock()-lastScan>.2 then cached,targetModel=target(); lastScan=os.clock() end
 local cam=workspace.CurrentCamera
 if cam and cached and cached.Parent then
  local aimPos=cached.Position
  if targetModel and lockTargetMode=="Back" then
   local root=targetModel:FindFirstChild("HumanoidRootPart")
   if root then aimPos=root.Position-root.CFrame.LookVector*3 end
  end
  local delta=aimPos-cam.CFrame.Position
  if delta.Magnitude>.01 then cam.CFrame=cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position,aimPos),1-math.exp(-18*dt)) end
  if pullEnabled and cached.Parent then
   local char=LP.Character
   local root=char and char:FindFirstChild("HumanoidRootPart")
   if root then
    local direction=aimPos-root.Position
    if direction.Magnitude>.5 then root.AssemblyLinearVelocity=direction.Unit*pullStrength end
   end
  end
 end
end)
local function clapClick()
 if not okVIM or not VIM or not scriptsActive() or UIS:GetFocusedTextBox() then return end
 local cursor=UIS:GetMouseLocation()
 local ok,err=pcall(function() VIM:SendMouseButtonEvent(cursor.X,cursor.Y,0,true,game,0);task.wait(.035) end)
 pcall(function() VIM:SendMouseButtonEvent(cursor.X,cursor.Y,0,false,game,0) end)
 if not ok then warn("Clap input: "..tostring(err)) end
end
local function runPerfectClap()
 if not perfectClapEnabled or not scriptsActive() or clapState.pending or busy or manualSequenceBusy then return end
 clapState.pending=true
 local ticket=clapState.generation;local character=LP.Character
 task.delay(perfectClapDelay/1000,function()
  if ticket~=clapState.generation then return end
  clapState.pending=false
  local h=character and character:FindFirstChildOfClass("Humanoid")
  if scriptsActive() and perfectClapEnabled and LP.Character==character and h and h.Health>0 and not busy and not manualSequenceBusy then clapClick() end
 end)
end
connect(LP.CharacterRemoving,function() clapState.generation+=1;clapState.pending=false end)
connect(UIS.WindowFocusReleased,function() clapState.generation+=1;clapState.pending=false end)

local function runTripleJump()
 if tripleJumpBusy or busy or todoBusy or manualSequenceBusy or UIS:GetFocusedTextBox() or not scriptsActive() or not tripleJumpEnabled or not okVIM then return end
 tripleJumpBusy=true;busy=true;local character=LP.Character
 local function waitFor(t) local deadline=os.clock()+t;repeat if not scriptsActive() or not tripleJumpEnabled or LP.Character~=character or UIS:GetFocusedTextBox() then error("Cancelled") end;RS.Heartbeat:Wait() until os.clock()>=deadline end
 local function mouse(v) local p=UIS:GetMouseLocation();local inset=game:GetService("GuiService"):GetGuiInset();VIM:SendMouseButtonEvent(p.X-inset.X,p.Y-inset.Y,0,v,game,0) end
 local ok,err=pcall(function() waitFor(.300);local h=character and character:FindFirstChildOfClass("Humanoid");assert(h and h.Health>0,"No living character");h.Jump=true;VIM:SendKeyEvent(true,Enum.KeyCode.Space,false,game);waitFor(.050);VIM:SendKeyEvent(false,Enum.KeyCode.Space,false,game);mouse(true);waitFor(.035);mouse(false) end)
 pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.Space,false,game) end);pcall(function() mouse(false) end)
 tripleJumpBusy=false;busy=false;if status and status.Parent then status.Text=ok and "3 LMB -> 300ms -> jump -> LMB" or tostring(err) end
end

