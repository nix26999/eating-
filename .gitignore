 make("UIListLayout",p,{Padding=UDim.new(0,10),SortOrder=Enum.SortOrder.LayoutOrder}); pages[name]=p
 connect(b.Activated,function()
  title.Text=name; desc.Text=""
  for key,page in pairs(pages) do page.Visible=key==name end
  for key,btn in pairs(buttons) do
   btn.BackgroundTransparency=mobileMode and 0 or (key==name and 0 or 1)
   btn.BackgroundColor3=mobileMode and (key==name and T.acc or T.p2) or T.p2
   btn.TextColor3=mobileMode and (key==name and Color3.fromRGB(28,14,6) or T.dim) or (key==name and T.acc or T.dim)
   btn.Font=key==name and Enum.Font.GothamBold or Enum.Font.GothamMedium
  end
 end)
end
for name,nav in pairs(buttons) do nav:SetAttribute("Tooltip","Open the "..name.." module category.") end

-- Responsive navigation: polished phone layout with large touch targets.
local sideLayout=side:FindFirstChildOfClass("UIListLayout")
local mobileMode=false
local function applyResponsiveLayout()
 local camera=workspace.CurrentCamera;local v=camera and camera.ViewportSize or Vector2.new(760,540);local touch=UIS.TouchEnabled or v.X<700;mobileMode=touch
 main.Size=touch and UDim2.fromOffset(math.min(760,math.max(240,v.X-24)),math.min(620,math.max(180,v.Y-96))) or UDim2.fromOffset(760,540)
 main.Position=UDim2.fromScale(.5,.5);main.ClipsDescendants=touch;scale.Scale=touch and 1 or math.min(1,(v.X-24)/760,(v.Y-48)/540)
 local topH=touch and 48 or 44;local navW=touch and 96 or 150;top.Size=UDim2.new(1,0,0,topH);side.Position=UDim2.fromOffset(0,topH);side.Size=UDim2.new(0,navW,1,-topH)
 side.ScrollingDirection=Enum.ScrollingDirection.Y;side.AutomaticCanvasSize=Enum.AutomaticSize.Y;side.CanvasSize=UDim2.new();side.ScrollBarThickness=touch and 4 or 2
 if sideLayout then sideLayout.FillDirection=Enum.FillDirection.Vertical;sideLayout.Padding=UDim.new(0,4) end
 local pad=side:FindFirstChildOfClass("UIPadding");if pad then pad.PaddingTop=UDim.new(0,6);pad.PaddingLeft=UDim.new(0,4);pad.PaddingRight=UDim.new(0,4) end
 for name,b in pairs(buttons) do b.Size=UDim2.new(1,0,0,touch and 44 or 32);b.TextSize=touch and 12 or 13;b.TextWrapped=touch;b.BackgroundColor3=T.p2;b.BackgroundTransparency=pages[name] and pages[name].Visible and 0 or 1;b.TextColor3=pages[name] and pages[name].Visible and T.acc or T.dim end
 for _,o in ipairs(side:GetChildren()) do if o:IsA("TextLabel") then o.Visible=not touch end end
 content.Position=UDim2.fromOffset(navW,topH);content.Size=UDim2.new(1,-navW,1,-topH);title.TextSize=touch and 14 or 18;title.Position=UDim2.fromOffset(touch and 8 or 16,7)
 discordBtn.Visible=not touch;badge.Visible=not touch
 if unloadTop then
  unloadTop.Visible=true
  unloadTop.Size=UDim2.fromOffset(touch and 64 or 64,touch and 36 or 28)
  unloadTop.Position=UDim2.new(1,touch and -120 or -108,.5,touch and -18 or -14)
  unloadTop.TextSize=touch and 12 or 11
 end
 close.Size=UDim2.fromOffset(touch and 44 or 28,touch and 44 or 28);close.Position=UDim2.new(1,touch and -48 or -36,.5,touch and -22 or -14);close.TextSize=touch and 18 or 16
 for _,o in ipairs(top:GetChildren()) do if o:IsA("TextLabel") and o.Text:find("JJS HUB",1,true) then o.Size=UDim2.new(1,touch and -104 or -280,1,0);o.TextSize=touch and 14 or 15 end;if o:IsA("TextLabel") and (o.Text=="PC" or o.Text=="MOBILE") then o.Visible=not touch end;if o.Name=="DeviceIcon" then o.Position=touch and UDim2.new(1,-94,.5,-12) or UDim2.fromOffset(290,9) end end
 if keyPage and keyPage.Parent then keyPage.AnchorPoint=Vector2.new(.5,.5);keyPage.Position=UDim2.fromScale(.5,.5);keyPage.Size=UDim2.fromOffset(math.min(420,v.X-24),math.min(340,v.Y-32));local ks=keyPage:FindFirstChildOfClass("UIScale");if ks then ks.Scale=1 end end
 if __JJSBoot.features then for _,r in ipairs(__JJSBoot.features) do __JJSBoot.refresh(r) end end
end

