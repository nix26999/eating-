 make("UIGradient",moon,{Color=ColorSequence.new(Color3.fromRGB(255,246,220),Color3.fromRGB(230,150,70)),Rotation=60})
 for _,c in ipairs({{-.25,-.15,26},{.2,.1,18},{-.05,.28,14}}) do F({AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(c[3],c[3]),Position=UDim2.new(.5,c[1]*120,.5,c[2]*120),BackgroundColor3=Color3.fromRGB(205,140,80),BackgroundTransparency=.55,BorderSizePixel=0,ZIndex=5},moon) end
