 T.purple=Color3.fromRGB(255,190,90)   -- witch purple
 T.ghost=Color3.fromRGB(190,255,210)   -- ghost glow

end)

local gui=make("ScreenGui",PG,{Name="JJS HUB",ResetOnSpawn=false,DisplayOrder=999,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
-- Universal tooltip system: hover on PC, long-press on touch.
-- Controls can override the generated description with SetAttribute("Tooltip", ...).
local tooltipLayer=Instance.new("ScreenGui");tooltipLayer.Name="JJSTooltips";tooltipLayer.ResetOnSpawn=false;tooltipLayer.DisplayOrder=1005;tooltipLayer.IgnoreGuiInset=true;tooltipLayer.Parent=PG
local tooltipBox=Instance.new("Frame");tooltipBox.Name="TooltipBox";tooltipBox.Visible=false;tooltipBox.BackgroundColor3=Color3.fromRGB(22,15,12);tooltipBox.BackgroundTransparency=.04;tooltipBox.BorderSizePixel=0;tooltipBox.Size=UDim2.fromOffset(230,0);tooltipBox.AutomaticSize=Enum.AutomaticSize.Y;tooltipBox.ZIndex=1000;tooltipBox.Parent=tooltipLayer
local tooltipCorner=Instance.new("UICorner");tooltipCorner.CornerRadius=UDim.new(0,7);tooltipCorner.Parent=tooltipBox
local tooltipStroke=Instance.new("UIStroke");tooltipStroke.Color=Color3.fromRGB(255,138,40);tooltipStroke.Thickness=1;tooltipStroke.Parent=tooltipBox
local tooltipPad=Instance.new("UIPadding");tooltipPad.PaddingLeft=UDim.new(0,9);tooltipPad.PaddingRight=UDim.new(0,9);tooltipPad.PaddingTop=UDim.new(0,7);tooltipPad.PaddingBottom=UDim.new(0,7);tooltipPad.Parent=tooltipBox
local tooltipText=Instance.new("TextLabel");tooltipText.BackgroundTransparency=1;tooltipText.Size=UDim2.new(1,0,0,0);tooltipText.AutomaticSize=Enum.AutomaticSize.Y;tooltipText.TextWrapped=true;tooltipText.TextXAlignment=Enum.TextXAlignment.Left;tooltipText.TextYAlignment=Enum.TextYAlignment.Top;tooltipText.Font=Enum.Font.Gotham;tooltipText.TextSize=12;tooltipText.TextColor3=Color3.fromRGB(255,242,224);tooltipText.ZIndex=1001;tooltipText.Parent=tooltipBox
local tooltipLimit=Instance.new("UISizeConstraint");tooltipLimit.Parent=tooltipBox;tooltipBox.ClipsDescendants=true
local tooltipToken=0
local function showTooltip(obj,message,pos)
 tooltipToken+=1;local camera=workspace.CurrentCamera;local v=camera and camera.ViewportSize or Vector2.new(800,600)
 local w=math.max(100,math.min(260,v.X-24));local h=math.max(60,math.min(160,v.Y*.4));tooltipLimit.MaxSize=Vector2.new(w,h);tooltipBox.Size=UDim2.fromOffset(w,0)
 local max=UIS.TouchEnabled and 220 or 360;if #message>max then message=message:sub(1,max-3).."..." end
 tooltipText.TextSize=UIS.TouchEnabled and 13 or 12;tooltipText.Text=message;tooltipBox.Visible=true
 local x=pos and pos.X or obj.AbsolutePosition.X;local y=pos and pos.Y or obj.AbsolutePosition.Y+obj.AbsoluteSize.Y
 tooltipBox.Position=UDim2.fromOffset(math.clamp(x+8,8,math.max(8,v.X-w-8)),math.clamp(y+8,8,math.max(8,v.Y-h-8)))
 local token=tooltipToken;task.delay(3.5,function() if tooltipToken==token then tooltipBox.Visible=false end end)
end

local function hideTooltip() tooltipToken+=1;tooltipBox.Visible=false end
local tooltipDescriptions={
 ["Auto Blackflash"]="Automatically performs the Black Flash input sequence when the script detects the required timing.",
 ["Triple Jump (3x LMB > 300ms > Jump > 50ms > LMB)"]="Runs the configured triple-jump input sequence. Timing depends on the game and current action.",
 ["Auto Blackflash Chain"]="Repeats the Black Flash sequence as a chain while enabled.",
 ["Auto Lock On"]="Automatically keeps the camera locked onto the selected target.",
 ["Include NPCs"]="Allows NPCs to be selected as lock-on targets, not just players.",
 ["Pull To Target"]="Applies the configured pull behavior toward the current target.",
 ["Lock Distance"]="Maximum distance used when searching for or maintaining a target.",
 ["Pull Strength"]="Adjusts the strength of the pull effect. Higher values are stronger.",
 ["Todo Macro"]="Enables the Todo macro sequence. Use only when you are ready for its automated inputs.",
 ["Perfect Clap"]="Enables the timing-assisted clap input. Adjust the delay below to match your timing.",
 ["Clap delay"]="Delay, in milliseconds, used by the Perfect Clap timing.",
 ["Follow Behind + Sprint"]="Follows the selected player from behind and attempts to sprint while following.",
 ["Automatic Pathfinding Jumps"]="Allows the follow routine to trigger jumps while navigating obstacles.",
 ["Use Front / Side / Back Dashes"]="Allows the follow routine to use dash actions to keep up with its target.",
 ["Slow Spin"]="Rotates your character slowly while enabled. Adjust Spin speed below.",
 ["Invisible (Local Only)"]="Applies a local-only invisibility effect; other players may still see your character.",
 ["Speed"]="Enables the custom walk-speed setting. Change Walk speed below.",
 ["Build Speed"]="Gradually increases movement speed while moving, up to the configured maximum.",
 ["Starting speed"]="Movement speed at the beginning of Build Speed.",
 ["Speed gained per second"]="How quickly Build Speed increases movement speed.",
 ["Maximum built speed"]="Upper limit for Build Speed.",
 ["Reset speed when stopped"]="Resets the accumulated speed when movement stops.",
 ["Jump Power"]="Enables the custom jump-power setting.",
 ["Grounded velocity jump assist"]="Adds a jump assist when the character is grounded.",
 ["Unload"]="Stops the hub and disconnects its active UI and script connections.",
}
local function tooltipMessage(obj)
 local custom=obj:GetAttribute("Tooltip")
 if typeof(custom)=="string" and custom~="" then return custom end
 local label=obj:IsA("TextBox") and (obj.PlaceholderText~="" and obj.PlaceholderText or obj.Text) or obj.Text
 if label and label~="" then
  if tooltipDescriptions[label] then return tooltipDescriptions[label] end
  if obj:IsA("TextButton") then return "Tap/click to activate: "..label end
  if obj:IsA("TextBox") then return "Enter a value here. "..label end
  if obj:IsA("TextLabel") then return label end
 end
 return nil
end
attachTooltip=function(obj)
 if not obj:IsA("GuiObject") or obj:GetAttribute("TooltipDisabled") then return end
 local msg=tooltipMessage(obj)
 if not msg then return end
 if UIS.MouseEnabled then
  obj.MouseEnter:Connect(function() showTooltip(obj,tooltipMessage(obj) or msg) end)
  obj.MouseLeave:Connect(hideTooltip)
 end
 if UIS.TouchEnabled then
  local startInput,startPos=nil,nil
  obj.InputBegan:Connect(function(input)
   if input.UserInputType~=Enum.UserInputType.Touch then return end
   startInput=input;startPos=input.Position
   local token=tooltipToken+1;tooltipToken=token
   task.delay(.55,function()
    if startInput==input and tooltipToken==token then showTooltip(obj,tooltipMessage(obj) or msg,startPos) end
   end)
  end)
  obj.InputEnded:Connect(function(input) if input==startInput then startInput=nil end end)
 end
end
-- Key gate: join Discord to get the key, then unlock the hub
local SCRIPT_KEY="J1nxhub01932456" -- post this key in your Discord
local KEY_FILE="JJSHub_key.txt"
local function keyAlreadySaved()
 if typeof(readfile)~="function" or typeof(isfile)~="function" then return false end
 local ok,data=pcall(function()
  if not isfile(KEY_FILE) then return false end
  return (readfile(KEY_FILE) or ""):gsub("%s+","")
 end)
 return ok and data==SCRIPT_KEY
end
local function saveKeyUnlock()
 if typeof(writefile)=="function" then pcall(writefile,KEY_FILE,SCRIPT_KEY) end
end
if keyAlreadySaved() then hubUnlocked=true end
