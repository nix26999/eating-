 -- backdrop only while menu is open; fully destroyed on hub unload
 local function paintBackdrop() if bg.Parent then bg.Enabled=main.Visible and gui:GetAttribute("BackdropEnabled")~=false end end
 paintBackdrop()
 connect(main:GetPropertyChangedSignal("Visible"),paintBackdrop)
 connect(gui:GetAttributeChangedSignal("BackdropEnabled"),paintBackdrop)
 local t0=os.clock()
 local bgAlive=true
 connect(RS.Heartbeat,function(dt)
  if not bgAlive or not bg.Parent then return end
  if not bg.Enabled then return end
  local t=os.clock()-t0
  for _,u in ipairs(updaters) do u(t,dt) end
 end)
 local function killBackdrop()
  bgAlive=false
  if bg.Parent then bg:Destroy() end
 end
 connect(gui.Destroying,killBackdrop)
