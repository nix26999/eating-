 stop=function(message)
  generation+=1;local owned=active;active=false

  releasePositioning();releaseInputs();disconnectFight();invalidateCaches()
  phase="idle";steering=Vector3.zero;targetRoot=nil
  flickUntil=0;flickRotation=nil;flickNavigationRight=Vector3.zero;needPostJumpBackoff=false
