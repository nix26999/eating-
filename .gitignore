   e.y-=e.s*dt
   if e.y<-10 then e.y=560;e.x=math.random()*760 end
   e.f.Position=UDim2.fromOffset(e.x+math.sin(t+e.x)*6,e.y)
  end
 end)

 -- LAYER 3: thin orange border glow over the whole window
