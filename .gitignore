  F({AnchorPoint=Vector2.new(.5,1),Size=UDim2.fromOffset(6,60),Position=UDim2.new(tx,0,.97,0),BackgroundColor3=Color3.fromRGB(70,44,24),BorderSizePixel=0,ZIndex=13})
