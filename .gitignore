;__JJSBoot:run("Item and Dummy ESP",function()
 -- JJS25: Item and Dummy ESP
 local itemOn,dummyOn=false,false;local alive=true;local elapsed=0;local entries={}
 local folder=make("Folder",gui,{Name="JJS25WorldESP"})
 local box=card(pages.ESP,"Items and Non-player Dummies","")
 local feedback=make("TextLabel",box,{Size=UDim2.new(1,0,0,45),Text="Items: workspace.Items. Dummies: non-player humanoids in workspace.Characters. Local markers only.",TextWrapped=true,BackgroundTransparency=1,TextColor3=T.mut,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=3});ord[box]=3
 local function clear() for o,e in pairs(entries) do e.tag:Destroy();e.highlight:Destroy();entries[o]=nil end end
 toggle(box,"Item ESP",function() return itemOn end,function(v) itemOn=v;clear() end)
 toggle(box,"Dummy ESP",function() return dummyOn end,function(v) dummyOn=v;clear() end)
 local function add(o,part,caption)
  if entries[o] then entries[o].label.Text=caption;return end
  local h=make("Highlight",folder,{Adornee=o,FillColor=T.acc,FillTransparency=.8,OutlineColor=T.txt,DepthMode=Enum.HighlightDepthMode.Occluded})
  local tag=make("BillboardGui",folder,{Adornee=part,Size=UDim2.fromOffset(180,26),StudsOffset=Vector3.new(0,2.5,0),AlwaysOnTop=false})
  local label=make("TextLabel",tag,{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=caption,TextColor3=T.txt,TextStrokeTransparency=.3,TextSize=12,Font=Enum.Font.Gotham})
  entries[o]={tag=tag,highlight=h,label=label}
 end
 connect(RS.Heartbeat,function(dt)
  if not alive or not itemOn and not dummyOn then return end
  elapsed+=dt;if elapsed<.5 then return end;elapsed=0
  local seen={};local count=0
  local items=workspace:FindFirstChild("Items")
  if itemOn and items then for _,o in ipairs(items:GetChildren()) do
   local p=o:IsA("BasePart") and o or o:FindFirstChildWhichIsA("BasePart",true)
   if p and (o:IsA("BasePart") or o:IsA("Model")) then add(o,p,o.Name);seen[o]=true;count+=1 end
  end end
  local chars=workspace:FindFirstChild("Characters")
  if dummyOn and chars then for _,m in ipairs(chars:GetChildren()) do
   if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then
    local h=m:FindFirstChildOfClass("Humanoid");local p=m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
    if h and p and h.Health>0 then add(m,p,string.format("%s | %.0f/%.0f HP",m.Name,h.Health,h.MaxHealth));seen[m]=true;count+=1 end
   end
  end end
  for o,e in pairs(entries) do if not seen[o] then e.tag:Destroy();e.highlight:Destroy();entries[o]=nil end end
  feedback.Text="Tracked: "..count.." | Items: "..(items and "found" or "unavailable").." | Characters: "..(chars and "found" or "unavailable")
 end)
 local function stop() if not alive then return end;alive=false;clear();folder:Destroy() end
 connect(unload.Activated,stop);connect(gui.Destroying,stop)

end)

;__JJSBoot:run("Skeleton Overlay",function()
 -- JJS25: Skeleton Overlay
 local on=false;local alive=true;local elapsed=0;local records={}
 local folder=make("Folder",gui,{Name="JJS25Skeletons"})
 local box=card(pages.ESP,"Skeleton Overlay","")
 local function clear() for c,e in pairs(records) do e.folder:Destroy();records[c]=nil end end
 toggle(box,"Player skeletons",function() return on end,function(v) on=v;if not v then clear() end end)
 make("TextLabel",box,{Size=UDim2.new(1,0,0,40),BackgroundTransparency=1,Text="Motor6D screen-space lines; 500 stud limit. Overlay is not occlusion filtered. Indexes at most two new rigs per scan.",TextWrapped=true,TextColor3=T.mut,Font=Enum.Font.Gotham,TextSize=11,LayoutOrder=20})
 connect(RS.Heartbeat,function(dt)
  if not alive or not on then return end
  elapsed+=dt;if elapsed<.5 then return end;elapsed=0
  local seen={};local indexed=0
  for _,p in ipairs(Players:GetPlayers()) do
   local c=p.Character
   if p~=LP and c then
    seen[c]=true
    if not records[c] and indexed<2 then
     indexed+=1
     local e={folder=make("Folder",folder,{Name=tostring(p.UserId)}),joints={}};records[c]=e
     for _,j in ipairs(c:GetDescendants()) do if j:IsA("Motor6D") and j.Part0 and j.Part1 then
      local line=make("Frame",e.folder,{AnchorPoint=Vector2.new(.5,.5),BorderSizePixel=0,BackgroundColor3=T.acc,Visible=false,ZIndex=30})
      table.insert(e.joints,{joint=j,line=line})
     end end
    end
   end
  end
  for c,e in pairs(records) do if not seen[c] then e.folder:Destroy();records[c]=nil end end
 end)
 connect(RS.RenderStepped,function()
  if not alive or not on then return end
  local camera=workspace.CurrentCamera;if not camera then return end
  for _,e in pairs(records) do for _,v in ipairs(e.joints) do
   v.line.Visible=false;local j=v.joint
   if j.Parent and j.Part0 and j.Part1 and (j.Part0.Position-camera.CFrame.Position).Magnitude<500 then
    local a,va=camera:WorldToScreenPoint(j.Part0.Position);local b,vb=camera:WorldToScreenPoint(j.Part1.Position)
    if va and vb and a.Z>0 and b.Z>0 then local d=Vector2.new(b.X-a.X,b.Y-a.Y)
     if d.Magnitude>.5 then v.line.Size=UDim2.fromOffset(d.Magnitude,2);v.line.Position=UDim2.fromOffset((a.X+b.X)/2,(a.Y+b.Y)/2);v.line.Rotation=math.deg(math.atan2(d.Y,d.X));v.line.Visible=true end
    end
   end
  end end
 end)
 local function stop() if not alive then return end;alive=false;on=false;clear();folder:Destroy() end
 connect(unload.Activated,stop);connect(gui.Destroying,stop)

end)

;__JJSBoot:run("Build Logic Visibility",function()
 -- JJS25: Build Logic Visibility
 local on=false;local alive=true;local saved={};local elapsed=0
 local box=card(pages.ESP,"Build Logic Visibility","")
 local feedback=make("TextLabel",box,{Size=UDim2.new(1,0,0,45),BackgroundTransparency=1,Text="Reveals build markers under workspace.Logic, NOT player movesets. Off restores captured marker visibility.",TextWrapped=true,TextColor3=T.mut,TextSize=11,Font=Enum.Font.Gotham,LayoutOrder=3});ord[box]=3
 local function restore() for o,e in pairs(saved) do if o.Parent then pcall(function() o[e.property]=e.value end) end end;saved={} end
 local function apply(o,prop) if not saved[o] then saved[o]={property=prop,value=o[prop]} end;o[prop]=true end
 toggle(box,"Show build markers",function() return on end,function(v) on=v;if not v then restore() end end)
 connect(RS.Heartbeat,function(dt)
  if not alive or not on then return end;elapsed+=dt;if elapsed<.5 then return end;elapsed=0
  local logic=workspace:FindFirstChild("Logic");if not logic then feedback.Text="workspace.Logic unavailable in this server.";return end
  local count=0
  for _,o in ipairs(logic:GetChildren()) do local core=o:FindFirstChild("Core");local icon=core and core:FindFirstChild("Icon");local outline=o:FindFirstChild("Outline")
   if icon and icon:IsA("BillboardGui") then apply(icon,"Enabled");count+=1 end
   if outline and outline:IsA("SelectionBox") then apply(outline,"Visible");count+=1 end
  end
  local expired={};for o in pairs(saved) do if not o:IsDescendantOf(logic) then table.insert(expired,o) end end
  for _,o in ipairs(expired) do local e=saved[o];if o.Parent then pcall(function() o[e.property]=e.value end) end;saved[o]=nil end
  feedback.Text="Visible markers: "..count..". Toggle off to restore."
 end)
 local function stop() if not alive then return end;alive=false;on=false;restore() end
 connect(unload.Activated,stop);connect(gui.Destroying,stop)

end)

;__JJSBoot:run("Player Scanner",function()
 -- JJS25: Player Scanner
 local on=false;local alive=true;local selected=nil;local elapsed=0
 local box=card(pages.Player,"Player Scanner","")
 local text=make("TextLabel",box,{Size=UDim2.new(1,0,0,100),BackgroundTransparency=1,Text="Scanner off. Replicated attributes only; unavailable values show Unknown.",TextWrapped=true,TextColor3=T.mut,TextSize=11,Font=Enum.Font.Gotham,LayoutOrder=3});ord[box]=3
 local function cycle()
  local options={};for _,p in ipairs(Players:GetPlayers()) do if p~=LP then table.insert(options,p) end end
  table.sort(options,function(a,b) return a.UserId<b.UserId end)
  local index=0;for i,p in ipairs(options) do if p==selected then index=i;break end end
  selected=#options>0 and options[index%#options+1] or nil
 end
 local button=make("TextButton",box,{Size=UDim2.new(1,0,0,28),BackgroundColor3=T.p2,Text="Next player",TextColor3=T.txt,TextSize=12,Font=Enum.Font.Gotham,LayoutOrder=nextOrder(box)+2});corner(button,6);connect(button.Activated,cycle)
 toggle(box,"Enable scanner",function() return on end,function(v) on=v;if on and not selected then cycle() end;if not on then text.Text="Scanner off." end end)
 connect(RS.Heartbeat,function(dt)
  if not alive or not on then return end;elapsed+=dt;if elapsed<.25 then return end;elapsed=0
  if not selected or selected.Parent~=Players then selected=nil;text.Text="No target. Use Next player.";return end
  local c=selected.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local moveset=selected:GetAttribute("Moveset");local ult=selected:GetAttribute("Ultimate")
  text.Text=selected.DisplayName.." (@"..selected.Name..")\nHP: "..(h and string.format("%.0f / %.0f",h.Health,h.MaxHealth) or "Unknown").."\nMoveset: "..(moveset~=nil and tostring(moveset) or "Unknown").."\nUltimate attribute: "..(ult~=nil and tostring(ult) or "Unknown")
 end)
 local function stop() alive=false;on=false;selected=nil end
 connect(unload.Activated,stop);connect(gui.Destroying,stop)

end)

;__JJSBoot:run("Animation Previews",function()
