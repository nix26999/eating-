;__JJSBoot:run("Halloween background",function()
 -- Skip the full-screen decorative backdrop on touch devices.
 if UIS.TouchEnabled then return end
 local TweenS=game:GetService("TweenService")
 local old=PG:FindFirstChild("JJSHalloweenBackdrop");if old then old:Destroy() end
 local bg=Instance.new("ScreenGui");bg.Name="JJSHalloweenBackdrop";bg.ResetOnSpawn=false;bg.IgnoreGuiInset=true;bg.DisplayOrder=998;bg.Parent=PG
 local function F(props,parent) return make("Frame",parent or bg,props) end
 local function rnd(a,b) return a+math.random()*(b-a) end
 local function round(o,r) make("UICorner",o,{CornerRadius=UDim.new(0,r or 999)}) end
 local ink=Color3.fromRGB(10,5,6)
 local orange=Color3.fromRGB(255,140,40)
 local updaters={}

 -- B1 sky
 local sky=F({Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.fromRGB(40,18,10),BorderSizePixel=0,ZIndex=1})
 make("UIGradient",sky,{Color=ColorSequence.new(Color3.fromRGB(58,26,12),Color3.fromRGB(4,2,3)),Rotation=90})
 -- B2 horizon glow
 local horizon=F({Size=UDim2.new(1.4,0,0,360),Position=UDim2.new(-.2,0,.6,0),BackgroundColor3=Color3.fromRGB(255,110,30),BackgroundTransparency=.84,BorderSizePixel=0,ZIndex=2}); round(horizon)
 -- B3 stars
 for i=1,90 do
  local s=F({Size=UDim2.fromOffset(2,2),Position=UDim2.fromScale(rnd(0,1),rnd(0,.6)),BackgroundColor3=Color3.fromRGB(255,240,220),BackgroundTransparency=.4,BorderSizePixel=0,ZIndex=2}); round(s)
  local base,sp,ph=rnd(.3,.6),rnd(1,3),rnd(0,6)
  table.insert(updaters,function(t) s.BackgroundTransparency=math.clamp(base+.3*math.sin(t*sp+ph),0,1) end)
 end
 -- B4 + B5 moon: halo rings, disc, craters
 local mx,my=.8,.16
 for i,r in ipairs({250,196,150}) do
  local ring=F({AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(r,r),Position=UDim2.fromScale(mx,my),BackgroundColor3=Color3.fromRGB(255,190,110),BackgroundTransparency=.86+i*.03,BorderSizePixel=0,ZIndex=3}); round(ring)
 end
 local moon=F({AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(120,120),Position=UDim2.fromScale(mx,my),BackgroundColor3=Color3.fromRGB(255,236,190),BorderSizePixel=0,ZIndex=4}); round(moon)
 make("UIGradient",moon,{Color=ColorSequence.new(Color3.fromRGB(255,246,220),Color3.fromRGB(230,150,70)),Rotation=60})
 for _,c in ipairs({{-.25,-.15,26},{.2,.1,18},{-.05,.28,14}}) do F({AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(c[3],c[3]),Position=UDim2.new(.5,c[1]*120,.5,c[2]*120),BackgroundColor3=Color3.fromRGB(205,140,80),BackgroundTransparency=.55,BorderSizePixel=0,ZIndex=5},moon) end
 -- B6 clouds drifting across the sky
 for i=1,5 do
  local c=F({Size=UDim2.fromOffset(rnd(260,420),rnd(56,90)),Position=UDim2.fromScale(rnd(-.2,1),rnd(.08,.42)),BackgroundColor3=Color3.fromRGB(78,40,30),BackgroundTransparency=.8,BorderSizePixel=0,ZIndex=3}); round(c)
  local sp=rnd(.004,.012)
  table.insert(updaters,function(t,dt) local p=c.Position;local nx=p.X.Scale+sp*dt;if nx>1.2 then nx=-.3 end;c.Position=UDim2.new(nx,0,p.Y.Scale,0) end)
 end
 -- B7 far hill with trees
 local function hill(y,h,col,z) local f=F({Size=UDim2.new(1.3,0,0,h),Position=UDim2.new(-.15,0,y,0),BackgroundColor3=col,BorderSizePixel=0,ZIndex=z}); round(f); return f end
 local function tree(x,baseY,h,z,col)
  local trunk=F({AnchorPoint=Vector2.new(.5,1),Size=UDim2.fromOffset(6,h*.5),Position=UDim2.new(x,0,baseY,30),BackgroundColor3=col,BorderSizePixel=0,ZIndex=z}); round(trunk,3)
  local crown=F({AnchorPoint=Vector2.new(.5,1),Size=UDim2.fromOffset(h*.42,h*.52),Position=UDim2.new(x,0,baseY,30-h*.42),BackgroundColor3=col,BorderSizePixel=0,ZIndex=z}); round(crown)
 end
 hill(.76,320,Color3.fromRGB(34,16,12),6)
 for i=1,7 do tree(rnd(-.02,1.02),.76,rnd(90,150),7,Color3.fromRGB(26,12,9)) end
 -- B8 bats flying across the sky
 for i=1,6 do
  local y=rnd(.12,.5)
  local body=F({AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(44,26),Position=UDim2.fromOffset(0,0),BackgroundTransparency=1,BorderSizePixel=0,ZIndex=8})
  local batCore=F({AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(12,9),BackgroundColor3=ink,BorderSizePixel=0,ZIndex=8},body); round(batCore)
  for _,side in ipairs({-1,1}) do F({AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5+side*.3,.4),Size=UDim2.fromOffset(20,8),BackgroundColor3=ink,BorderSizePixel=0,Rotation=side*-20,ZIndex=8},body) end
  task.spawn(function()
   while bg.Parent do
    body.Position=UDim2.fromScale(-.1,y)
    TweenS:Create(body,TweenInfo.new(rnd(16,24),Enum.EasingStyle.Linear),{Position=UDim2.fromScale(1.1,y)}):Play()
    task.wait(rnd(18,30))
   end
  end)
 end
 -- B9 fog bands
 for i,y in ipairs({.62,.72,.82}) do
  local f=F({Size=UDim2.new(1.6,0,0,120),Position=UDim2.new(-.3,0,y,0),BackgroundColor3=Color3.fromRGB(120,60,40),BackgroundTransparency=.84,BorderSizePixel=0,ZIndex=9}); round(f)
  task.spawn(function()
   local dir=i%2==0 and 1 or -1
   while bg.Parent do
    TweenS:Create(f,TweenInfo.new(14,Enum.EasingStyle.Sine),{Position=UDim2.new(-.3+dir*.15,0,y,0)}):Play()
    task.wait(14)
    TweenS:Create(f,TweenInfo.new(14,Enum.EasingStyle.Sine),{Position=UDim2.new(-.3,0,y,0)}):Play()
    task.wait(14)
   end
  end)
 end
