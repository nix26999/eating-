 reopen.Visible=hubUnlocked
end)
-- pause macros while hub is open; resume when closed (RightShift / X)
scriptsPaused=main.Visible
reopen.Visible=hubUnlocked and not main.Visible
connect(main:GetPropertyChangedSignal("Visible"),function()
 setScriptsPaused(main.Visible)
 reopen.Visible=hubUnlocked and not main.Visible
end)
local tjClicks,tjLast=0,0
connect(UIS.InputBegan,function(i)
 if gui:GetAttribute("FlingSequenceActive") then if hubUnlocked and i.KeyCode==Enum.KeyCode.RightShift then main.Visible=not main.Visible end;return end
 if UIS:GetFocusedTextBox() then return end
 if i.KeyCode==Enum.KeyCode.RightShift and hubUnlocked then
  main.Visible=not main.Visible
  reopen.Visible=not main.Visible
 end
 if i.KeyCode==Enum.KeyCode.R and perfectClapEnabled and scriptsActive() then
  task.spawn(runPerfectClap)
 end
 if i.UserInputType==Enum.UserInputType.MouseButton1 and tripleJumpEnabled and scriptsActive() and not busy and not todoBusy and not tripleJumpBusy then
  local now=os.clock()
  if now-tjLast>1.2 then tjClicks=0 end
  tjLast=now
  tjClicks+=1
  if tjClicks>=3 then
   tjClicks=0
   task.spawn(runTripleJump)
  end
 end
 if i.KeyCode==Enum.KeyCode.Three and blackflashV2Trigger and blackflashV2Trigger() then return end
 if i.KeyCode==Enum.KeyCode.Three and not busy then
  local now=os.clock()
  lastThreeTime=now
  if todoEnabled then task.spawn(runTodo); return end
  task.spawn(run)
  if chainEnabled and now>=chainCooldownUntil then task.spawn(runChain) end
 end
end)
local dragging,start,pos,touch
connect(top.InputBegan,function(i)
 if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=true; start=i.Position; pos=main.Position; touch=i end
end)
connect(UIS.InputEnded,function(i) if i==touch then dragging=false end end)
connect(UIS.InputChanged,function(i)
 if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i==touch) then local d=i.Position-start; main.Position=UDim2.new(pos.X.Scale,pos.X.Offset+d.X,pos.Y.Scale,pos.Y.Offset+d.Y) end
end)
local lastViewport=Vector2.zero
connect(RS.Heartbeat,function()
 local cam=workspace.CurrentCamera
 if cam and cam.ViewportSize~=lastViewport then
  lastViewport=cam.ViewportSize
  applyResponsiveLayout()
