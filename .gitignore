 local ghost=shape(main,{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(44,50),Position=UDim2.fromOffset(640,220),BackgroundColor3=Color3.fromRGB(230,235,255),BackgroundTransparency=.25,BorderSizePixel=0,ZIndex=1})
